---
/**
 * Energetsko-podnebna kartica občine: stavbe (izvleček za lokalni energetski koncept), za tisk ali PDF (2 strani A4).
 * 1. stran: kartica (stanje 2023, energenti, razredi, pot do 2050, letni obseg, primerjava); 2. stran: preglednice za LEK.
 * Na vsaki strani podpis: intelektualna lastnina IJS CEU. Stran se ne indeksira.
 */
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import '../../../styles/kartica.css';
import { pageUrl, withBase } from '../../../i18n/routes';
import { loadData, type ObcineIndex } from '../../../lib/data';
import { nf } from '../../../lib/format';
import { LEK_SIGN, POT_KEYS, POT_Y, lekData, lekKartica, lekRows } from '../../../lib/lek';

export function getStaticPaths() {
  return loadData<ObcineIndex>('obcine_index').municipalities.map((m) => ({ params: { sifra: String(m.sifra) } }));
}
const sifra = String(Astro.params.sifra);
const { o, mo, ms, md, si, draftDate } = lekData(sifra);
const kx = lekKartica(sifra);
const rows = lekRows(sifra);
const fmt = (v: unknown, unit: string) => (v === null || v === undefined ? '–' : typeof v === 'number' ? nf(v, unit.startsWith('kt') && v < 10 ? 2 : unit === '%' || unit.startsWith('MWh') || unit.startsWith('t ') || unit.startsWith('GWh') ? 1 : 0) : String(v).replace(/\./g, ','));
const split = rows.findIndex((r) => r[0].startsWith('Raba končne energije v vseh'));
const parts = [
  { h: 'Stavbni fond in registri', rows: rows.slice(0, split) },
  { h: 'Raba energije, emisije in obnovljivi viri (ocena modela IJS CEU)', rows: rows.slice(split, rows.findIndex((r) => r[0].startsWith('NPS 2050'))) },
  { h: 'Kaj cilji NPS 2050 pomenijo za občino (ponazoritev)', rows: rows.filter((r) => (r[0].startsWith('NPS 2050') && !r[0].includes('ponazoritev')) || (r[0].startsWith('–') && r[3] === null)) },
];

const va = mo.vse, vs = ms.vse, ci = mo.cilji!, pot = mo.pot!;
const tiles: { v: string; u: string; l: string; s: string }[] = [
  { v: nf(va.fe_mwh_preb.total, 1), u: 'MWh', l: 'raba končne energije v stavbah na prebivalca', s: `${nf(vs.fe_mwh_preb.total, 1)} MWh` },
  { v: nf(va.tgp_t_preb.total, 2), u: 't CO₂ ekv.', l: 'emisije TGP iz stavb na prebivalca', s: `${nf(vs.tgp_t_preb.total, 2)} t` },
  { v: nf(va.ove_pct.total, 0), u: '%', l: 'delež obnovljivih virov v rabi energije v stavbah', s: `${nf(vs.ove_pct.total, 0)} %` },
  { v: nf(pot['2023'].fossil_pct, 0), u: '%', l: 'delež plina in kurilnega olja v rabi energije v stavbah', s: `${nf(kx.fossilSi, 0)} %` },
  { v: nf(mo.above43_area_pct, 0), u: '%', l: 'stanovanjske površine med 43 % najmanj učinkovitih', s: `${nf(ms.above43_area_pct, 0)} %` },
  { v: o.obnova_res_since2010_pct === null ? '–' : nf(o.obnova_res_since2010_pct, 0), u: '%', l: 'stanovanjskih stavb z obnovo strehe, fasade ali oken od leta 2010', s: si.obnova_res_since2010_pct === null ? '–' : `${nf(si.obnova_res_since2010_pct, 0)} %` },
];
const CAR_COL: Record<string, string> = { el: '#2A6FC9', amb: '#6FA8DC', gas: '#A4520E', elko: '#5B4636', bio: '#86A11C', dh: '#7B5CC4' };
const CAR_LT = new Set(['el', 'gas', 'elko', 'dh']);
const CLS_COL: Record<string, string> = { A: '#1E6B4E', B: '#2F7D3E', C: '#A9C23F', D: '#F0CF45', E: '#F0A23A', F: '#B84A14', G: '#9B1C1C' };
const CLS_LT = new Set(['A', 'B', 'F', 'G']);
const stacks = [
  { h: 'Energenti v stanovanjskih stavbah', sub: 'delež končne energije, ocena modela', keys: md.carriers.map((c) => c.id), names: Object.fromEntries(md.carriers.map((c) => [c.id, c.name])), col: CAR_COL, lt: CAR_LT, a: mo.carriers_pct as Record<string, number>, b: ms.carriers_pct as Record<string, number>, short: false },
  { h: 'Energijski razredi stanovanjskih stavb', sub: 'delež površine po razredih NPS 2050, ocena modela', keys: md.classes, names: Object.fromEntries(md.classes.map((c) => [c, c])), col: CLS_COL, lt: CLS_LT, a: mo.nps_pct as Record<string, number>, b: ms.nps_pct as Record<string, number>, short: true },
];
const POT_COL = ['#1E6B4E', '#9B1C1C', '#86A11C', '#A4520E'];
const charts = POT_KEYS.map(([k, l, u], i) => {
  const vals = POT_Y.map((y) => pot[y][k] ?? 0);
  const max = Math.max(...vals, 1e-9);
  const pct = k === 'ove_pct' || k === 'fossil_pct';
  const d = pct ? vals[3] - vals[0] : 100 * (vals[3] / Math.max(vals[0], 1e-9) - 1);
  const dec = pct || max >= 100 ? 0 : max >= 10 ? 1 : 2;
  return { l: l.charAt(0).toUpperCase() + l.slice(1), u: pct ? '%' : u.replace('/leto', ''), col: POT_COL[i], bars: vals.map((v, j) => ({ y: POT_Y[j], t: nf(v, dec), h: Math.max(3, Math.round((100 * v) / max)) })), change: `${d > 0 ? '+' : '−'}${nf(Math.abs(d), 0)} ${pct ? 'odstotnih točk' : '%'} do 2050` };
});
const r100 = (v: number) => nf(Math.round(v / 100) * 100);
const st = (mo as any).stevilke;
const stSi = (ms as any).stevilke;
const kol = loadData<{ vnosi: { datum: string; naslov: string; status: string; koga: string[]; okvirno: boolean }[] }>('koledar').vnosi.filter((v) => v.koga.includes('obcine'));
const mioK = (v: number) => (v >= 1e6 ? `${nf(v / 1e6, v >= 1e7 ? 0 : 1)} mio €` : `${nf(Math.round(v / 1000))} tisoč €`);
const SEMT: Record<string, string> = { 'na poti': 'na poti', 'pod ciljem': 'pod ciljem', 'ni podatka': 'ni podatka' };
---
<!doctype html>
<html lang="sl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Občina {o.name} – energetsko-podnebna kartica: stavbe – NPS 2050 (IJS CEU)</title>
  <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <div class="bar no-print">
    <a href={withBase(`obcina/${sifra}/`)}>← Nazaj na stran občine</a>
    <span><button type="button" id="print">Natisni ali shrani kot PDF</button> <a href={withBase(`obcina/${sifra}/lek.csv`)} download={`NPS2050_${o.name}_LEK.csv`}>Prenesi CSV</a></span>
  </div>
  <main>
    <div class="sheet">
      <header>
        <p class="k">Energetsko-podnebna kartica občine: stavbe · izvleček za lokalni energetski koncept</p>
        <h1>Občina {o.name}</h1>
        <p class="sub">{o.region_name} · {nf(va.pop)} prebivalcev · {nf(o.buildings)} stavb · {o.area_k_m2 >= 1000 ? `${nf(o.area_k_m2 / 1000, 2)} mio m²` : `${nf(o.area_k_m2, 0)} tisoč m²`} · skupina: {kx.groupName}</p>
      </header>

      <section>
        <h2>Stanje 2023 <span>ocena modela IJS CEU, usklajena z energetsko bilanco</span></h2>
        <ul class="tiles">
          {tiles.map((t) => <li><span class="v">{t.v}<small> {t.u}</small></span><span class="l">{t.l}</span><span class="s">Slovenija: {t.s}</span></li>)}
        </ul>
      </section>

      <div class="two">
        {stacks.map((s) => (
          <section>
            <h2>{s.h}</h2>
            <p class="cap">{s.sub}</p>
            {[['Občina', s.a], ['Slovenija', s.b]].map(([lab, c]) => (
              <div class="stack-row">
                <span class="lab">{lab as string}</span>
                <span class="stack">{s.keys.map((k) => (c as Record<string, number>)[k] > 0 && <span class={s.lt.has(k) ? 'lt' : ''} style={`width:${(c as Record<string, number>)[k]}%;background:${s.col[k]}`}>{(c as Record<string, number>)[k] >= 9 && <b>{nf((c as Record<string, number>)[k], 0)}</b>}</span>)}</span>
              </div>
            ))}
            <ul class={`leg ${s.short ? 'short' : ''}`}>{s.keys.map((k) => <li><i style={`background:${s.col[k]}`}></i>{s.names[k]}{!s.short && ` ${nf(s.a[k], 0)} %`}</li>)}</ul>
          </section>
        ))}
      </div>

      <section>
        <h2>Pot do leta 2050 po scenariju NPS 2050 <span>ponazoritev: državni scenarij, prenesen na stavbe v občini</span></h2>
        <div class="charts">
          {charts.map((c) => (
            <figure>
              <figcaption><b>{c.l}</b> <span>{c.u}</span></figcaption>
              <div class="cols">{c.bars.map((b) => <div class="col"><span class="t">{b.t}</span><span class="b" style={`height:${b.h}%;background:${c.col}`}></span><span class="y">{b.y}</span></div>)}</div>
              <p class="chg">{c.change}</p>
            </figure>
          ))}
        </div>
      </section>

      <div class="two">
        <section>
          <h2>Kaj to pomeni na leto</h2>
          <ul class="facts">
            <li><b>{r100(ci.prenova_skupaj_m2_leto['2026_2030'])} m²</b> energetske prenove stavb na leto v obdobju 2026–2030</li>
            <li><b>{r100(ci.wpb.m2_leto_2026_2030)} m²</b> od tega v skupini 43 % najmanj učinkovitih stanovanjskih stavb</li>
            <li><b>{nf(ci.meps.n_2030)}</b> nestanovanjskih stavb za izboljšanje do leta 2030 (minimalni standardi, ocena)</li>
            <li><b>{nf(ci.fosilna.elko.gwh_2023, 1)} → {nf(ci.fosilna.elko.gwh[0], 1)} GWh</b> kurilnega olja v stavbah, 2023 → 2030</li>
          </ul>
        </section>
        <section>
          <h2>Primerjava in daljinsko ogrevanje</h2>
          <ul class="facts">
            <li><b>{kx.rank}. od {kx.groupN}</b> občin v skupini »{kx.groupName}« po rabi energije v stanovanjskih stavbah na prebivalca (1. = najnižja raba)</li>
            {kx.nb.fe !== null && <li><b>{nf(kx.row.k_res_fe_mwh_preb, 1)} MWh</b> na prebivalca v stanovanjskih stavbah; povprečje sosednjih občin ({kx.nb.n}) {nf(kx.nb.fe, 1)} MWh</li>}
            <li><b>{nf(mo.dh_pot!.fe_pct, 0)} %</b> končne energije goriv in daljinske toplote na območjih z gostoto vsaj 250 MWh/ha ({nf(mo.dh_pot!.fe_ha)} ha); Slovenija {nf(ms.dh_pot!.fe_pct, 0)} %</li>
            {kx.nb.ove !== null && <li><b>{nf(kx.row.k_ove_pct, 0)} %</b> obnovljivih virov; povprečje sosednjih občin {nf(kx.nb.ove, 0)} %</li>}
          </ul>
        </section>
      </div>

      <p class="disc">Vrednosti so ocena modela in niso meritve. Cilji in pot do leta 2050 so državni cilji NPS 2050, preneseni na občino sorazmerno s stavbnim fondom; niso obveznost občine. Kartica zajema samo stavbe (brez prometa in industrije).</p>
      <footer class="sign">{LEK_SIGN} Podatki iz osnutka NPS 2050 z dne {draftDate}.</footer>
    </div>

    <div class="sheet">
      <header class="small">
        <p class="k">Energetsko-podnebna kartica občine: stavbe · NPS 2050 v občini</p>
        <p class="h1b">Občina {o.name}</p>
        <p class="sub">kaj državni cilji NPS 2050 pomenijo za občino (ponazoritev, ne obveznost občine) in koledar za občine</p>
      </header>
      <section>
        <h2>Kaj to pomeni na leto (2026–2030)</h2>
        <ul class="tiles">
          <li><span class="v">{nf(st.hise_leto)}</span><span class="l">hiš na leto (povprečna hiša v občini {nf(st.povrsina_hise)} m²)</span></li>
          <li><span class="v">{nf(st.stanovanja_leto)}</span><span class="l">stanovanj v blokih na leto</span></li>
          <li><span class="v">{nf(st.javne_leto + st.zasebne_leto)}</span><span class="l">javnih in storitvenih stavb na leto (javnih {nf(st.javne_leto)})</span></li>
          <li><span class="v">{mioK(st.nalozba_eur_leto)}</span><span class="l">naložb na leto; do 2030 skupaj okoli {mioK(st.nalozba_eur_2030)}</span></li>
          <li><span class="v">{mioK(st.spodbude_eur_leto)}</span><span class="l">na leto iz nepovratnih spodbud (okoli {nf(st.spodbude_delez_pct)} %, državno povprečje)</span></li>
          <li><span class="v">{SEMT[st.semafor]}</span><span class="l">tempo prenove stanovanjskih stavb glede na sorazmerni delež (registri 2023–2025){st.stopnja_dejanska_pct !== null && <>: {nf(st.stopnja_dejanska_pct, 2)} % na leto, zahtevano {nf(st.stopnja_zahtevana_pct, 2)} % (Slovenija {nf(stSi.stopnja_dejanska_pct, 2)} %)</>}</span></li>
        </ul>
      </section>
      <section>
        <h2>Mesto občine (1. = najugodneje)</h2>
        <table>
          <thead><tr><th scope="col">Kazalnik</th><th scope="col" class="n">Med 212 občinami</th><th scope="col" class="n">V skupini »{kx.groupName}«</th></tr></thead>
          <tbody>{Object.values(st.rang as Record<string, any>).map((r: any) => <tr><th scope="row">{r.oznaka} ({r.smer === 'nizko' ? 'nižje je bolje' : 'višje je bolje'})</th><td class="n">{r.vse.mesto}. od {r.vse.od}</td><td class="n">{r.skupina.mesto}. od {r.skupina.od}</td></tr>)}</tbody>
        </table>
      </section>
      <section>
        <h2>Koledar za občine in javni sektor</h2>
        <table class="kol">
          <thead><tr><th scope="col">Kdaj</th><th scope="col">Kaj</th><th scope="col">Status</th></tr></thead>
          <tbody>{kol.map((v) => <tr><td>{v.datum}{v.okvirno && ' (okvirno)'}</td><th scope="row">{v.naslov}</th><td>{v.status === 'veljavno' ? 'že velja' : 'predlagano'}</td></tr>)}</tbody>
        </table>
      </section>
      <p class="disc">Cilji so državni cilji NPS 2050, preneseni na občino sorazmerno s stavbnim fondom; niso obveznost občine. Naložbe: obseg prenove × specifični strošek po segmentih iz osnutka (preglednica 54). »Že velja«: v zakonu ali predpisu; »predlagano«: predlog osnutka ali EPBD, še ni preneseno.</p>
      <footer class="sign">{LEK_SIGN} Podatki iz osnutka NPS 2050 z dne {draftDate}.</footer>
    </div>

    <div class="sheet">
      <header class="small">
        <p class="k">Energetsko-podnebna kartica občine: stavbe · podatki za lokalni energetski koncept</p>
        <p class="h1b">Občina {o.name}</p>
        <p class="sub">podatki iz osnutka NPS 2050 z dne {draftDate} in registrov (stanje september 2026)</p>
      </header>
      {parts.map((p) => (
        <section>
          <h2>{p.h}</h2>
          <table>
            <thead><tr><th scope="col">Kazalnik</th><th scope="col">Enota</th><th scope="col" class="n">Občina</th><th scope="col" class="n">Slovenija</th></tr></thead>
            <tbody>{p.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="n">{fmt(r[2], r[1])}</td><td class="n">{fmt(r[3], r[1])}</td></tr>)}</tbody>
          </table>
        </section>
      ))}
      <section class="method">
        <h2>Opombe k metodi</h2>
        <p>Stavbni fond po katastru nepremičnin GURS (30. 8. 2026), razvrstitev po kategorijah EPBD kot v osnutku NPS 2050. Raba energije, emisije in delež obnovljivih virov so ocena modela IJS CEU (arhetipi RenRates, energetske izkaznice, Eko sklad, energetsko knjigovodstvo javnega sektorja 2025, toplotna karta 2020), usklajena z energetsko bilanco in osnutkom NPS 2050 za leto 2023. Cilji NPS 2050 so državni cilji, preneseni na občino sorazmerno s stavbnim fondom; niso obveznost občine. Podrobnosti: {`${Astro.site ? new URL(pageUrl('obcine'), Astro.site).href : pageUrl('obcine')}#metoda`}.</p>
      </section>
      <footer class="sign">{LEK_SIGN} Podatki iz osnutka NPS 2050 z dne {draftDate}.</footer>
    </div>
  </main>
  <script>
    document.getElementById('print')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>

