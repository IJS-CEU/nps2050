---
/**
 * Izvleček za lokalni energetski koncept (LEK) za tisk ali shranjevanje kot PDF (A4).
 * Na vsaki strani podpis: intelektualna lastnina IJS CEU. Stran se ne indeksira.
 */
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import { pageUrl, withBase } from '../../../i18n/routes';
import { loadData, type ObcineIndex } from '../../../lib/data';
import { nf } from '../../../lib/format';
import { LEK_SIGN, lekData, lekRows } from '../../../lib/lek';

export function getStaticPaths() {
  return loadData<ObcineIndex>('obcine_index').municipalities.map((m) => ({ params: { sifra: String(m.sifra) } }));
}
const sifra = String(Astro.params.sifra);
const { o, draftDate } = lekData(sifra);
const rows = lekRows(sifra);
const fmt = (v: unknown, unit: string) => (v === null || v === undefined ? '–' : typeof v === 'number' ? nf(v, unit === '%' || unit.startsWith('MWh') || unit.startsWith('t ') || unit.startsWith('GWh') ? 1 : 0) : String(v).replace(/\./g, ','));
const split = rows.findIndex((r) => r[0].startsWith('Raba končne energije v vseh'));
const parts = [
  { h: 'Stavbni fond in registri', rows: rows.slice(0, split) },
  { h: 'Raba energije, emisije in obnovljivi viri (ocena modela IJS CEU)', rows: rows.slice(split, rows.findIndex((r) => r[0].startsWith('NPS 2050'))) },
  { h: 'Kaj cilji NPS 2050 pomenijo za občino (ponazoritev)', rows: rows.filter((r) => r[0].startsWith('NPS 2050') || (r[0].startsWith('–') && r[3] === null)) },
];
---
<!doctype html>
<html lang="sl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Občina {o.name} – izvleček za LEK – NPS 2050 (IJS CEU)</title>
  <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
</head>
<body>
  <div class="bar no-print">
    <a href={withBase(`obcina/${sifra}/`)}>← Nazaj na stran občine</a>
    <span><button type="button" id="print">Natisni ali shrani kot PDF</button> <a href={withBase(`obcina/${sifra}/lek.csv`)} download={`NPS2050_${o.name}_LEK.csv`}>Prenesi CSV</a></span>
  </div>
  <main class="sheet">
    <header>
      <p class="k">Strokovne podlage NPS 2050 · izvleček za lokalni energetski koncept</p>
      <h1>Občina {o.name}</h1>
      <p class="sub">{o.region_name} · podatki iz osnutka NPS 2050 z dne {draftDate} in registrov (stanje september 2026)</p>
    </header>
    {parts.map((p) => (
      <section>
        <h2>{p.h}</h2>
        <table>
          <thead><tr><th scope="col">Kazalnik</th><th scope="col">Enota</th><th scope="col" class="n">Občina</th><th scope="col" class="n">Slovenija</th></tr></thead>
          <tbody>{p.rows.map((r) => <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td class="n">{fmt(r[2], r[1])}</td><td class="n">{fmt(r[3], r[1])}</td></tr>)}</tbody>
        </table>
      </section>
    ))}
    <section class="method">
      <h2>Opombe k metodi</h2>
      <p>Stavbni fond po katastru nepremičnin GURS (30. 8. 2026), razvrstitev po kategorijah EPBD kot v osnutku NPS 2050. Raba energije, emisije in delež obnovljivih virov so ocena modela IJS CEU (arhetipi RenRates, energetske izkaznice, Eko sklad, energetsko knjigovodstvo javnega sektorja 2025, toplotna karta 2020), usklajena z energetsko bilanco in osnutkom NPS 2050 za leto 2023. Cilji NPS 2050 so državni cilji, preneseni na občino sorazmerno s stavbnim fondom; niso obveznost občine. Podrobnosti: {`${Astro.site ? new URL(pageUrl('obcine'), Astro.site).href : pageUrl('obcine')}#metoda`}.</p>
    </section>
    <footer class="sign">{LEK_SIGN} Podatki iz osnutka NPS 2050 z dne {draftDate}.</footer>
  </main>
  <script>
    document.getElementById('print')?.addEventListener('click', () => window.print());
  </script>
</body>
</html>

<style is:global>
  @page { size: A4; margin: 14mm 14mm 20mm; @bottom-center { content: "© IJS CEU – intelektualna lastnina IJS CEU · stran " counter(page); font-size: 7pt; color: #4C5A54; } }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: #ECEFE8; font-family: 'Manrope Variable', system-ui, sans-serif; color: #1B2622; font-size: 10pt; line-height: 1.4; }
  .bar { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; max-width: 210mm; margin: 0 auto; padding: 12px 4px; font-size: 14px; }
  .bar a { color: #1E6B4E; font-weight: 700; }
  .bar button { font: inherit; font-weight: 700; background: #1E6B4E; color: #fff; border: 0; border-radius: 6px; padding: 6px 14px; cursor: pointer; margin-right: 10px; }
  .sheet { max-width: 210mm; margin: 0 auto 24px; background: #fff; padding: 14mm; }
  header { border-bottom: 1.2mm solid #D6B25E; padding-bottom: 4mm; margin-bottom: 4mm; }
  .k { font-size: 7.5pt; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #1E6B4E; margin: 0; }
  h1 { font-family: 'Source Serif 4 Variable', Georgia, serif; font-size: 24pt; margin: 2mm 0 1mm; }
  .sub { color: #4C5A54; margin: 0; font-size: 9pt; }
  h2 { font-family: 'Source Serif 4 Variable', Georgia, serif; font-size: 12pt; margin: 5mm 0 2mm; }
  table { width: 100%; border-collapse: collapse; font-size: 8.8pt; break-inside: auto; }
  tr { break-inside: avoid; }
  th, td { text-align: left; padding: 1.2mm 1.5mm; border-bottom: .25mm solid #D7DDD5; vertical-align: top; }
  thead th { font-size: 7.4pt; text-transform: uppercase; letter-spacing: .04em; color: #4C5A54; border-bottom: .4mm solid #4C5A54; }
  tbody th { font-weight: 500; width: 55%; }
  .n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  td.n:nth-of-type(2) { font-weight: 700; }
  .method p { font-size: 8.4pt; color: #4C5A54; }
  .sign { margin-top: 6mm; border-top: .3mm solid #D6B25E; padding-top: 2.5mm; font-size: 7.6pt; color: #4C5A54; }
  @media print { body { background: #fff; } .no-print { display: none; } .sheet { margin: 0; padding: 0; max-width: none; } }
</style>
