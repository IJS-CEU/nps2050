---
/**
 * Stran občine (CLAUDE.md §10.1): izmerjeni kazalniki iz public/data/obcine/<sifra>.json in primerjava s Slovenijo.
 * Vse izrisano ob gradnji (brez JS). Samo agregati.
 */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Base from '../../layouts/Base.astro';
import { pageUrl, withBase } from '../../i18n/routes';
import Icon from '../../components/Icon.astro';
import Stolpci from '../../components/Stolpci.astro';
import { loadData, type ObSkupine, type Obcina, type ObcineIndex, type ObcineModel } from '../../lib/data';
import { nf } from '../../lib/format';
import { regijaSlug } from '../../lib/regije';

export function getStaticPaths() {
  const d = loadData<ObcineIndex>('obcine_index');
  return d.municipalities.map((m) => ({ params: { sifra: String(m.sifra) } }));
}

const { sifra } = Astro.params;
const ix = loadData<ObcineIndex>('obcine_index');
const o = JSON.parse(readFileSync(resolve(process.cwd(), 'public', 'data', 'obcine', `${sifra}.json`), 'utf-8')) as Obcina;
const si = ix.si;
const md = loadData<ObcineModel>('obcine_model');
const mo = md.municipalities[String(sifra)];
const ms = md.si;
const CAR_COL: Record<string, string> = { el: '#2A6FC9', amb: '#6FA8DC', gas: '#A4520E', elko: '#5B4636', bio: '#86A11C', dh: '#7B5CC4' };
const CAR_LT = new Set(['el', 'gas', 'elko', 'dh']); // bela pisava na temnih barvah
const tkTxt = mo.tk_factor === undefined || Math.abs(mo.tk_factor - 1) < 0.03 ? 'se s toplotno karto dobro ujema'
  : mo.tk_factor > 1 ? `ima po toplotni karti za ${nf(100 * (mo.tk_factor - 1), 0)} % višjo potrebo po toploti, kot bi jo dali sami arhetipi`
  : `ima po toplotni karti za ${nf(100 * (1 - mo.tk_factor), 0)} % nižjo potrebo po toploti, kot bi jo dali sami arhetipi`;
const row = ix.municipalities.find((m) => String(m.sifra) === sifra)!;
const MIN = ix.min_cell;
const CV: Record<string, string> = { A: 'A1', B: 'B1', C: 'C', D: 'D', E: 'E', F: 'F', G: 'G' };
const CG: Record<string, string> = { 'A–C': 'B1', 'D–E': 'D', 'F–G': 'G' };
const LIGHT_TXT = new Set(['A', 'G', 'F–G']); // bela pisava le na temnih razredih
const groupSi = (c: Record<string, number>) => Object.fromEntries(ix.class_groups.map((gk) => {
  const [a, z] = gk.split('–'); const ks = ix.classes.slice(ix.classes.indexOf(a), ix.classes.indexOf(z) + 1);
  return [gk, Math.round(10 * ks.reduce((t, k) => t + (c[k] ?? 0), 0)) / 10];
}));
const pct = (v: number | null | undefined, dec = 1) => (v === null || v === undefined ? null : `${nf(v, dec)} %`);
const few = `manj kot ${MIN}`;
const segName = Object.fromEntries(ix.segments.map((s) => [s.id, s.name]));
const catName = Object.fromEntries(ix.categories.map((c) => [c.id, c.name]));

const tiles = [
  { v: nf(o.buildings), l: 'stavb (vse vrste)' },
  o.area_k_m2 >= 1000 ? { v: `${nf(o.area_k_m2 / 1000, 2)}`, small: 'mio m²', l: 'uporabne površine' } : { v: `${nf(o.area_k_m2, 1)}`, small: 'tisoč m²', l: 'uporabne površine' },
  { v: pct(row.ei_area_res_pct) ?? '–', l: `stanovanjske površine ima veljavno energetsko izkaznico (Slovenija ${nf(si.ei_area_res_pct, 1)} %)` },
  { v: pct(row.pre1981_res_area_pct) ?? '–', l: `stanovanjske površine je zgrajene pred letom 1981 (Slovenija ${nf(si.pre1981_res_area_pct, 1)} %)` },
];
const cmp = (label: string, v: number | null, s: number | null, note?: string) => ({ label, v, s, note });
const esRows = ix.es_groups.map((g) => ({ ...g, o: o.es_res[g.id], s: si.es_res[g.id] }));
const esMax = Math.max(1, ...esRows.flatMap((r) => [r.o.pct ?? 0, r.s.pct ?? 0]));
const pub = ix.categories.slice(2).map((c) => ({ id: c.id, name: c.name, ...o.public_by_cat[c.id], e: mo.javne_cat?.[c.id] ?? null, es: ms.javne_cat?.[c.id] ?? null })).filter((c) => c.b !== 0);
const dh = mo.dh_pot!, dhSi = ms.dh_pot!;
const om = mo.omrezja!;
const st = (mo as any).stevilke as { hise_leto: number; stanovanja_leto: number; javne_leto: number; zasebne_leto: number; povrsina_hise: number; povrsina_stanovanja: number;
  nalozba_eur_leto: number; nalozba_eur_2030: number; spodbude_eur_leto: number; spodbude_delez_pct: number; semafor: string; stopnja_dejanska_pct: number | null;
  stopnja_zahtevana_pct: number | null; prenov_registri: number; indeks_tempo: number | null;
  rang: Record<string, { vse: { mesto: number; od: number }; skupina: { mesto: number; od: number }; oznaka: string; smer: string }> };
const stSi = (ms as any).stevilke as { stopnja_dejanska_pct: number; stopnja_zahtevana_pct: number };
const mio = (v: number) => (v >= 1e6 ? `${nf(v / 1e6, v >= 1e7 ? 0 : 1)} mio €` : `${nf(Math.round(v / 1000))} tisoč €`);
const SEM: Record<string, [string, string]> = { 'na poti': ['na poti', 'sem-ok'], 'pod ciljem': ['pod ciljem', 'sem-no'], 'ni podatka': ['ni podatka', 'sem-na'] };
const sysTxt = (n: number) => (n === 1 ? 'deluje 1 sistem' : n === 2 ? 'delujeta 2 sistema' : n <= 4 ? `delujejo ${n} sistemi` : `deluje ${n} sistemov`);
const clsBlocks = ['hise', 'bloki'].map((sid) => {
  const g = o.segments[sid], gs = si.segments[sid];
  const grouped = !g.classes_pct && !!g.class_groups_pct;
  const own = g.classes_pct ?? g.class_groups_pct;
  return {
    name: segName[sid], n: g.ei_calc, grouped, keys: grouped ? ix.class_groups : ix.classes,
    rows: own ? [{ lab: 'Občina', c: own, n: g.ei_calc ?? 0 }, { lab: 'Slovenija', c: grouped ? groupSi(gs.classes_pct!) : gs.classes_pct!, n: gs.ei_calc ?? 0 }] : null,
  };
});
const va = mo.vse, vs = ms.vse;
const ci = mo.cilji!;
const pot = mo.pot!;
const PY = ['2023', '2030', '2040', '2050'];
const potSi = ms.pot;
const red = (a: number, b: number) => Math.round(100 * (b / a - 1));
// Primerjava s podobnimi občinami
const sk = loadData<ObSkupine>('obcine_skupine');
const me = sk.municipalities[String(sifra)];
const grpName = sk.groups.find((g) => g.id === me.group)!.name;
const byS = Object.fromEntries(ix.municipalities.map((r) => [String(r.sifra), r]));
const nb = me.neighbours.map((n) => byS[String(n)]).filter(Boolean);
const grp = ix.municipalities.filter((r) => sk.municipalities[String(r.sifra)].group === me.group);
const mean = (xs: (number | null)[]) => { const v = xs.filter((x): x is number => x !== null && x !== undefined); return v.length ? v.reduce((a, b) => a + b, 0) / v.length : null; };
const median = (xs: (number | null)[]) => { const v = xs.filter((x): x is number => x !== null && x !== undefined).sort((a, b) => a - b); return v.length ? (v.length % 2 ? v[(v.length - 1) / 2] : (v[v.length / 2 - 1] + v[v.length / 2]) / 2) : null; };
const PEER: [keyof typeof row, string, number, string][] = [
  ['k_res_fe_mwh_preb', 'Raba končne energije v stanovanjskih stavbah na prebivalca', 1, ' MWh'],
  ['k_fe_mwh_preb', 'Raba končne energije v vseh stavbah na prebivalca', 1, ' MWh'],
  ['k_tgp_t_preb', 'Emisije TGP iz stavb na prebivalca', 2, ' t'],
  ['k_ove_pct', 'Delež obnovljivih virov v rabi energije v stavbah', 0, ' %'],
  ['model_fe_kwh_m2', 'Raba končne energije v stanovanjskih stavbah na m²', 0, ' kWh/m²'],
  ['pre1981_res_area_pct', 'Stanovanjska površina, zgrajena pred 1981', 0, ' %'],
  ['ei_area_res_pct', 'Stanovanjska površina z energetsko izkaznico', 0, ' %'],
  ['es_res_any_pct', 'Stanovanjske stavbe z ukrepom Eko sklada', 0, ' %'],
];
const peerRows = PEER.map(([k, l, d, u]) => ({ l, d, u, o: row[k] as number | null, n: mean(nb.map((r) => r[k] as number | null)), g: median(grp.map((r) => r[k] as number | null)), s: si[k as keyof typeof si] as unknown as number | null }));
const rank = [...grp].sort((a, b) => a.k_res_fe_mwh_preb - b.k_res_fe_mwh_preb).findIndex((r) => String(r.sifra) === String(sifra)) + 1;
const SEGN: [string, string][] = [['hise', 'enostanovanjske hiše'], ['bloki', 'večstanovanjske stavbe'], ['javne', 'javne stavbe'], ['zasebne', 'zasebne storitvene stavbe']];
const cmpTile = (v: number | null, si: number | null, dec: number, unit: string, label: string) => ({ v: v === null ? '–' : nf(v, dec), unit, l: `${label} (Slovenija ${si === null ? '–' : nf(si, dec)}${unit.trim() === '%' ? ' %' : ''})` });
const vTiles = [
  cmpTile(va.fe_mwh_preb.total, vs.fe_mwh_preb.total, 1, ' MWh', 'raba končne energije v vseh stavbah na prebivalca na leto'),
  cmpTile(va.tgp_t_preb.total, vs.tgp_t_preb.total, 2, ' t', 'emisij TGP iz stavb na prebivalca na leto'),
  cmpTile(va.ove_pct.total, vs.ove_pct.total, 0, ' %', 'delež obnovljivih virov v rabi energije v stavbah'),
  cmpTile(va.fe_mwh_preb.res, vs.fe_mwh_preb.res, 1, ' MWh', 'raba končne energije v stanovanjskih stavbah na prebivalca'),
];
const resShare = va.fe_gwh.total ? (100 * va.fe_gwh.res) / va.fe_gwh.total : 0;
const resShareSi = (100 * vs.fe_gwh.res) / vs.fe_gwh.total;
const carRows = [{ lab: 'Občina', c: mo.carriers_pct }, { lab: 'Slovenija', c: ms.carriers_pct }];
const npsRows = [{ lab: 'Občina', c: mo.nps_pct }, { lab: 'Slovenija', c: ms.nps_pct }];
const TOC = [
  { id: 'ob-vse-t', icon: 'gauge', label: 'Raba energije in emisije', hint: 'na prebivalca, obnovljivi viri' },
  { id: 'ob-peer-t', icon: 'map', label: 'Primerjava', hint: 'sosednje in podobne občine' },
  { id: 'ob-cilji-t', icon: 'target', label: 'Cilji NPS 2050', hint: 'potrebna prenova v občini' },
  { id: 'ob-pot-t', icon: 'trending-down', label: 'Pot do leta 2050', hint: 'energija, emisije, OVE' },
  { id: 'ob-dh-t', icon: 'flame', label: 'Daljinsko ogrevanje', hint: 'potencial in omrežja' },
  { id: 'ob-model-t', icon: 'house', label: 'Stanovanjske stavbe', hint: 'energenti in razredi' },
  { id: 'reg-seg', icon: 'building-2', label: 'Podatki iz registrov', hint: 'stavbe, izkaznice, prenove' },
  { id: 'lek', icon: 'file-text', label: 'Kartica občine', hint: 'PDF in CSV za LEK' },
];
const title = `Občina ${o.name}`;
const description = `Stavbe, raba energije, emisije, obnovljivi viri in cilji NPS 2050 v občini ${o.name}: primerjava s sosednjimi in podobnimi občinami ter s Slovenijo.`;
---
<Base page="obcine" title={title} description={description}>
  <div class="wrap page-head">
    <p class="ob-crumb"><a href={pageUrl('obcine')}>Moja občina</a> / <a href={withBase(`regija/${regijaSlug(o.region_name)}/`)} title="Kartica regije">{o.region_name}</a></p>
    <h1>{o.name}</h1>
    <p class="lead">Stavbe, raba energije, emisije in cilji NPS 2050 v občini {o.name}, v primerjavi s sosednjimi in podobnimi občinami ter s Slovenijo.</p>
  </div>
  <div class="wrap prose ob">
    <div class="tiles ob-tiles">
      {tiles.map((t) => <div class="tile"><div class="v">{t.v}{t.small && <small> {t.small}</small>}</div><div class="l">{t.l}</div></div>)}
    </div>

    <nav class="ob-toc" aria-label="Na tej strani">
      <p class="ob-toc-t">Na tej strani</p>
      <ol>
        {TOC.map((t) => <li><a href={`#${t.id}`}><span class="ob-toc-i"><Icon name={t.icon} size={18} /></span><span><b>{t.label}</b><small>{t.hint}</small></span></a></li>)}
      </ol>
    </nav>
    <div class="ob-part" id="del-1">
      <span class="ob-part-n" aria-hidden="true">1</span>
      <div><p class="ob-part-t">Povzetek</p><p class="ob-part-s">Raba energije, emisije in obnovljivi viri ter primerjava z drugimi občinami</p></div>
    </div>
    <section class="ob-model ob-vse" aria-labelledby="ob-vse-t">
      <p class="ob-model-k">Ocena modela · vse stavbe</p>
      <h2 id="ob-vse-t">Raba energije, emisije in obnovljivi viri v stavbah občine</h2>
      <p>Stanovanjske, javne in zasebne storitvene stavbe skupaj, na prebivalca ({nf(va.pop)} prebivalcev, 1. 1. 2026). Vsota za Slovenijo se ujema z osnutkom NPS 2050 (končna energija, emisije in delež obnovljivih virov za izhodiščno leto 2023).</p>
      <div class="tiles ob-tiles">
        {vTiles.map((t) => <div class="tile"><div class="v">{t.v}<small>{t.unit}</small></div><div class="l">{t.l}</div></div>)}
      </div>
      <h3>Stanovanjske in nestanovanjske stavbe</h3>
      {[{ lab: 'Občina', r: resShare, fe: va.fe_gwh }, { lab: 'Slovenija', r: resShareSi, fe: vs.fe_gwh }].map((x) => (
        <div class="ob-stack">
          <span class="ob-stack-l">{x.lab}<small>{nf(x.fe.total, 0)} GWh</small></span>
          <div class="ob-bar" role="img" aria-label={`${x.lab}: stanovanjske stavbe ${nf(x.r, 0)} %, nestanovanjske ${nf(100 - x.r, 0)} % končne energije`}>
            <span class="ob-c lt" style={`width:${x.r}%;background:#1F7A57`}>{x.r >= 12 && <b>stanovanjske {nf(x.r, 0)} %</b>}</span>
            <span class="ob-c lt" style={`width:${100 - x.r}%;background:#2A6FC9`}>{100 - x.r >= 12 && <b>nestanovanjske {nf(100 - x.r, 0)} %</b>}</span>
          </div>
        </div>
      ))}
      <p class="note">Raba končne energije v nestanovanjskih stavbah je {va.nres_kwh_m2 === null ? '–' : nf(va.nres_kwh_m2)} kWh/m² (Slovenija {nf(vs.nres_kwh_m2 ?? 0)}); za {va.nres_measured_area_pct === null ? '–' : nf(va.nres_measured_area_pct, 0)} % njihove površine je raba izmerjena (energetsko knjigovodstvo javnega sektorja 2025 ali merjena izkaznica), za druge ocenjena z modelom.{va.dh_ove_pct !== null && ` Daljinska toplota v občini je iz obnovljivih virov ${nf(va.dh_ove_pct, 0)} % (AGEN-RS, 2025).`}</p>
      <p class="note"><strong>Pri primerjavi na prebivalca pazite:</strong> bolnišnice, srednje šole, trgovski centri in hoteli služijo tudi prebivalcem drugih občin in turistom. Zato imajo središča in turistične občine več energije na prebivalca, ne da bi bile njihove stavbe slabše. Podobno počitniška stanovanja in hiše (vikendi) nimajo stalnih prebivalcev, zato je v turističnih občinah višja tudi raba stanovanjskih stavb na prebivalca.</p>
    </section>

    <section class="ob-peer" aria-labelledby="ob-peer-t">
      <h2 id="ob-peer-t">Primerjava s sosednjimi in podobnimi občinami</h2>
      <p><a class="btn" href={`${pageUrl('primerjava')}?o=${[sifra, ...me.neighbours.slice(0, 3)].join(',')}`}>Primerjaj z izbranimi občinami</a></p>
      <p>Občina {o.name} spada med <strong>{grpName}</strong> ({grp.length} občin). Po rabi energije v stanovanjskih stavbah na prebivalca je {rank}. od {grp.length} (1 = najnižja raba).</p>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Primerjava s podobnimi občinami">
        <table>
          <thead><tr><th scope="col">Kazalnik</th><th scope="col" class="num">Občina</th><th scope="col" class="num">Sosednje občine (povprečje)</th><th scope="col" class="num">{grpName} (mediana)</th><th scope="col" class="num">Slovenija</th></tr></thead>
          <tbody>{peerRows.map((r) => <tr><th scope="row">{r.l}</th><td class="num"><b>{r.o === null ? '–' : nf(r.o, r.d) + r.u}</b></td><td class="num">{r.n === null ? '–' : nf(r.n, r.d) + r.u}</td><td class="num">{r.g === null ? '–' : nf(r.g, r.d) + r.u}</td><td class="num">{r.s === null ? '–' : nf(r.s, r.d) + r.u}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">Sosednje občine: {nb.map((r, i) => <>{i > 0 && ', '}<a href={withBase(`obcina/${r.sifra}/`)}>{r.name}</a></>)}. Skupine: mestne občine; turistične občine (površina hotelov in gostinstva na prebivalca vsaj trikrat nad državnim povprečjem); druge po gostoti poselitve (gosto nad 150, srednje 60–150, redko pod 60 prebivalcev na km², SURS 2026). Kazalniki z rabo energije, emisijami in obnovljivimi viri so ocena modela.</p>
    </section>

    <div class="ob-part" id="del-2">
      <span class="ob-part-n" aria-hidden="true">2</span>
      <div><p class="ob-part-t">NPS 2050 v občini</p><p class="ob-part-s">Kaj državni cilji pomenijo za občino in kakšna je pot do leta 2050</p></div>
    </div>
    <section class="ob-cilji" aria-labelledby="ob-cilji-t">
      <p class="ob-model-k">NPS 2050 v občini · ponazoritev</p>
      <h2 id="ob-cilji-t">Kaj cilji NPS 2050 pomenijo za občino {o.name}</h2>
      <p>Državni cilji iz osnutka, preneseni na občino sorazmerno z njenim stavbnim fondom in oceno modela. To ni obveznost občine, ampak pomoč pri načrtovanju: pove, koliko prenove bi bilo v občini potrebne, če bi sledila državnemu tempu.</p>
      <div class="tiles ob-tiles">
        <div class="tile"><div class="v">{nf(Math.round(ci.prenova_skupaj_m2_leto['2026_2030'] / 100) * 100)}<small> m²</small></div><div class="l">stavb na leto bi bilo treba energetsko prenoviti v obdobju 2026–2030 (vse vrste stavb)</div></div>
        <div class="tile"><div class="v">{nf(Math.round(ci.wpb.m2_leto_2026_2030 / 100) * 100)}<small> m²</small></div><div class="l">na leto od tega iz skupine 43 % najmanj učinkovitih stanovanjskih stavb (v občini okoli {nf(Math.round(ci.wpb.area_m2 / 1000))} tisoč m²)</div></div>
        <div class="tile"><div class="v">{nf(ci.meps.n_2030)}</div><div class="l">nestanovanjskih stavb bi morali izboljšati do leta 2030 in še {nf(Math.max(0, ci.meps.n_2033 - ci.meps.n_2030))} do leta 2033 (minimalni standardi, ocena)</div></div>
      </div>
      <h3>V številkah: kaj to pomeni na leto</h3>
      <div class="tiles ob-tiles ob-st">
        <div class="tile"><div class="v">{nf(st.hise_leto)}</div><div class="l">hiš na leto (povprečna hiša v občini ima {nf(st.povrsina_hise)} m²)</div></div>
        {st.stanovanja_leto > 0 && <div class="tile"><div class="v">{nf(st.stanovanja_leto)}</div><div class="l">stanovanj v blokih na leto (povprečno {nf(st.povrsina_stanovanja)} m²)</div></div>}
        <div class="tile"><div class="v">{nf(st.javne_leto + st.zasebne_leto)}</div><div class="l">javnih in storitvenih stavb na leto (javnih {nf(st.javne_leto)}, storitvenih {nf(st.zasebne_leto)})</div></div>
        <div class="tile"><div class="v">{mio(st.nalozba_eur_leto)}</div><div class="l">naložb na leto, do leta 2030 skupaj okoli {mio(st.nalozba_eur_2030)}</div></div>
        <div class="tile"><div class="v">{mio(st.spodbude_eur_leto)}</div><div class="l">na leto bi pokrile nepovratne spodbude (okoli {nf(st.spodbude_delez_pct)} %, državno povprečje)</div></div>
      </div>
      <div class={`ob-sem ${SEM[st.semafor][1]}`}>
        <p class="ob-sem-h"><span class="ob-sem-dot" aria-hidden="true"></span>Tempo prenove stanovanjskih stavb: <strong>{SEM[st.semafor][0]}</strong></p>
        {st.semafor === 'ni podatka'
          ? <p>V registrih je za leta 2023–2025 premalo vpisanih prenov ({nf(st.prenov_registri)}), da bi lahko ocenili tempo.</p>
          : <p>V letih 2023–2025 je bilo po registrih prenovljenih okoli {nf(st.stopnja_dejanska_pct, 2)} % stanovanjske površine na leto (Slovenija {nf(stSi.stopnja_dejanska_pct, 2)} %); zahtevano je {nf(st.stopnja_zahtevana_pct, 2)} % (Slovenija {nf(stSi.stopnja_zahtevana_pct, 2)} %). {st.semafor === 'na poti' ? 'Občina prispeva vsaj svoj sorazmerni delež k državnemu tempu.' : 'Občina prispeva manj od svojega sorazmernega deleža k državnemu tempu.'}</p>}
        <p class="note">Primerjava tempa prenov v občini s slovenskim povprečjem, glede na to, koliko mora občina prenoviti. Vir: vpisane obnove v katastru nepremičnin in ukrepi Eko sklada 2023–2025; registri ne zajamejo vseh prenov, zato se primerjajo deleži in ne absolutne stopnje.</p>
      </div>
      <h3>Mesto občine med občinami</h3>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Rang občine">
        <table>
          <caption class="visually-hidden">Mesto občine (1. = najugodneje)</caption>
          <thead><tr><th scope="col">Kazalnik</th><th scope="col" class="num">Med 212 občinami</th><th scope="col" class="num">V skupini »{grpName}«</th></tr></thead>
          <tbody>{Object.values(st.rang).map((r) => <tr><th scope="row">{r.oznaka} <small>({r.smer === 'nizko' ? 'nižje je bolje' : 'višje je bolje'})</small></th><td class="num">{nf(r.vse.mesto)}. od {nf(r.vse.od)}</td><td class="num">{nf(r.skupina.mesto)}. od {nf(r.skupina.od)}</td></tr>)}</tbody>
        </table>
      </div>
      <h3>Obseg prenove po vrstah stavb</h3>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Obseg prenove po vrstah stavb">
        <table>
          <caption class="visually-hidden">Potrebni letni obseg energetske prenove v občini po vrstah stavb, m² na leto</caption>
          <thead><tr><th scope="col">Vrsta stavb</th><th scope="col" class="num">2026–2030 [m²/leto]</th><th scope="col" class="num">2031–2040 [m²/leto]</th></tr></thead>
          <tbody>{SEGN.map(([k, n]) => <tr><th scope="row">{n}</th><td class="num">{nf(ci.prenova_m2_leto[k]['2026_2030'])}</td><td class="num">{nf(ci.prenova_m2_leto[k]['2031_2040'])}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="ob-kol"><a href={`${pageUrl('koledar')}?za=obcine`}>Koledar za občine in javni sektor</a>: roki za javne stavbe, minimalni standardi, sončne elektrarne in drugi mejniki do leta 2050.</p>
      <h3>Opuščanje kurilnega olja in zemeljskega plina</h3>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Opuščanje fosilnih goriv">
        <table>
          <caption class="visually-hidden">Raba kurilnega olja in zemeljskega plina v stavbah občine, GWh na leto: ocena 2023 in pot po scenariju NPS 2050</caption>
          <thead><tr><th scope="col">Energent</th><th scope="col" class="num">2023 (ocena)</th><th scope="col" class="num">2030</th><th scope="col" class="num">2040</th><th scope="col" class="num">2050</th></tr></thead>
          <tbody>
            {[['elko', 'kurilno olje'], ['gas', 'zemeljski plin']].map(([g, n]) => <tr><th scope="row">{n} [GWh]</th><td class="num">{nf(ci.fosilna[g].gwh_2023, 1)}</td>{ci.fosilna[g].gwh.map((v) => <td class="num">{nf(v, 1)}</td>)}</tr>)}
          </tbody>
        </table>
      </div>
      <p class="note">Obseg prenove: državni letni obseg po vrstah stavb iz osnutka (preglednica potrebnega obsega prenov), razdeljen po deležu uporabne površine občine. Skupina 43 %: ocenjena površina nad pragom v občini in državni tempo najmanj 1,1 mio m² na leto. Fosilna goriva: ocenjena raba v občini, zmanjšana v enakem razmerju kot v scenariju NPS 2050 za državo. Minimalni standardi: nestanovanjske stavbe, prilagojeno deležu nad pragom med izkaznicami {ci.meps.local_ei ? 'v občini' : 'v Sloveniji (v občini je premalo izkaznic)'}.</p>
    </section>

    <section class="ob-cilji ob-pot" aria-labelledby="ob-pot-t">
      <p class="ob-model-k">NPS 2050 v občini · pot do leta 2050</p>
      <h2 id="ob-pot-t">Pot občine do leta 2050 po scenariju NPS 2050</h2>
      <p>Če bi se stavbe v občini prenavljale enako kot v scenariju NPS 2050 za vso državo, bi se raba končne energije v stavbah do leta 2050 zmanjšala za <strong>{-red(pot['2023'].fe_gwh, pot['2050'].fe_gwh)} %</strong> (Slovenija {-red(potSi['2023'].fe_gwh, potSi['2050'].fe_gwh)} %), emisije pa za {-red(pot['2023'].tgp_kt, pot['2050'].tgp_kt)} %. Občine z več starimi in slabo izoliranimi stavbami imajo večji potencial zmanjšanja.</p>
      <div class="ob-pot-grid">
        <Stolpci id="st-pot-fe" title="Raba končne energije v stavbah, GWh na leto" labels={PY} series={[{ name: 'raba končne energije', values: PY.map((y) => pot[y].fe_gwh), color: '#1F7A57' }]} />
        <Stolpci id="st-pot-tgp" title="Emisije TGP iz stavb, kt CO₂ ekv. na leto" labels={PY} series={[{ name: 'emisije', values: PY.map((y) => pot[y].tgp_kt), color: '#8F5A08' }]} />
      </div>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Pot do leta 2050">
        <table>
          <thead><tr><th scope="col">Kazalnik</th>{PY.map((y) => <th scope="col" class="num">{y}</th>)}</tr></thead>
          <tbody>
            <tr><th scope="row">Delež obnovljivih virov [%]</th>{PY.map((y) => <td class="num">{nf(pot[y].ove_pct, 0)}</td>)}</tr>
            <tr><th scope="row">Delež kurilnega olja in plina [%]</th>{PY.map((y) => <td class="num">{nf(pot[y].fossil_pct, 0)}</td>)}</tr>
          </tbody>
        </table>
      </div>
      <p class="note">Ponazoritev: prehodi med energijskimi razredi po scenariju NPS 2050 (model RenRates) so uporabljeni za vsako stavbo v občini; vsota za državo po vrstah stavb sledi osnutku, emisije in delež obnovljivih virov pa se za državo ujemajo z osnutkom v vsakem letu. Leto 2023 je izhodišče.</p>
    </section>

    <section class="ob-cilji ob-dh" aria-labelledby="ob-dh-t">
      <p class="ob-model-k">NPS 2050 v občini · daljinsko ogrevanje</p>
      <h2 id="ob-dh-t">Potencial za daljinsko ogrevanje</h2>
      {dh.fe_ha > 0 || dh.ha > 0
        ? <p>Na območjih, kjer stavbe na hektar na leto rabijo vsaj 250 MWh končne energije goriv in daljinske toplote, je <strong>{nf(dh.fe_pct, 0)} %</strong> te energije v občini (Slovenija {nf(dhSi.fe_pct, 0)} %), na <strong>{nf(dh.fe_ha)} ha</strong>. Tako gosta območja so praviloma primerna za daljinsko ogrevanje. Po toplotni karti potrebne toplote je delež {nf(dh.pct, 0)} % (Slovenija {nf(dhSi.pct, 0)} %).</p>
        : <p>V občini ni območij, kjer bi gostota odjema dosegla 250 MWh na hektar na leto (Slovenija: {nf(dhSi.fe_pct, 0)} % končne energije goriv in daljinske toplote na takih območjih). Primernejše so individualne rešitve ali manjši skupni sistemi.</p>}
      <h3>Po rabi končne energije (ocena modela, 2023)</h3>
      <div class="tiles ob-tiles">
        <div class="tile"><div class="v">{nf(dh.fe_pct, 0)}<small> %</small></div><div class="l">končne energije goriv in daljinske toplote na območjih z gostoto vsaj 250 MWh/ha (Slovenija {nf(dhSi.fe_pct, 0)} %)</div></div>
        <div class="tile"><div class="v">{nf(dh.fe_dense_gwh, dh.fe_dense_gwh < 10 ? 1 : 0)}<small> GWh</small></div><div class="l">na leto na teh območjih, od skupaj {nf(dh.fe_gwh, dh.fe_gwh < 10 ? 1 : 0)} GWh v občini</div></div>
        <div class="tile"><div class="v">{nf(dh.fe_ha)}<small> ha</small></div><div class="l">površina območij z gostoto vsaj 250 MWh/ha (celice 100 × 100 m)</div></div>
        <div class="tile"><div class="v">{nf(mo.carriers_pct.dh, 0)}<small> %</small></div><div class="l">sedanji delež daljinske toplote v rabi energije v stanovanjskih stavbah (ocena)</div></div>
      </div>
      <h3>Po potrebni toploti za ogrevanje (toplotna karta 2020)</h3>
      <div class="tiles ob-tiles">
        <div class="tile"><div class="v">{nf(dh.pct, 0)}<small> %</small></div><div class="l">potrebne toplote za ogrevanje na območjih z gostoto vsaj 250 MWh/ha (Slovenija {nf(dhSi.pct, 0)} %)</div></div>
        <div class="tile"><div class="v">{nf(dh.dense_gwh, dh.dense_gwh < 10 ? 1 : 0)}<small> GWh</small></div><div class="l">na leto na teh območjih, od skupaj {nf(dh.q_gwh, dh.q_gwh < 10 ? 1 : 0)} GWh v občini</div></div>
        <div class="tile"><div class="v">{nf(dh.ha)}<small> ha</small></div><div class="l">površina območij z gostoto vsaj 250 MWh/ha (celice 100 × 100 m)</div></div>
      </div>
      <h3>Omrežja v občini</h3>
      {om.do
        ? <p>V občini {sysTxt(om.do.sistemi)} daljinskega ogrevanja, {om.do.sistemi === 1 ? 'ki je' : om.do.sistemi === 2 ? 'ki sta' : 'ki so'} leta 2024 {om.do.sistemi === 1 ? 'prodal' : om.do.sistemi === 2 ? 'prodala' : 'prodali'} <strong>{nf(om.do.prodaja_gwh, om.do.prodaja_gwh < 10 ? 1 : 0)} GWh</strong> toplote{om.do.ove_pct !== null && <>; obnovljivi viri so dali {nf(om.do.ove_pct, 0)} % goriva{om.do.plin_pct ? <>, zemeljski plin {nf(om.do.plin_pct, 0)} %</> : ''}</>}{om.do.ove_pct === null && om.do.proizvodnja_gwh === 0 && <>; toploto kupujejo iz sistema v drugi občini</>}{om.do.ucinkovit === true && <>. Daljinsko ogrevanje v občini je po merilih EU učinkovito</>}{om.do.ucinkovit === false && <>. Daljinsko ogrevanje v občini po merilih EU ni učinkovito</>}.</p>
        : <p>V občini ni sistema daljinskega ogrevanja, ki bi poročal Agenciji za energijo.</p>}
      <p>Zemeljski plin: v stavbah v občini se ga po oceni modela porabi okoli <strong>{nf(om.plin.raba_gwh_ocena, om.plin.raba_gwh_ocena < 10 ? 1 : 0)} GWh</strong> na leto. Podatki distributerjev (dolžina omrežja, število odjemalcev, distribuirane količine) so v pridobivanju.</p>
      <p class="note">Viri: Agencija za energijo, poročila izvajalcev daljinskega ogrevanja za leto 2024 (prodana toplota, gorivo po kraju proizvodnje); zemeljski plin – ocena modela IJS CEU (stanje 2023).</p>
      <p class="note">Končna energija: ocena modela za vsako stavbo (goriva in daljinska toplota za ogrevanje in toplo vodo, brez elektrike in toplote okolice), sešteta po celicah 100 × 100 m glede na lego stavbe v katastru; stanje 2023, usklajeno z energetsko bilanco. Potrebna toplota: toplotna karta 2020 (vse stavbe), izdelana neodvisno in neusklajena z bilanco, zato je višja. Oba kazalnika kažeta tehnični potencial glede na gostoto odjema; ne upoštevata obstoječih omrežij, virov toplote in ekonomike posameznega sistema. Z energetsko prenovo stavb se gostota odjema zmanjšuje.</p>
    </section>

    <div class="ob-part" id="del-3">
      <span class="ob-part-n" aria-hidden="true">3</span>
      <div><p class="ob-part-t">Stanovanjske stavbe</p><p class="ob-part-s">Raba energije, energenti in energijski razredi (ocena modela)</p></div>
    </div>
    <section class="ob-model" aria-labelledby="ob-model-t">
      <p class="ob-model-k">Ocena modela</p>
      <h2 id="ob-model-t">Raba energije v stanovanjskih stavbah</h2>
      <p>Za večino stavb ni izmerjenih podatkov, zato je raba ocenjena z modelom, s katerim so izračunani scenariji NPS 2050. Model upošteva vrsto in starost vsake stavbe, izkaznice, ukrepe Eko sklada, obnove iz katastra in toplotno karto, vsota za vso Slovenijo pa se ujema z energetsko bilanco. <a href={`${pageUrl('obcine')}#metoda`}>Kako je ocena izračunana</a></p>
      <div class="tiles ob-tiles">
        <div class="tile"><div class="v">{nf(mo.fe_gwh, 0)}<small> GWh</small></div><div class="l">raba končne energije na leto (razpon {nf(mo.fe_gwh_lo, 0)}–{nf(mo.fe_gwh_hi, 0)} GWh)</div></div>
        <div class="tile"><div class="v">{nf(mo.fe_kwh_m2)}<small> kWh/m²</small></div><div class="l">raba končne energije na m² uporabne površine (Slovenija {nf(ms.fe_kwh_m2)})</div></div>
        <div class="tile"><div class="v">{nf(mo.pe_kwh_m2)}<small> kWh/m²</small></div><div class="l">raba primarne energije na m² (Slovenija {nf(ms.pe_kwh_m2)})</div></div>
        <div class="tile"><div class="v">{nf(mo.above43_area_pct, 0)} %</div><div class="l">stanovanjske površine je ocenjeno nad pragom 43 % najmanj učinkovitih (Slovenija {nf(ms.above43_area_pct, 0)} %)</div></div>
      </div>
      <h3>S čim se ogrevajo</h3>
      {carRows.map((r) => (
        <div class="ob-stack">
          <span class="ob-stack-l">{r.lab}</span>
          <div class="ob-bar" role="img" aria-label={`${r.lab}: ${md.carriers.map((k) => `${k.name} ${nf(r.c[k.id], 1)} %`).join(', ')}`}>
            {md.carriers.map((k) => r.c[k.id] > 0 && <span class={`ob-c ${CAR_LT.has(k.id) ? 'lt' : ''}`} style={`width:${r.c[k.id]}%;background:${CAR_COL[k.id]}`}>{r.c[k.id] >= 8 && <b>{nf(r.c[k.id], 0)} %</b>}</span>)}
          </div>
        </div>
      ))}
      <ul class="ob-leg" aria-hidden="true">{md.carriers.map((k) => <li><i style={`background:${CAR_COL[k.id]}`}></i>{k.name}</li>)}</ul>
      <p class="note">Delež končne energije za ogrevanje, toplo vodo, prezračevanje in razsvetljavo. Toplota okolice je toplota, ki jo toplotne črpalke odvzamejo zraku, zemlji ali vodi.</p>
      <h3>Ocenjena razvrstitev vseh stanovanjskih stavb po razredih NPS</h3>
      {npsRows.map((r) => (
        <div class="ob-stack">
          <span class="ob-stack-l">{r.lab}</span>
          <div class="ob-bar" role="img" aria-label={`${r.lab}: ${md.classes.map((k) => `razred ${k} ${nf(r.c[k], 1)} %`).join(', ')}`}>
            {md.classes.map((k) => r.c[k] > 0 && <span class={`ob-c ${LIGHT_TXT.has(k) ? 'lt' : ''}`} style={`width:${r.c[k]}%;background:var(--cls-${CV[k]})`}>{r.c[k] >= 6 && <b>{k}</b>}</span>)}
          </div>
        </div>
      ))}
      <p class="note">Deleži uporabne površine. Za razliko od razvrstitve zgoraj, ki velja le za stavbe z izkaznico, ta ocena zajame vse stanovanjske stavbe v občini. Neposredni podatek (izkaznico) ima {nf(mo.known_pct, 1)} % stavb. Občina {tkTxt}. Razpon kaže, kako se ocena spremeni, če toplotne karte ne upoštevamo ali jo upoštevamo močneje.</p>
    </section>

    <div class="ob-part" id="del-4">
      <span class="ob-part-n" aria-hidden="true">4</span>
      <div><p class="ob-part-t">Podatki iz registrov</p><p class="ob-part-s">Kataster, energetske izkaznice in Eko sklad</p></div>
    </div>
    <h2 id="reg-seg">Stavbe po segmentih</h2>
    <div class="tblwrap" tabindex="0" role="region" aria-label="Stavbe po segmentih">
      <table>
        <thead><tr><th scope="col">Segment</th><th scope="col" class="num">Stavbe</th><th scope="col" class="num">Površina [tisoč m²]</th><th scope="col" class="num">Stavbe z izkaznico</th><th scope="col" class="num">Površina z izkaznico</th><th scope="col" class="num">Slovenija: površina z izkaznico</th></tr></thead>
        <tbody>
          {ix.segments.map((s) => { const g = o.segments[s.id], gs = si.segments[s.id]; return (
            <tr><th scope="row">{s.name}</th><td class="num">{g.buildings === null ? few : nf(g.buildings)}</td><td class="num">{g.area_k_m2 === null ? '–' : nf(g.area_k_m2, 1)}</td>
              <td class="num">{pct(g.ei_buildings_pct) ?? '–'}</td><td class="num">{pct(g.ei_area_pct) ?? '–'}</td><td class="num">{pct(gs.ei_area_pct)}</td></tr>); })}
        </tbody>
      </table>
    </div>
    <p class="note">Javne stavbe so nestanovanjske stavbe, katerih pretežna dejanska raba je javna (uprava, šola, vrtec, zdravstvo, kultura, šport …), kot v osnutku NPS 2050.</p>

    <h2 id="reg-gradnja">Kdaj so bile zgrajene stanovanjske stavbe</h2>
    {[['Občina ' + o.name, o.res_period_area_pct], ['Slovenija', si.res_period_area_pct]].map(([lab, per]) => (
      <div class="ob-stack">
        <span class="ob-stack-l">{lab as string}</span>
        <div class="ob-bar" role="img" aria-label={`${lab}: ${ix.periods.map((p) => `${p} ${pct((per as Record<string, number | null>)[p]) ?? 'ni podatka'}`).join(', ')}`}>
          {ix.periods.map((p, i) => { const v = (per as Record<string, number | null>)[p] ?? 0; return v > 0 && <span class={`ob-p ob-p${i}`} style={`width:${v}%`}>{v >= 9 && `${nf(v, 0)} %`}</span>; })}
        </div>
      </div>
    ))}
    <ul class="ob-leg" aria-hidden="true">{ix.periods.map((p, i) => <li><i class={`ob-p ob-p${i}`}></i>{p}</li>)}</ul>
    <p class="note">Deleži uporabne površine stanovanjskih stavb po obdobju gradnje. Stavbe pred letom 1981 so nastale pred prvimi toplotnimi predpisi. </p>

    <h2 id="reg-razredi">Energijski razredi stanovanjskih stavb z izkaznico</h2>
    <p>Razred je določen iz primarne energije v računski energetski izkaznici po mejah razredov iz osnutka NPS 2050, posebej za hiše in bloke. Izkaznice imajo predvsem stavbe, ki so bile prodane ali oddane, zato razvrstitev ni nujno reprezentativna za vse stavbe v občini.</p>
    {clsBlocks.map((cb) => (
      <div class="ob-cls">
        <h3>{cb.name}</h3>
        {cb.rows ? <>
          {cb.rows.map((r) => (
            <div class="ob-stack">
              <span class="ob-stack-l">{r.lab}<small>{nf(r.n)} stavb</small></span>
              <div class="ob-bar" role="img" aria-label={`${r.lab}: ${cb.keys.map((k) => `razred ${k} ${nf(r.c[k], 1)} %`).join(', ')}`}>
                {cb.keys.map((k) => r.c[k] > 0 && <span class={`ob-c ${LIGHT_TXT.has(k) ? 'lt' : ''}`} style={`width:${r.c[k]}%;background:var(--cls-${CG[k] ?? CV[k]})`}>{r.c[k] >= (cb.grouped ? 12 : 7) && <b>{cb.grouped ? `${k} · ${nf(r.c[k], 0)} %` : k}</b>}</span>)}
              </div>
            </div>
          ))}
          {cb.grouped && <p class="note">Razredi so združeni v tri skupine, ker ima posamezen razred v občini manj kot {MIN} stavb z izkaznico.</p>}
        </> : <p class="note">Premalo izkaznic za zanesljivo razvrstitev (izkaznic: {nf(cb.n ?? 0)}).</p>}
      </div>
    ))}

    <h2 id="reg-najslabse">Najslabše stavbe in minimalni standardi</h2>
    <div class="ob-cmp">
      {[
        cmp('Stanovanjske stavbe z izkaznico nad pragom 43 % najmanj učinkovitih', o.res_above43_pct, si.res_above43_pct),
        cmp('Nestanovanjske stavbe z izkaznico nad pragom minimalnih standardov 2030', o.nres_above_meps30_pct, si.nres_above_meps30_pct),
        cmp('Nestanovanjske stavbe z izkaznico nad pragom minimalnih standardov 2033', o.nres_above_meps33_pct, si.nres_above_meps33_pct),
      ].map((c) => (
        <div class="ob-cmp-r">
          <p class="ob-cmp-l">{c.label}</p>
          {c.v === null ? <p class="note">Premalo izkaznic za zanesljiv delež.</p> : (
            <div class="ob-pair" role="img" aria-label={`Občina ${nf(c.v, 1)} %, Slovenija ${nf(c.s, 1)} %`}>
              <span class="lab">Občina</span><span class="trk"><i class="o" style={`width:${c.v}%`}></i></span><b>{nf(c.v, 1)} %</b>
              <span class="lab">Slovenija</span><span class="trk"><i class="s" style={`width:${c.s}%`}></i></span><b>{nf(c.s, 1)} %</b>
            </div>
          )}
        </div>
      ))}
    </div>
    <p class="note">Deleži med stavbami z veljavno računsko izkaznico. Pragovi iz osnutka: za hiše {nf(320)} in za bloke {nf(222)} kWh/(m²·a) primarne energije; za nestanovanjske stavbe po kategorijah (glej <a href={pageUrl('preveri')}>Preverite svojo stavbo</a>).</p>

    <h2 id="reg-eko">Prenove, ki jih je podprl Eko sklad</h2>
    <p>Delež stanovanjskih stavb v občini, v katerih je Eko sklad podprl vsaj eno naložbo posamezne vrste (vsa leta do 2025). Skupaj ima vsaj en tak ukrep {pct(o.es_res_any_pct) ?? '–'} stanovanjskih stavb (Slovenija {nf(si.es_res_any_pct, 1)} %).</p>
    <div class="tblwrap" tabindex="0" role="region" aria-label="Ukrepi Eko sklada">
      <table class="ob-es">
        <thead><tr><th scope="col">Ukrep</th><th scope="col" class="num">Stavbe</th><th scope="col">Delež stanovanjskih stavb: občina / Slovenija</th></tr></thead>
        <tbody>
          {esRows.map((r) => (
            <tr><th scope="row">{r.name}</th><td class="num">{r.o.b === null ? few : nf(r.o.b)}</td>
              <td><div class="ob-mini" aria-label={`občina ${pct(r.o.pct) ?? 'ni podatka'}, Slovenija ${pct(r.s.pct)}`} role="img">
                <span class="trk"><i class="o" style={`width:${(100 * (r.o.pct ?? 0)) / esMax}%`}></i></span><b>{pct(r.o.pct) ?? '–'}</b>
                <span class="trk"><i class="s" style={`width:${(100 * (r.s.pct ?? 0)) / esMax}%`}></i></span><b class="s">{pct(r.s.pct)}</b>
              </div></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">Veliko prenov se izvede brez spodbude Eko sklada, zato ti deleži niso celoten obseg prenov.</p>

    <h2 id="reg-obnove">Obnove, vpisane v kataster</h2>
    <div class="ob-cmp">
      {[
        cmp('Stanovanjske stavbe z vpisanim letom obnove strehe, fasade ali oken', o.obnova_res_pct, si.obnova_res_pct),
        cmp('… od tega obnova leta 2010 ali pozneje', o.obnova_res_since2010_pct, si.obnova_res_since2010_pct),
      ].map((c) => (
        <div class="ob-cmp-r">
          <p class="ob-cmp-l">{c.label}</p>
          {c.v === null ? <p class="note">Premalo podatkov.</p> : (
            <div class="ob-pair" role="img" aria-label={`Občina ${nf(c.v, 1)} %, Slovenija ${nf(c.s, 1)} %`}>
              <span class="lab">Občina</span><span class="trk"><i class="o" style={`width:${c.v}%`}></i></span><b>{nf(c.v, 1)} %</b>
              <span class="lab">Slovenija</span><span class="trk"><i class="s" style={`width:${c.s}%`}></i></span><b>{nf(c.s, 1)} %</b>
            </div>
          )}
        </div>
      ))}
    </div>
    <p class="note">Leto obnove vpiše lastnik ali geodet ob spremembi v katastru. Vpis ne pove, ali je bila obnova energetska; starejši vpisi pogosto pomenijo le barvanje fasade ali menjavo kritine. V oceni modela zato štejejo le obnove od leta 2010.</p>





    {pub.length > 0 && <>
      <h2 id="reg-javne">Javne stavbe</h2>
      <div class="tblwrap" tabindex="0" role="region" aria-label="Javne stavbe po vrsti">
        <table>
          <thead><tr><th scope="col">Vrsta stavbe</th><th scope="col" class="num">Stavbe</th><th scope="col" class="num">Površina [tisoč m²]</th><th scope="col" class="num">Raba končne energije [kWh/m²]</th><th scope="col" class="num">Slovenija [kWh/m²]</th><th scope="col" class="num">Površina z izmerjeno rabo [%]</th></tr></thead>
          <tbody>{pub.map((c) => <tr><th scope="row">{c.name}</th><td class="num">{c.b === null ? few : nf(c.b)}</td><td class="num">{c.a === null ? '–' : nf(c.a, 1)}</td><td class="num"><b>{c.e?.kwh_m2 == null ? '–' : nf(c.e.kwh_m2)}</b></td><td class="num">{c.es?.kwh_m2 == null ? '–' : nf(c.es.kwh_m2)}</td><td class="num">{c.e?.meas_pct == null ? '–' : nf(c.e.meas_pct)}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">Raba končne energije je ocena: kjer je na voljo, izmerjena raba iz energetskega knjigovodstva javnega sektorja (2025) ali merjene izkaznice, sicer model. Pri elektriki je upoštevanih 80 % (raba za naprave ni v obsegu načrta). Raba na m² je prikazana pri vsaj treh stavbah iste vrste, da ni mogoče razbrati podatkov posamezne stavbe.</p>
    </>}

    <div class="card green ob-lek" id="lek">
      <p><strong>Energetsko-podnebna kartica občine: stavbe.</strong> Stanje, energenti, energijski razredi in pot do leta 2050; kaj cilji NPS 2050 pomenijo za občino v številkah, s koledarjem za občine; podatki za lokalni energetski koncept (LEK); za tisk ali kot PDF in v obliki CSV. Kartica je intelektualna lastnina IJS CEU; uporaba je dovoljena z navedbo vira, brez predelave in brez komercialne uporabe (CC BY-NC-ND 4.0).</p>
      <p><a class="btn primary" href={withBase(`obcina/${o.sifra}/lek/`)}>Kartica za tisk / PDF</a> <a class="btn" href={withBase(`obcina/${o.sifra}/lek.csv`)} download={`NPS2050_${o.name}_LEK.csv`}>CSV</a> <a class="btn" href={withBase(`data/paket/obcina-${o.sifra}.zip`)} download={`NPS2050_${o.name}_paket.zip`}>Podatkovni paket (ZIP)</a> <a class="btn" href={withBase(`regija/${regijaSlug(o.region_name)}/`)}>Kartica regije {o.region_name}</a></p>
      <p class="note">Podatkovni paket vsebuje vse kazalnike občine s primerjavo s sosednjimi občinami, skupino in Slovenijo, podatke v obliki JSON, slovar polj in metapodatke.</p>
    </div>
    <div class="card ob-more">
      <p><strong>Podatki za prenos:</strong> <a href={withBase(`data/obcine/${o.sifra}.json`)} download>JSON (občina {o.name})</a> · <a href={withBase('data/csv/obcine.csv')} download>CSV (vse občine)</a>. Licenca CC BY 4.0.</p>
      <p>Kaj načrt pomeni za posamezno stavbo: <a href={pageUrl('preveri')}>Preverite svojo stavbo</a>. Stavbni fond vse Slovenije: <a href={pageUrl('strokovne-podlage')}>Strokovne podlage</a>.</p>
    </div>
    <p class="note">Viri: kataster nepremičnin GURS (30. 8. 2026), register energetskih izkaznic (28. 9. 2026), Eko sklad (podprte naložbe do 2025), meje razredov in pragovi iz osnutka NPS 2050. Objavljeni so samo seštevki, podatki o posameznih stavbah se ne objavijo. Deleži med stavbami z izkaznico so prikazani pri vsakem številu izkaznic; pri majhnem številu so zgolj okvirni.</p>
  </div>
</Base>

