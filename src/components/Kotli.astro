---
/** Časovni načrt opuščanja kotlov na fosilna goriva (pogl. 6.1.6), iz public/data/ukrepi.json. */
import { loadData, type Ukrepi } from '../lib/data';
const d = loadData<Ukrepi>('ukrepi');
---
<ol class="kotli">
  {d.boilers.map((b) => (
    <li class={/velja/.test(b.when) ? 'is-now' : ''}>
      <span class="k-when">{b.when.replace(/\s*\(velja\)/, '')}{/velja/.test(b.when) && <em> velja</em>}</span>
      <div><p class="k-m">{b.milestone}</p><p class="k-e"><b>Podlaga:</b> {b.basis}. <b>Učinek:</b> {b.effect}.</p></div>
    </li>
  ))}
</ol>
<style>
  .kotli { list-style: none; padding: 0; margin: 1rem 0 2rem; max-width: 80ch; border-left: 2px solid var(--line); }
  .kotli li { display: grid; grid-template-columns: 7.5rem 1fr; gap: .2rem 1rem; padding: .2rem 0 1rem 1rem; position: relative; }
  .kotli li::before { content: ''; position: absolute; left: -7px; top: .45rem; width: 12px; height: 12px; border-radius: 50%; background: var(--panel); border: 2px solid var(--green); }
  .kotli li.is-now::before { background: var(--green); }
  @media (max-width: 560px) { .kotli li { grid-template-columns: 1fr; } }
  .k-when { font-weight: 800; color: var(--green); font-variant-numeric: tabular-nums; }
  .k-when em { font-style: normal; font-size: .7rem; font-weight: 700; color: var(--ink); background: var(--greenbg); border-radius: 999px; padding: .05rem .45rem; margin-left: .3rem; }
  .k-m { font-weight: 600; margin: 0 0 .2rem; }
  .k-e { font-size: .85rem; color: var(--ink2); margin: 0; }
</style>
