---
/**
 * Povezava na tipične pakete prenove za stran Za lastnike: gumbi za štiri tipe stavb (hiše in bloki, do 1980 in 1981–2002).
 * Konkretni primeri so v kalkulatorju »Se mi splača?« in na strani Paketi prenove, tu jih ne ponavljamo.
 */
import { pageUrl } from '../i18n/routes';
import { loadData } from '../lib/data';
import Icon from './Icon.astro';

type Tip = { id: string; ime: string; tip: string };
const d = loadData<{ tipi: Tip[] }>('paketi_prenove');
const href = (tid: string) => `${pageUrl('paketi')}?tip=${tid}`;
---
<div class="pp">
  <p class="pp-more"><span>Izberite svoj tip stavbe:</span>
    {d.tipi.map((x) => <a class="btn" href={href(x.id)}><Icon name={x.tip === 'SFH' ? 'house' : 'building-2'} size={16} /> {x.tip === 'SFH' ? 'Hiša' : 'Stanovanje v bloku'}, {x.ime.split(', ')[1].replace('zgrajena ', '').replace('zgrajenem ', '')}</a>)}
  </p>
  <p class="note">Tipične vrednosti iz priznanih stroškov naložb Eko sklada; ne izračun za vašo stavbo. Za svojo hišo ali stanovanje uporabite kalkulator <a href="#se-mi-splača">Se mi splača?</a> zgoraj.</p>
</div>

<style>
  .pp { background: var(--panel); border: 1px solid var(--line); border-top: 4px solid var(--green); border-radius: 16px; padding: 1rem 1.4rem; margin: 1rem 0 2rem; }
  .pp-more { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; margin: 0 0 .4rem; max-width: none; font-size: .9rem; }
  .pp-more > span { grid-column: 1 / -1; color: var(--ink2); }
  @media (max-width: 760px) { .pp-more { grid-template-columns: 1fr 1fr; } }
  .pp-more .btn { display: flex; gap: .35rem; align-items: center; justify-content: center; font-size: .85rem; padding: .4rem .6rem; text-align: center; }
  .pp .note { margin: .5rem 0 0; }
</style>
