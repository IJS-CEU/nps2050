---
/**
 * Moja občina: zemljevid občin, obarvan po izbranem kazalniku (obcine_index.json). Klik na občino odpre njeno stran.
 * Enakovredna preglednica z iskanjem je v ObcineSeznam.astro pod zemljevidom.
 */
import ChartFigure from '../charts/ChartFigure.astro';
import { loadData, type ObcineIndex } from '../../lib/data';
import { nf } from '../../lib/format';

const d = loadData<ObcineIndex>('obcine_index');
---
<ChartFigure
  id="graf-obcine"
  title="Najslabše stavbe in raba energije po občinah"
  subtitle="Izberite kazalnik; klik na občino odpre njeno stran"
  file="nps2050-obcine"
  csv={[{ file: 'obcine_kazalniki.csv', label: 'CSV (kazalniki)' }, { file: 'obcine.csv', label: 'CSV (registri)' }]}
  ariaLabel={`Zemljevid 212 občin, obarvan po izbranem kazalniku. Privzeto: ocenjeni delež površine stanovanjskih stavb v skupini 43 % energetsko najmanj učinkovitih (Slovenija ${nf(d.si.w_res_model_pct, 0)} %). Vse vrednosti so v preglednici občin pod zemljevidom.`}
  height={600}
>
  <Fragment slot="controls">
    <label class="ob-sel"><span class="ctl-label">Kazalnik</span>
      <select id="ob-mera">
        <optgroup label="Najslabše stavbe (delež površine)">
          <option value="w_res_model_pct" selected>Stanovanjske v skupini 43 % – ocena</option>
          <option value="w_res_reg_pct">Stanovanjske v skupini 43 % – stavbe z izkaznico</option>
          <option value="w_nres_reg_pct">Nestanovanjske nad pragom 2030 – stavbe z izkaznico</option>
        </optgroup>
        <optgroup label="Tempo prenove (registri 2023–2025)">
          <option value="t_semafor">Na poti ali pod ciljem (semafor)</option>
        </optgroup>
        <optgroup label="Vse stavbe – primerjava občin (ocena)">
          <option value="k_fe_mwh_preb">Raba končne energije na prebivalca</option>
          <option value="k_tgp_t_preb">Emisije TGP na prebivalca</option>
          <option value="k_ove_pct">Delež obnovljivih virov</option>
          <option value="k_res_fe_mwh_preb">Stanovanjske stavbe: raba energije na prebivalca</option>
          <option value="k_nres_kwh_m2">Nestanovanjske stavbe: raba energije na m²</option>
          <option value="k_dh_fe_pct">Potencial za daljinsko ogrevanje (končna energija)</option>
          <option value="k_dh_pot_pct">Potencial za daljinsko ogrevanje (potrebna toplota)</option>
        </optgroup>
        <optgroup label="Stanovanjske stavbe – ocena modela">
          <option value="model_fe_kwh_m2">Raba končne energije na m²</option>
        </optgroup>
        <optgroup label="Stanovanjske stavbe – registri">
          <option value="ei_area_res_pct">Pokritost z izkaznicami</option>
          <option value="pre1981_res_area_pct">Zgrajeno pred 1981</option>
          <option value="es_res_any_pct">S spodbudo Eko sklada</option>
          <option value="obnova_res_since2010_pct">Obnova od 2010 (kataster)</option>
        </optgroup>
      </select>
    </label>
    <div class="ob-raven" role="group" aria-label="Prikaz po občinah ali regijah" hidden>
      <button type="button" data-r="obcine" aria-pressed="true">Občine</button>
      <button type="button" data-r="regije" aria-pressed="false">Regije</button>
    </div>
  </Fragment>
  <Fragment slot="caption">
    <p id="ob-cap">Barve so razdeljene v pet razredov s podobnim številom občin. Kazalniki z oceno so izračunani z modelom (metoda je opisana spodaj).</p>
    <p>Viri: kataster nepremičnin GURS (30. 8. 2026), register energetskih izkaznic (28. 9. 2026), Eko sklad (do 2025), energetsko knjigovodstvo javnega sektorja (2025), AGEN-RS (daljinska toplota 2025), SURS (prebivalci 1. 1. 2026), model RenRates in osnutek NPS 2050; meje: GURS RPE (CC BY 4.0).</p>
  </Fragment>
  <Fragment slot="table">
    <p>Preglednica vseh občin z iskanjem je pod zemljevidom.</p>
  </Fragment>
</ChartFigure>

<style>
  .ob-sel { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .ob-raven { display: inline-flex; gap: .3rem; margin-left: .8rem; }
  .ob-raven[hidden] { display: none; }
  .ob-raven button { font: inherit; font-size: .82rem; font-weight: 700; padding: .25rem .75rem; border-radius: 999px; border: 1px solid var(--ink2); background: transparent; color: var(--ink2); cursor: pointer; }
  .ob-raven button[aria-pressed='true'] { background: var(--green); border-color: var(--green); color: var(--on-green); }
  .ob-sel select { font: inherit; font-size: .9rem; padding: .35rem .5rem; border: 1px solid var(--ink2); border-radius: 6px; background: var(--panel); color: var(--ink); max-width: 100%; }
</style>

<script>
  import { base, echarts, mount, nf, tipRow, tipTitle, type Tokens } from '../../scripts/charts/core';
  import type { ObcineIndex, ObIndexRow } from '../../lib/data';

  const METRIC: Record<string, { label: string; si: (d: ObcineIndex) => number | null; cap: string; unit?: string; dec?: number; n?: string }> = {
    w_res_model_pct: { label: 'Stanovanjske stavbe v skupini 43 % (ocena)', si: (d) => d.si.w_res_model_pct, dec: 0, cap: 'Ocena modela: delež uporabne površine vseh stanovanjskih stavb, ki sodijo v skupino 43 % energetsko najmanj učinkovitih (nad pragom primarne energije za hiše oziroma bloke). Stavbe z izkaznico imajo znan razred, za druge je razred ocenjen.' },
    w_res_reg_pct: { label: 'Stanovanjske stavbe z izkaznico v skupini 43 %', si: (d) => d.si.w_res_reg_pct, dec: 0, n: 'w_res_reg_n', cap: 'Registri: delež uporabne površine stanovanjskih stavb z računsko izkaznico, ki so nad pragom 43 % energetsko najmanj učinkovitih. Velja samo za stavbe z izkaznico, ki niso naključni vzorec; pri malo izkaznicah je delež okviren.' },
    w_nres_reg_pct: { label: 'Nestanovanjske stavbe z izkaznico nad pragom 2030', si: (d) => d.si.w_nres_reg_pct, dec: 0, n: 'w_nres_reg_n', cap: 'Registri: delež uporabne površine nestanovanjskih stavb z računsko izkaznico, ki so nad pragom minimalnih standardov za leto 2030 (16 % najslabših v kategoriji). Pri malo izkaznicah je delež okviren.' },
    k_fe_mwh_preb: { label: 'Raba končne energije v vseh stavbah na prebivalca', si: (d) => d.si.k_fe_mwh_preb, unit: ' MWh', dec: 1, cap: 'Ocena: letna raba končne energije v vseh stavbah (stanovanjskih, javnih in zasebnih storitvenih) na prebivalca. Občine s središči, bolnišnicami, šolami in turizmom imajo več nestanovanjskih stavb, ki služijo tudi prebivalcem drugih občin.' },
    k_tgp_t_preb: { label: 'Emisije TGP vseh stavb na prebivalca', si: (d) => d.si.k_tgp_t_preb, unit: ' t CO₂ ekv.', dec: 2, cap: 'Ocena: letne emisije toplogrednih plinov iz stavb (neposredne in posredne) na prebivalca, umerjene na osnutek NPS 2050. Veljajo ista opozorila o središčih.' },
    k_ove_pct: { label: 'Delež OVE v rabi energije v stavbah', si: (d) => d.si.k_ove_pct, cap: 'Ocena: delež obnovljivih virov v rabi končne energije v vseh stavbah (lesna biomasa, toplota okolice, sončna energija ter obnovljivi del elektrike in daljinske toplote).' },
    k_res_fe_mwh_preb: { label: 'Raba končne energije v stanovanjskih stavbah na prebivalca', si: (d) => d.si.k_res_fe_mwh_preb, unit: ' MWh', dec: 1, cap: 'Ocena: letna raba končne energije v stanovanjskih stavbah na prebivalca. Najbolj primerljiv kazalnik med občinami.' },
    k_nres_kwh_m2: { label: 'Raba končne energije v nestanovanjskih stavbah na m²', si: (d) => d.si.k_nres_kwh_m2, unit: ' kWh/m²', cap: 'Ocena: letna raba končne energije v javnih in zasebnih storitvenih stavbah na m² uporabne površine; kjer je na voljo, iz energetskega knjigovodstva ali merjenih izkaznic.' },
    k_dh_fe_pct: { label: 'Končna energija goriv in daljinske toplote na območjih z gostoto vsaj 250 MWh/ha', si: (d) => d.si.k_dh_fe_pct, cap: 'Ocena modela: delež rabe končne energije goriv in daljinske toplote (ogrevanje in topla voda, brez elektrike in toplote okolice) v celicah 100 × 100 m z gostoto vsaj 250 MWh/ha na leto. Stanje 2023, usklajeno z energetsko bilanco.' },
    k_dh_pot_pct: { label: 'Potrebna toplota na območjih z gostoto vsaj 250 MWh/ha', si: (d) => d.si.k_dh_pot_pct, cap: 'Delež potrebne toplote za ogrevanje vseh stavb v občini, ki leži v celicah toplotne karte (100 × 100 m) z gostoto vsaj 250 MWh/ha na leto. Večji delež pomeni več območij, primernih za daljinsko ogrevanje.' },
    ei_area_res_pct: { label: 'Stanovanjska površina z veljavno izkaznico', si: (d) => d.si.ei_area_res_pct, cap: 'Delež uporabne površine stanovanjskih stavb, ki imajo vsaj eno veljavno energetsko izkaznico.' },
    pre1981_res_area_pct: { label: 'Stanovanjska površina, zgrajena pred 1981', si: (d) => d.si.pre1981_res_area_pct, cap: 'Delež uporabne površine stanovanjskih stavb, zgrajenih pred prvimi toplotnimi predpisi (1981).' },
    es_res_any_pct: { label: 'Stanovanjske stavbe s spodbudo Eko sklada (2011–2025)', si: (d) => d.si.es_res_any_pct, cap: 'Delež stanovanjskih stavb z vsaj eno naložbo, ki jo je Eko sklad podprl v letih 2011–2025 (izolacija, okna, toplotna črpalka, kotel na biomaso, sončna elektrarna, prezračevanje z vračanjem toplote). Pri večini stavb gre za ogrevanje, elektrarno ali prezračevanje; spodbudo za izolacijo ali okna ima okoli četrtina teh stavb.' },
    obnova_res_since2010_pct: { label: 'Stanovanjske stavbe z obnovo strehe, fasade ali oken od 2010 (vpis v katastru)', si: (d) => d.si.obnova_res_since2010_pct, dec: 1, cap: 'Delež stanovanjskih stavb, pri katerih je v katastru nepremičnin vpisana obnova strehe, fasade ali oken leta 2010 ali pozneje. Vpis je podatek lastnika in ni nujno energetska prenova (lahko je npr. le nova kritina); spodbudo Eko sklada za izolacijo ali okna ima okoli 30 % teh stavb. Starejši vpisi so izpuščeni, ker pogosto pomenijo le vzdrževanje.' },
    model_fe_kwh_m2: { label: 'Ocenjena raba končne energije na m²', si: (d) => d.si.model_fe_kwh_m2, unit: ' kWh/m²', cap: 'Ocena modela: letna raba končne energije v stanovanjskih stavbah na m² uporabne površine (ogrevanje, topla voda, prezračevanje, razsvetljava).' },
    t_semafor: { label: 'Tempo prenove stanovanjskih stavb', si: () => null, cap: 'Semafor: ali se stanovanjske stavbe prenavljajo vsaj s sorazmernim deležem cilja NPS 2050. Tempo prenove (delež stanovanjske površine z vpisano obnovo fasade, strehe ali oken v katastru ali ukrepom Eko sklada na ovoju, 2023–2025) je primerjan s slovenskim; »na poti«, če je razmerje vsaj tolikšno kot razmerje zahtevanega tempa občine in Slovenije. Semafor je relativen: Slovenija kot celota se prenavlja s približno polovico potrebnega tempa. »Ni podatka« pri manj kot 10 prenovah v treh letih.' },
    model_above43_pct: { label: 'Ocenjena površina nad pragom 43 %', si: (d) => d.si.model_above43_pct, cap: 'Ocena modela: delež stanovanjske površine nad pragom 43 % energetsko najmanj učinkovitih stavb.' },
  };

  const b = import.meta.env.BASE_URL.replace(/\/?$/, '/');
  const get = async (f: string) => { const r = await fetch(`${b}data/${f}`); if (!r.ok) throw new Error(f); return r.json(); };

  function breaks(vals: number[], dec: number): number[] {
    const s = [...vals].sort((x, y) => x - y);
    const q = (p: number) => s[Math.min(s.length - 1, Math.floor(p * s.length))];
    const f = 10 ** dec;
    return [...new Set([0.2, 0.4, 0.6, 0.8].map((p) => Math.round(q(p) * f) / f))];
  }

  async function init(fig: HTMLElement) {
    const [d, geo, rgeo, rg] = await Promise.all([get('obcine_index.json'), get('zemljevid_obcine.geojson'), get('zemljevid_regije.geojson'), get('regije.json')]) as [ObcineIndex, any, any, any];
    echarts.registerMap('nps-obcine-ob', geo);
    echarts.registerMap('nps-regije-ob', rgeo);
    const regByName: Record<string, any> = Object.fromEntries(Object.values(rg.regions).map((r: any) => [r.name, r]));
    const slug = (n: string) => n.toLowerCase().replace(/č/g, 'c').replace(/š/g, 's').replace(/ž/g, 'z').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const SEM = ['ni podatka', 'pod ciljem', 'na poti'];
    let raven: 'obcine' | 'regije' = 'obcine';
    const byName: Record<string, ObIndexRow> = Object.fromEntries(d.municipalities.map((m) => [m.name, m]));
    let metric = 'w_res_model_pct';
    const cap = fig.querySelector<HTMLElement>('#ob-cap')!;
    const capBase = cap.textContent!;

    const renderSem = (t: Tokens, o: Record<string, any>, cs: CSSStyleDeclaration) => {
      const col = [t.grid, cs.getPropertyValue('--amber').trim(), cs.getPropertyValue('--green').trim()];
      const reg = raven === 'regije';
      const rows: { name: string; sem: string; ix: number | null; dej: number | null; zah: number | null; extra?: string }[] = reg
        ? Object.values(rg.regions).map((r: any) => ({ name: r.name, sem: r.stevilke.semafor, ix: r.stevilke.indeks_tempo, dej: r.stevilke.stopnja_dejanska_pct, zah: r.stevilke.stopnja_zahtevana_pct,
          extra: `Občine: ${r.stevilke.obcine_semafor['na poti']} na poti, ${r.stevilke.obcine_semafor['pod ciljem']} pod ciljem, ${r.stevilke.obcine_semafor['ni podatka']} brez podatka` }))
        : d.municipalities.map((m) => ({ name: m.name, sem: m.t_semafor, ix: m.t_indeks, dej: m.t_dej_pct, zah: m.t_zah_pct }));
      const cnt = (k: string) => rows.filter((r) => r.sem === k).length;
      const byN = Object.fromEntries(rows.map((r) => [r.name, r]));
      return {
        ...o,
        legend: { show: false },
        tooltip: {
          ...o.tooltip, trigger: 'item',
          formatter: (p: any) => {
            const r = byN[p.name]; if (!r) return '';
            return tipTitle(reg ? `${r.name} regija` : r.name) + tipRow(col[SEM.indexOf(r.sem)], 'Tempo prenove', r.sem, 'rect')
              + (r.dej !== null ? `<div>Prenova ${nf(r.dej, 2)} % stanovanjske površine na leto, sorazmerni delež cilja ${nf(r.zah, 2)} %</div>` : '')
              + (r.ix !== null ? `<div>Indeks tempa ${nf(r.ix, 2)} (1 = sorazmerni delež; Slovenija ${nf(d.si.t_dej_pct, 2)} % na leto)</div>` : '')
              + (r.extra ? `<div>${r.extra}</div>` : '')
              + `<div style="opacity:.75;margin-top:2px">klik odpre ${reg ? 'kartico regije' : 'stran občine'}</div>`;
          },
        },
        visualMap: {
          type: 'piecewise', inverse: true, orient: t.narrow ? 'vertical' : 'horizontal', left: 0, ...(t.narrow ? { top: 262 } : { bottom: 0 }), itemWidth: 14, itemHeight: 10, itemGap: 14,
          pieces: [0, 1, 2].map((v) => ({ value: v, color: col[v], label: `${SEM[v]} (${cnt(SEM[v])})` })),
          textStyle: { color: t.ink2, fontFamily: t.font, fontSize: 11 }, selectedMode: false,
        },
        series: [{
          type: 'map', map: reg ? 'nps-regije-ob' : 'nps-obcine-ob', aspectScale: 0.72, roam: false, showLegendSymbol: false, selectedMode: false,
          layoutCenter: ['50%', t.narrow ? '31%' : '46%'],
          layoutSize: Math.round(Math.min(t.width * 0.98, (t.narrow ? 290 : 520) * 1.54)),
          itemStyle: { borderColor: t.panel, borderWidth: reg ? 1.5 : 0.5 },
          emphasis: { label: { show: reg }, itemStyle: { areaColor: t.s.ref, borderColor: t.ink, borderWidth: 1.5 } },
          label: { show: reg && !t.narrow, color: '#fff', fontFamily: t.font, fontSize: 11, fontWeight: 700, textBorderColor: 'rgba(0,0,0,.6)', textBorderWidth: 3 },
          data: rows.map((r) => ({ name: r.name, value: SEM.indexOf(r.sem) })),
        }],
      };
    };

    const render = (t: Tokens) => {
      const o = base(t) as Record<string, any>;
      const cs = getComputedStyle(document.documentElement);
      if (metric === 't_semafor') return renderSem(t, o, cs);
      const ramp = [1, 2, 3, 4, 5].map((i) => cs.getPropertyValue(`--map-${i}`).trim());
      const U = METRIC[metric].unit ?? ' %';
      const D = METRIC[metric].dec ?? 0;
      const vals = d.municipalities.map((m) => (m as any)[metric]).filter((v: number | null) => v !== null) as number[];
      const br = breaks(vals, D);
      const f = 10 ** D;
      const edges = [Math.floor(Math.min(...vals) * f) / f, ...br, Math.ceil(Math.max(...vals) * f) / f];
      const siv = METRIC[metric].si(d);
      const pieces = edges.slice(0, -1).map((lo, i) => ({
        min: lo, max: edges[i + 1], color: ramp[Math.round((i * (ramp.length - 1)) / Math.max(1, edges.length - 2))],
        label: (i === 0 ? `do ${nf(edges[1], D)}${U}` : i === edges.length - 2 ? `nad ${nf(lo, D)}${U}` : `${nf(lo, D)}–${nf(edges[i + 1], D)}${U}`)
          + (siv !== null && siv >= lo && (siv < edges[i + 1] || i === edges.length - 2) ? ` ◆ Slovenija ${nf(siv, D)}${U}` : ''),
      }));
      const si = METRIC[metric].si(d);
      const u = METRIC[metric].unit ?? ' %';
      const dec = METRIC[metric].dec ?? (u === ' %' ? 1 : 0);
      return {
        ...o,
        legend: { show: false },
        tooltip: {
          ...o.tooltip, trigger: 'item',
          formatter: (p: any) => {
            const m = byName[p.name]; if (!m) return '';
            const v = (m as any)[metric];
            const nk = METRIC[metric].n;
            return tipTitle(m.name) + tipRow(p.color || t.muted, METRIC[metric].label, v === null ? 'ni izkaznic' : `${nf(v, dec)}${u}`, 'rect')
              + (nk ? `<div style="opacity:.75">Izkaznic: ${nf((m as any)[nk])}</div>` : '')
              + `<div style="opacity:.75;margin-top:2px">Slovenija: ${nf(si, dec)}${u} · klik odpre stran občine</div>`;
          },
        },
        visualMap: {
          type: 'piecewise', pieces, orient: t.narrow ? 'vertical' : 'horizontal', left: 0, ...(t.narrow ? { top: 262 } : { bottom: 0 }), itemWidth: 14, itemHeight: 10, itemGap: 10,
          textStyle: { color: t.ink2, fontFamily: t.font, fontSize: 11 }, selectedMode: false, outOfRange: { color: t.grid },
        },
        series: [{
          type: 'map', map: 'nps-obcine-ob', aspectScale: 0.72, roam: false, showLegendSymbol: false, selectedMode: false,
          layoutCenter: ['50%', t.narrow ? '31%' : '46%'],
          layoutSize: Math.round(Math.min(t.width * 0.98, (t.narrow ? 290 : 520) * 1.54)),
          itemStyle: { borderColor: t.panel, borderWidth: 0.5 },
          emphasis: { label: { show: false }, itemStyle: { areaColor: t.s.ref, borderColor: t.ink, borderWidth: 1.5 } },
          label: { show: false },
          data: d.municipalities.map((m) => ({ name: m.name, value: (m as any)[metric] ?? undefined })),
        }],
      };
    };

    const mo = mount(fig, render);
    mo.chart.on('click', (p: any) => {
      if (metric === 't_semafor' && raven === 'regije') { if (regByName[p.name]) location.href = `${b}regija/${slug(p.name)}/`; return; }
      const m = byName[p.name]; if (m) location.href = `${b}obcina/${m.sifra}/`;
    });
    const sel = fig.querySelector<HTMLSelectElement>('#ob-mera')!;
    const rv = fig.querySelector<HTMLElement>('.ob-raven')!;
    const rbtn = [...rv.querySelectorAll<HTMLButtonElement>('button')];
    const capFor = () => `${METRIC[metric].cap} ${metric === 't_semafor' ? (raven === 'regije' ? 'Regija: seštevek občin; klik odpre kartico regije.' : 'Klik odpre stran občine.') : capBase}`;
    const setMetric = (v: string) => { metric = v; sel.value = v; rv.hidden = v !== 't_semafor'; if (v !== 't_semafor') raven = 'obcine'; rbtn.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.r === raven))); cap.textContent = capFor(); mo.redraw(); };
    sel.addEventListener('change', () => setMetric(sel.value));
    rbtn.forEach((x) => x.addEventListener('click', () => { raven = x.dataset.r as 'obcine' | 'regije'; setMetric('t_semafor'); }));
    // ?kazalnik=t_semafor&raven=regije odpre zemljevid semaforja (povezava z naslovnice in kartic)
    const qs = new URLSearchParams(location.search);
    if (qs.get('raven') === 'regije') raven = 'regije';
    if (qs.get('kazalnik') && METRIC[qs.get('kazalnik')!]) setMetric(qs.get('kazalnik')!);
    cap.textContent = capFor();
  }

  const fig = document.getElementById('graf-obcine');
  if (fig) init(fig).catch((e) => console.error('graf občine:', e));
</script>
