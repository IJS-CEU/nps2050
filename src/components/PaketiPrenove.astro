---
/**
 * 11.4 Tipični paketi prenove: za izbrani tip stavbe in ogrevanje primerjava delne prenove, celovite prenove ovoja in sistemov in prenove do sNES.
 * Vse številke iz public/data/paketi_prenove.json (cevovod data/npsdata/paketi.py). Brez JavaScripta so prikazane vse različice.
 */
import { loadData } from '../lib/data';
import { nf } from '../lib/format';
import Icon from './Icon.astro';
import KALK from '../data/povracilne_dobe.json';

type Paket = { id: string; ime: string; ukrepi: string[]; eur_m2: number; eur_m2_p25: number | null; eur_m2_p75: number | null; n: number | null;
  vir_stroska: string; strosek: number; strosek_p25: number | null; strosek_p75: number | null; povrsina_stroska: number; razred_po: string; pe_po: number; prihranek_fe_pct: number; prihranek_pe_pct: number; prihranek_eur: number;
  stroski_pred_leto: number; spodbuda_eko_pct: number | null; spodbuda_eko_eur: number | null; spodbuda_eko_vir: string; eur_kwh_eko: number | null; eur_kwh_brez: number | null; eur_kwh_dod: number | null; cena_energije_pred: number; spodbuda_dod_pct: number; spodbuda_razlog: string | null; spodbuda_dod_eur: number; vracilo_brez: number | null; vracilo_dod: number | null };
type Var = { id: string; ogrevanje: string; razred_pred: string; pe_pred: number; fe_pred: number; paketi: Paket[] };
type Tip = { id: string; ime: string; tip: string; povrsina: number; povrsina_kataster: number; variante: Var[] };
const d = loadData<{ tipi: Tip[]; cene: Record<string, number>; predpostavke: Record<string, any> }>('paketi_prenove');
const CV: Record<string, string> = { A: 'A1', B: 'B1', C: 'C', D: 'D', E: 'E', F: 'F', G: 'G' };
const DARK = new Set(['B', 'C', 'D', 'E']);
const badge = (k: string) => `background:var(--cls-${CV[k]});color:${DARK.has(k) ? '#1B2622' : '#fff'}`;
const ICON: Record<string, string> = { delna: 'layers', celovita: 'house', zeb: 'sun' };
const OGR: Record<string, string> = { olje: 'Kurilno olje', plin: 'Zemeljski plin', les: 'Les (drva)', daljinsko: 'Daljinsko ogrevanje' };
const c = d.cene, p = d.predpostavke, K = KALK.bloki.qhnd_kwh_m2;
---
<div class="pk">
  <div class="pk-tabs js-only" role="group" aria-label="Tip stavbe">
    {d.tipi.map((t, i) => (
      <button type="button" data-t={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        <span class="pk-ti"><Icon name={t.tip === 'SFH' ? 'house' : 'building-2'} size={22} /></span>
        <span><b>{t.tip === 'SFH' ? 'Hiša' : 'Stanovanje v bloku'}</b><small>{t.ime.split(', ')[1]}</small></span>
      </button>
    ))}
  </div>
  {d.tipi.map((t) => (
    <section class="pk-t" data-t={t.id} aria-labelledby={`pk-${t.id}`}>
      <h2 id={`pk-${t.id}`}>{t.ime}</h2>
      {t.variante.length > 1 && (
        <div class="pk-og js-only" role="group" aria-label="Ogrevanje pred prenovo">
          <span>Ogrevanje pred prenovo:</span>
          {t.variante.map((v, i) => <button type="button" data-v={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>{OGR[v.id]}</button>)}
        </div>
      )}
      {t.variante.map((v) => (
        <div class="pk-v" data-v={v.id}>
          <h3 class="pk-vh">{OGR[v.id]}</h3>
          <p class="pk-pred"><span class="pk-b" style={badge(v.razred_pred)}>{v.razred_pred}</span>
            <span>Tipično stanje pred prenovo: razred {v.razred_pred} na izkaznici ({nf(v.pe_pred)} kWh/(m²·a) primarne energije), {t.tip === 'SFH' ? `hiša s ${nf(t.povrsina)} m²` : `stanovanje s ${nf(t.povrsina)} m²`} ogrevane površine. Stroški ogrevanja danes okoli <b>{nf(v.paketi[0].stroski_pred_leto)} € na leto</b>.</span></p>
          {t.tip === 'MFH' && !v.paketi.some((k) => k.id === 'delna') && <p class="pk-nd">Delne prenove za bloke iz tega obdobja ne prikazujemo: po energetskih izkaznicah izolacija fasade in nova okna potrebno toploto za ogrevanje zmanjšata le z okoli {nf(K['1981_2002'].neizoliran)} na {nf(K['1981_2002'].izoliran)} kWh/m², zato se sama po sebi ne povrneta v življenjski dobi. Smiselna je celovita prenova.</p>}
          <div class="pk-grid">
            {v.paketi.map((k) => (
              <article class={`pk-c ${k.id}`}>
                <h4><span class="pk-ic"><Icon name={ICON[k.id]} size={20} /></span>{k.ime}</h4>
                <ul class="pk-u">{k.ukrepi.map((u) => <li>{u}</li>)}</ul>
                <p class="pk-cost"><b>{k.strosek_p25 ? <>{nf(k.strosek_p25)}–{nf(k.strosek_p75)} €</> : <>okoli {nf(k.strosek)} €</>}</b><span>{k.strosek_p25 && <>mediana {nf(k.strosek)} € · </>}{nf(k.eur_m2)} €/m² × {nf(k.povrsina_stroska)} m² · priznani stroški, dejanski višji</span></p>
                <p class="pk-cls"><span class="pk-b" style={badge(v.razred_pred)}>{v.razred_pred}</span><Icon name="arrow-right" size={18} /><span class="pk-b" style={badge(k.razred_po)}>{k.razred_po}</span><span>{nf(k.pe_po)} kWh/(m²·a) primarne energije</span></p>
                <dl class="pk-d">
                  <div><dt>Manj končne energije</dt><dd>{nf(k.prihranek_fe_pct)} %</dd></div>
                  <div><dt>Manj primarne energije</dt><dd>{nf(k.prihranek_pe_pct)} %</dd></div>
                  <div><dt>Prihranek stroškov energije</dt><dd>okoli {nf(k.prihranek_eur)} € na leto</dd></div>
                  <div><dt>Spodbuda Eko sklada danes</dt><dd>{k.spodbuda_eko_pct === null ? '–' : <>{nf(k.spodbuda_eko_pct)} % (okoli {nf(k.spodbuda_eko_eur)} €)</>}<small>{k.spodbuda_eko_vir === 'poziv' ? (t.tip === 'SFH' ? 'po pozivu 126SUB-OB26' : 'po pozivih 124SUB-OBPO25 in 126SUB-OB26') : 'dejanski delež 2022–2025'}</small></dd></div>
                  <div><dt>Spodbuda po predlogu N1</dt><dd>{nf(k.spodbuda_dod_pct)} % (okoli {nf(k.spodbuda_dod_eur)} €){k.spodbuda_razlog && <small>{k.spodbuda_razlog}</small>}</dd></div>
                  <div class="pk-kwh"><dt>Strošek prihranjene kWh</dt><dd>{nf(k.eur_kwh_dod, 2)} €/kWh s spodbudo N1<small>{k.eur_kwh_eko !== null && <>s spodbudo Eko sklada danes {nf(k.eur_kwh_eko, 2)} €/kWh; </>}brez spodbude {nf(k.eur_kwh_brez, 2)} €/kWh; danes {v.id === 'daljinsko' ? 'toplota' : OGR[v.id].toLowerCase()} stane {nf(k.cena_energije_pred, 2)} €/kWh</small></dd></div>
                </dl>
                <p class="pk-src">Strošek: {k.vir_stroska}{k.n && <> ({nf(k.n)} {t.tip === 'SFH' ? 'hiš' : 'stavb'})</>}.</p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>
  ))}
  <p class="pk-warn"><strong>Pozor pri stroških.</strong> Zneski so priznani stroški naložb, ki jih je podprl Eko sklad. Dejanska naložba je višja: ne vključujejo projektiranja, del, ki niso upravičena do spodbude, potresne utrditve in prenove inštalacij. Celovita prenova ovoja in sistemov je seštevek posameznih ukrepov in ni prenova do skoraj nič-energijske stavbe (sNES); ta je prikazana posebej. Razpon je od četrtine najcenejših do četrtine najdražjih primerov.</p>
  <div class="pk-note">
    <p><strong>Tipične vrednosti, ne izračun za vašo stavbo.</strong> Dejanski strošek in prihranek sta odvisna od stanja stavbe, izvedbe in cen. Prenova prinese tudi koristi, ki niso v izračunu: udobje, zdravje, manj vlage, višjo vrednost nepremičnine in neodvisnost od cen goriv. Za vašo stavbo se posvetujte z energetskim svetovalcem ENSVET.</p>
    <details class="metoda">
    <summary>Kako je izračunano: stroški, raba energije, cene in spodbude</summary>
    <p>Stroški so priznani stroški naložb, ki jih je podprl Eko sklad (z DDV, nominalno). Delna prenova in celovita prenova ovoja in sistemov: stavbe, ki so v letih 2023–2025 izvedle več ukrepov hkrati, na m² ogrevane uporabne površine po katastru. Prenova do sNES: Eko skladovi ukrepi »celovita obnova stanovanjske stavbe« in »sNES+ prenova« 2022–2025 (večinoma hiše s 150–200 m²), na m² ogrevane površine iz vloge, za tipično hišo preračunano na površino iz izkaznice. Razred pred prenovo je mediana neprenovljenih stavb z računsko energetsko izkaznico. Stroški in prihranki energije temeljijo na <strong>dejanski rabi</strong> po modelu IJS CEU, usklajenem z energetsko bilanco: stavbe s slabim ovojem v resnici porabijo manj, kot kaže računska izkaznica, ker jih ogrevajo varčneje ali le delno. Pri stanovanjih v blokih je raba za ogrevanje ocenjena iz potrebne toplote po računskih energetskih izkaznicah, enako kot v kalkulatorju »Se mi splača?« na strani Za lastnike: v neizoliranem bloku, zgrajenem do leta 1980, okoli {nf(K.pred_1980.neizoliran)} kWh/m², po izolaciji fasade in zamenjavi oken okoli {nf(K.pred_1980.izoliran)} kWh/m² in po celoviti prenovi okoli {nf(K.pred_1980.celovita)} kWh/m², ter topla voda. Po celoviti prenovi ogreva toplotna črpalka (sezonsko grelno število {nf(p.scop, 1)}); pri prenovi do sNES sončna elektrarna pokrije okoli {nf(100 * p.pv_delez)} % rabe elektrike. Bloki ostanejo na daljinskem ogrevanju.</p>
    <p>Cene energije za gospodinjstva 2025: kurilno olje {nf(c.kurilno_olje, 3)} €/kWh, zemeljski plin {nf(c.plin, 3)} €/kWh, elektrika {nf(c.elektrika, 3)} €/kWh (SURS), drva {nf(c.les, 3)} €/kWh (Gozdarski inštitut Slovenije, oktober 2024), daljinska toplota {nf(c.daljinska_toplota, 3)} €/kWh (Agencija za energijo, povprečje za stanovanje v bloku). Strošek prihranjene kWh: naložba (brez oziroma s spodbudo), deljena s prihrankom kupljene energije v {nf(p.zivljenjska_doba)} letih, brez obresti; če je nižji od cene energije, ki jo prenova nadomesti, se prenova izplača. Spodbuda Eko sklada danes: pri delni in celoviti prenovi hiš po javnem pozivu 126SUB-OB26 – izolacija fasade, strehe in tal do 40 % (največ 35 €/m² izolacije), lesena okna do 40 % (največ 300 €/m² oken; za okna iz drugih materialov spodbude ni), toplotna črpalka zrak-voda ob zamenjavi stare kurilne naprave do 50 % (največ 4.500 €), centralno prezračevanje do 30 % (največ 2.500 €); količine po medianah naložb Eko sklada. Pri blokih po pozivu 124SUB-OBPO25 za skupne dele – izolacija fasade in strehe do 30 % upravičenih stroškov brez DDV (največ 50 €/m² izolacije) – ter po pozivu 126SUB-OB26 za lesena okna in lokalno prezračevanje v stanovanju. Prenove do sNES veljavna poziva ne zajemata, zato je tam prikazan dejanski delež spodbud v letih 2022–2025. Za prejemnike socialne pomoči so spodbude do 100 %. Spodbude po predlogu ukrepa N1 iz osnutka: 30 % osnovno, za razred E 40 %, za razreda F in G ter stavbe med 43 % energetsko najmanj učinkovitih 50 %, za celovito prenovo dodatnih 10 odstotnih točk, največ 70 %. Pri večstanovanjskih stavbah prenove do sNES ne prikazujemo, ker zanjo ni podatkov.</p>
    </details>
  </div>
</div>

<style>
  .pk-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .6rem; margin: 1rem 0 1.4rem; }
  @media (max-width: 760px) { .pk-tabs { grid-template-columns: 1fr 1fr; } }
  .pk-tabs button { font: inherit; display: flex; gap: .6rem; align-items: center; text-align: left; padding: .65rem .8rem; border-radius: 12px; border: 1px solid var(--line); background: var(--panel); color: var(--ink); cursor: pointer; }
  .pk-tabs button b { display: block; font-size: .95rem; }
  .pk-tabs button small { display: block; font-size: .78rem; color: var(--ink2); line-height: 1.25; }
  .pk-ti { flex: none; display: grid; place-items: center; width: 2.3rem; height: 2.3rem; border-radius: 8px; background: var(--greenbg); color: var(--green); }
  .pk-tabs button:hover { border-color: var(--green); }
  .pk-tabs button[aria-pressed='true'] { border-color: var(--green); box-shadow: inset 0 0 0 1px var(--green); background: var(--greenbg); }
  .pk-tabs button[aria-pressed='true'] .pk-ti { background: var(--green); color: var(--on-green); }
  .pk-t { margin: 0 0 2rem; }
  .pk-t h2 { margin: 0 0 .5rem; }
  .pk-og { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin: .2rem 0 .8rem; font-size: .85rem; color: var(--ink2); }
  .pk-og button { font: inherit; font-size: .82rem; font-weight: 700; padding: .3rem .8rem; border-radius: 999px; border: 1px solid var(--ink2); background: transparent; color: var(--ink2); cursor: pointer; }
  .pk-og button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--panel); }
  .pk-vh { font-size: 1rem; margin: .8rem 0 .3rem; }
  :global(.js) .pk-vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(.js) .pk-v:not([data-on]) { display: none; }
  :global(.js) .pk-t:not([data-on]) { display: none; }
  .pk-pred { display: flex; gap: .6rem; align-items: center; color: var(--ink2); max-width: none; }
  .pk-b { flex: none; display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 6px; font-weight: 800; font-size: 1.05rem; }
  .pk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 1rem; margin-top: 1rem; }
  .pk-c { background: var(--panel); border: 1px solid var(--line); border-top: 4px solid var(--green); border-radius: 14px; padding: 1.1rem 1.2rem; display: grid; gap: .6rem; align-content: start; }
  .pk-c.zeb { border-top-color: #0B7A45; }
  .pk-warn { background: var(--amberbg); border-left: 4px solid var(--amber); border-radius: 10px; padding: .7rem 1rem; font-size: .9rem; margin: 1.2rem 0; }
  .pk-c.delna { border-top-color: var(--line); }
  .pk-c.na { opacity: .75; border-top-color: var(--line); }
  .pk-c h4 { display: flex; align-items: center; gap: .5rem; margin: 0; font-size: 1.15rem; }
  .pk-ic { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border-radius: 8px; background: var(--greenbg); color: var(--green); }
  .pk-u { margin: 0; padding-left: 1.1rem; font-size: .88rem; color: var(--ink2); }
  .pk-cost { display: grid; margin: 0; }
  .pk-cost b { font-family: var(--font-serif); font-size: 1.7rem; line-height: 1.1; }
  .pk-cost span { font-size: .82rem; color: var(--ink2); }
  .pk-cls { display: flex; align-items: center; gap: .4rem; margin: 0; font-size: .82rem; color: var(--ink2); flex-wrap: wrap; }
  .pk-d { margin: 0; display: grid; gap: .25rem; }
  .pk-d div { display: flex; justify-content: space-between; gap: .8rem; border-bottom: 1px solid var(--line); padding: .3rem 0; font-size: .86rem; }
  .pk-d dt { color: var(--ink2); }
  .pk-d dd { margin: 0; font-weight: 700; text-align: right; }
  .pk-kwh dd { color: var(--green); }
  .pk-d dd small { display: block; font-weight: 500; color: var(--ink2); font-size: .76rem; }
  .pk-src { font-size: .76rem; color: var(--ink2); margin: 0; }
  .pk-note { font-size: .86rem; color: var(--ink2); border-top: 1px solid var(--line); padding-top: 1rem; }

  .pk-nd { font-size: .9rem; color: var(--ink2); margin: .2rem 0 .8rem; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.pk');
  if (root) {
    const secs = [...root.querySelectorAll<HTMLElement>('.pk-t')];
    const btns = [...root.querySelectorAll<HTMLButtonElement>('.pk-tabs button')];
    const url = new URL(location.href);
    const setV = (sec: HTMLElement, vid: string) => {
      sec.querySelectorAll<HTMLElement>('.pk-v').forEach((v) => (v.dataset.v === vid ? v.setAttribute('data-on', '') : v.removeAttribute('data-on')));
      sec.querySelectorAll<HTMLButtonElement>('.pk-og button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === vid)));
    };
    const show = (id: string) => {
      secs.forEach((s) => (s.dataset.t === id ? s.setAttribute('data-on', '') : s.removeAttribute('data-on')));
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.t === id)));
    };
    secs.forEach((sec) => {
      const vs = [...sec.querySelectorAll<HTMLElement>('.pk-v')].map((v) => v.dataset.v!);
      const want = url.searchParams.get('ogrevanje');
      setV(sec, want && vs.includes(want) ? want : vs[0]);
      sec.querySelectorAll<HTMLButtonElement>('.pk-og button').forEach((b) => b.addEventListener('click', () => { setV(sec, b.dataset.v!); const u = new URL(location.href); u.searchParams.set('ogrevanje', b.dataset.v!); history.replaceState(null, '', u); }));
    });
    const q = url.searchParams.get('tip');
    show(secs.some((s) => s.dataset.t === q) ? q! : secs[0].dataset.t!);
    btns.forEach((b) => b.addEventListener('click', () => { show(b.dataset.t!); const u = new URL(location.href); u.searchParams.set('tip', b.dataset.t!); history.replaceState(null, '', u); }));
  }
</script>
