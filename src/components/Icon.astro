---
/** Ikona Lucide (lucide-static, licenca ISC), vstavljena ob gradnji kot SVG z barvo currentColor. */
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props { name: string; size?: number; class?: string; stroke?: number }
const { name, size = 24, class: cls = '', stroke = 2 } = Astro.props;
const raw = readFileSync(resolve(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`), 'utf-8');
const svg = raw
  .replace(/<!--.*?-->\s*/s, '')
  .replace(/width="24"/, `width="${size}"`).replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace(/class="([^"]*)"/, `class="$1 ${cls}" aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
