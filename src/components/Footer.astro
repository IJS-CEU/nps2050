---
import { pageUrl, withBase } from '../i18n/routes';
import { ui as t } from '../i18n/ui';
import { features } from '../config/features';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { skupine } from '../lib/zemljevid-strani';

// Različica osnutka pride iz podatkovnega cevovoda (public/data/meta.json), ne iz besedila.
const publicDir = resolve(process.cwd(), 'public');
let draftDate: string | undefined;
const metaPath = resolve(publicDir, 'data/meta.json');
if (existsSync(metaPath)) {
  const meta = JSON.parse(readFileSync(metaPath, 'utf-8'));
  if (meta.draft_date) {
    // Slovenski zapis 22. 9. 2026 (Intl vrne imenovalnik »22. september«, kar ni pravilno).
    const [y, m, d] = String(meta.draft_date).split('-').map(Number);
    draftDate = `${d}. ${m}. ${y}`;
  }
}
// Izvirniki logotipov so v design/logos/; v public/logos/ so samo uporabljene različice.
---
<footer>
  <nav class="wrap fmap" aria-label="Zemljevid strani">
    {skupine().map((g) => (
      <div>
        <p class="fmap-t">{g.naslov}</p>
        <ul>{g.povezave.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}
  </nav>
  <div class="wrap foot">
    <div>
      <p>{t.footerBy}</p>
      {draftDate && <p class="ver">{t.footerVersion} {draftDate}.{features.dnevnik && <> <a href={pageUrl('dnevnik')}>Dnevnik sprememb</a></>}</p>}
      <p class="ver">Kontakt: <a href="mailto:ceu@ijs.si">{'ceu@ijs.si'}</a></p>
      <p class="ver">Besedilo in podatki: CC BY 4.0, z navedbo vira »IJS CEU, strokovne podlage NPS 2050«.</p>
    </div>
    <div class="logos">
      <img class="ijs" src={withBase('logos/ijs.png')} alt={t.logoIjs} width="173" height="28" />
      <img class="light-only" src={withBase('logos/mzie.svg')} alt={t.logoMin} width="268" height="28" />
      <img class="dark-only" src={withBase('logos/mzie-dark.svg')} alt={t.logoMin} width="268" height="28" />
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); padding-block: 2rem; font-size: .85rem; color: var(--ink2); margin-top: 2rem; }
  .fmap { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem 1.5rem; padding-bottom: 1.6rem; margin-bottom: 1.6rem; border-bottom: 1px solid var(--line); }
  .fmap-t { font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--ink); margin: 0 0 .4rem; }
  .fmap ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .2rem; }
  .fmap li { margin: 0; }
  .fmap a { color: var(--ink2); text-decoration: none; font-size: .85rem; }
  .fmap a:hover { color: var(--green); text-decoration: underline; }
  .foot { display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; }
  .foot p { max-width: 60ch; }
  .ver { font-size: .8rem; }
  .logos { display: flex; gap: 1rem 1.6rem; align-items: center; flex-wrap: wrap; }
  .logos img { height: 28px; width: auto; max-width: 100%; }
  .ijs { filter: var(--logo-filter); }
  .light-only { display: var(--show-light); }
  .dark-only { display: var(--show-dark); }
</style>
