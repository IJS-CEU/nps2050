---
/**
 * Graf 3: raziskovalnik scenarijev.
 * Zavihek »Scenarij NPS 2050« – absolutne vrednosti po sektorjih (pogl. 4.3–4.5);
 * zavihek »Primerjava S0–S2« – indeksi iz primerjave strategij (pogl. 4.1.1) in 5-letne serije modela RenRates.
 */
import ChartFigure from './ChartFigure.astro';
import Seg from './Seg.astro';
import { loadData, type Scenariji } from '../../lib/data';
import { nf } from '../../lib/format';

const d = loadData<Scenariji>('scenariji');
const n = d.nps;
const sectorName = Object.fromEntries(n.sectors.map((s) => [s.id, s.name]));
const IND: Record<string, string> = { koncna_energija: 'Končna energija', primarna_energija: 'Primarna energija', emisije: 'Emisije TGP', ove: 'Delež OVE' };
const p = d.primerjava;
const fe = n.indicators.koncna_energija.values.skupaj;
---
<ChartFigure
  id="graf-scenariji"
  title="Raziskovalnik scenarijev"
  subtitle="Scenarij NPS 2050 po sektorjih in primerjava strategij spodbujanja prenov S0–S2"
  file="nps2050-scenariji"
  csv={[{ file: 'scenariji_nps.csv', label: 'CSV (NPS 2050)' }, { file: 'scenariji_primerjava.csv', label: 'CSV (S0–S2)' }]}
  ariaLabel={`Po scenariju NPS 2050 se končna raba energije v stavbah zmanjša s ${nf(fe[0])} ktoe leta ${n.years[0]} na ${nf(fe[fe.length - 1])} ktoe leta ${n.years[n.years.length - 1]}. Primerjava strategij S0–S2 v indeksih je v preglednici.`}
  height={380}
>
  <Fragment slot="controls">
    <Seg name="sc-tab" legend="Pogled" options={[{ value: 'nps', label: 'Scenarij NPS 2050' }, { value: 'cmp', label: 'Primerjava S0–S2' }]} />
    <span data-tab="nps"><Seg name="sc-ind" legend="Kazalnik" options={Object.entries(IND).map(([value, label]) => ({ value, label }))} /></span>
    <span data-tab="cmp" hidden><Seg name="sc-ser" legend="Kazalnik" options={[
      { value: 'fe_index', label: 'Končna energija' },
      { value: 'pe_res_fixed_index', label: 'Primarna energija stanovanjskih stavb' },
      { value: 'worst_fg_share_pct', label: 'Delež razredov F in G' },
    ]} /></span>
  </Fragment>
  <Fragment slot="caption">
    <p data-tab="nps">Scenarij NPS 2050 v obsegu EPBD. Primarna energija pri faktorjih, veljavnih v posameznem letu. Emisije vključujejo posredne emisije iz elektrike in daljinske toplote.</p>
    <p data-tab="cmp" hidden>Primerjava strategij spodbujanja prenov s stavbnim modelom RenRates: S0 – nadaljevanje sedanje prakse, S1 – ciljna celovita energetska prenova, S2 – scenarij NPS 2050. Indeksi (2025 = 100), ker ima model drugačne absolutne vrednosti kot projekcija NPS 2050. Primarna energija stanovanjskih stavb je pri fiksnih faktorjih 2025.</p>
    <p>Vir: osnutek NPS 2050, poglavja 4.1.1, 4.3, 4.4 in 4.5; model RenRates_SI.</p>
  </Fragment>
  <Fragment slot="table">
    {Object.entries(n.indicators).map(([key, ind]) => (
      <table>
        <caption style="text-align:left;font-weight:700">{IND[key]} [{ind.unit}], scenarij NPS 2050</caption>
        <thead><tr><th scope="col">Sektor</th>{n.years.map((y) => <th scope="col" class="num">{y}</th>)}</tr></thead>
        <tbody>
          {ind.sectors.map((sid) => (
            <tr><th scope="row">{sectorName[sid]}</th>{ind.values[sid].map((v) => <td class="num">{nf(v)}</td>)}</tr>
          ))}
        </tbody>
      </table>
    ))}
    <table>
      <caption style="text-align:left;font-weight:700">Primerjava strategij S0–S2 (model RenRates)</caption>
      <thead><tr><th scope="col">Kazalnik</th><th scope="col">Enota</th>{p.scenarios.map((s) => <th scope="col" class="num">{s.id}</th>)}</tr></thead>
      <tbody>
        {p.table.map((r) => (
          <tr><th scope="row">{r.label}</th><td>{r.unit}</td>{p.scenarios.map((s) => <td class="num">{r.values[s.id]}</td>)}</tr>
        ))}
      </tbody>
    </table>
    <table>
      <caption style="text-align:left;font-weight:700">5-letne serije S0–S2 (model RenRates)</caption>
      <thead><tr><th scope="col">Serija</th><th scope="col">Scenarij</th>{p.pe_res_fixed_index.years.map((y) => <th scope="col" class="num">{y}</th>)}</tr></thead>
      <tbody>
        {([['pe_res_fixed_index', 'Primarna energija stanovanjskih stavb, fiksni faktorji (2025 = 100)'], ['worst_fg_share_pct', 'Delež površine v razredih F in G [%]']] as const).flatMap(([k, label]) =>
          p.scenarios.map((s) => (
            <tr><th scope="row">{label}</th><td>{s.id}</td>{p[k][s.id].map((v) => <td class="num">{nf(v, 1)}</td>)}</tr>
          )))}
      </tbody>
    </table>
  </Fragment>
</ChartFigure>

<script>
  import { base, choice, loadJson, mount, nf, tipRow, tipTitle, valueAxis, yearAxis, type Tokens } from '../../scripts/charts/core';
  import type { Scenariji, Scen } from '../../lib/data';

  const SECTOR_COLOR: Record<string, string> = {
    enodruzinske: 'enodruzinske', vecstanovanjske: 'vecstanovanjske', javne: 'javne', zasebne: 'zasebne',
    stanovanjski: 'enodruzinske', storitveni: 'javne',
  };
  const UNIT: Record<string, string> = { koncna_energija: 'ktoe', primarna_energija: 'ktoe', emisije: 'kt CO₂ ekv', ove: '%' };
  const SCEN_SYMBOL: Record<Scen, string> = { S0: 'triangle', S1: 'diamond', S2: 'circle' };
  const SERIES: Record<string, { name: string; unit: string; dec: number }> = {
    fe_index: { name: 'Končna energija, 2025 = 100', unit: '', dec: 0 },
    pe_res_fixed_index: { name: 'Primarna energija stanovanjskih stavb (fiksni faktorji), 2025 = 100', unit: '', dec: 1 },
    worst_fg_share_pct: { name: 'Delež površine v razredih F in G', unit: ' %', dec: 1 },
  };

  async function init(fig: HTMLElement) {
    const d = await loadJson<Scenariji>('scenariji');
    const n = d.nps, p = d.primerjava;
    const sectorName = Object.fromEntries(n.sectors.map((s) => [s.id, s.name]));
    let tab = 'nps', ind = 'koncna_energija', ser = 'fe_index';

    const npsOption = (t: Tokens) => {
      const o = base(t) as Record<string, any>;
      const I = n.indicators[ind];
      const unit = UNIT[ind];
      const years = n.years.map(String);
      // Deli brez »skupaj« (4 sektorji ali 2 sektorja); pri OVE (delež) se ne sešteva – ločene črte.
      const parts = I.sectors.filter((s) => s !== 'skupaj' && !(I.sectors.length === 7 && (s === 'stanovanjski' || s === 'storitveni')));
      const total = I.values.skupaj;
      const tip = (idx: number) => tipTitle(years[idx]) + parts.map((s) => tipRow(t.s[SECTOR_COLOR[s]], sectorName[s], `${nf(I.values[s][idx])} ${unit}`, ind === 'ove' ? 'line' : 'rect')).join('')
        + tipRow(t.ink, 'Stavbe skupaj', `${nf(total[idx])} ${unit}`, ind === 'ove' ? 'line' : 'rect');
      if (ind === 'ove') {
        const dot = (c: string) => ({ color: c, borderColor: t.panel, borderWidth: 2 });
        // Črte se leta 2050 zbližajo (76–78 %), zato brez napisov ob koncu – vrednosti so v opisu in preglednici.
        const line = (name: string, color: string, vals: number[], width = 2) => ({
          name, type: 'line', data: vals, color, lineStyle: { width }, symbol: 'circle', symbolSize: 8, itemStyle: dot(color),
        });
        return {
          ...o,
          legend: { ...o.legend, data: [...parts.map((s) => sectorName[s]), 'Stavbe skupaj'] },
          tooltip: { ...o.tooltip, trigger: 'axis', axisPointer: { type: 'line', lineStyle: { color: t.axis } }, formatter: (ps: any[]) => tip(ps[0].dataIndex) },
          xAxis: yearAxis(t, { type: 'category', data: years, boundaryGap: false }),
          yAxis: valueAxis(t, { min: 0, max: 100, name: '%' }),
          series: [...parts.map((s) => line(sectorName[s], t.s[SECTOR_COLOR[s]], I.values[s])), line('Stavbe skupaj', t.ink, total)],
        };
      }
      return {
        ...o,
        legend: { ...o.legend, data: parts.map((s) => sectorName[s]) },
        tooltip: { ...o.tooltip, trigger: 'axis', axisPointer: { type: 'shadow', shadowStyle: { color: t.grid, opacity: 0.5 } }, formatter: (ps: any[]) => tip(ps[0].dataIndex) },
        xAxis: yearAxis(t, { type: 'category', data: years }),
        yAxis: valueAxis(t, { min: 0, name: unit }),
        series: parts.map((s, i) => ({
          name: sectorName[s], type: 'bar', stack: 'nps', barMaxWidth: 24, color: t.s[SECTOR_COLOR[s]],
          itemStyle: { borderColor: t.panel, borderWidth: 1, borderRadius: i === parts.length - 1 ? [4, 4, 0, 0] : 0 },
          data: I.values[s],
          // Skupna vrednost na vrhu stolpca (samo na zadnjem delu sklada).
          label: i === parts.length - 1 ? { show: true, position: 'top', color: t.ink, fontWeight: 700, fontSize: 11, formatter: (q: any) => nf(total[q.dataIndex]) } : { show: false },
        })),
      };
    };

    const cmpOption = (t: Tokens) => {
      const o = base(t) as Record<string, any>;
      const S = p[ser as 'fe_index'];
      const meta = SERIES[ser];
      const years = S.years.map(String);
      const scen = p.scenarios;
      return {
        ...o, grid: { ...o.grid, right: t.narrow ? 56 : 120 },
        legend: { ...o.legend, data: scen.map((s) => s.name) },
        tooltip: {
          ...o.tooltip, trigger: 'axis', axisPointer: { type: 'line', lineStyle: { color: t.axis } },
          formatter: (ps: any[]) => tipTitle(years[ps[0].dataIndex]) + scen.map((s) => tipRow(t.s[s.id.toLowerCase()], s.name, nf(S[s.id][ps[0].dataIndex], meta.dec) + meta.unit)).join(''),
        },
        xAxis: yearAxis(t, { type: 'category', data: years, boundaryGap: false }),
        yAxis: valueAxis(t, { min: 0, name: ser === 'worst_fg_share_pct' ? '%' : '2025 = 100' }),
        series: scen.map((s) => {
          const c = t.s[s.id.toLowerCase()];
          return {
            name: s.name, type: 'line', data: S[s.id], color: c, lineStyle: { width: 2 },
            symbol: SCEN_SYMBOL[s.id], symbolSize: s.id === 'S1' ? 11 : 9, itemStyle: { color: c, borderColor: t.panel, borderWidth: 2 },
            z: s.id === 'S2' ? 4 : 3,
            // Oznaka na koncu črte: ime scenarija (sekundarno kodiranje poleg barve in oblike točke).
            endLabel: { show: true, distance: 8, color: t.ink2, fontSize: 11, formatter: (q: any) => `${s.id} ${nf(q.value, meta.dec)}${meta.unit}` },
            labelLayout: { moveOverlap: 'shiftY' },
          };
        }),
      };
    };

    const m = mount(fig, (t) => (tab === 'nps' ? npsOption(t) : cmpOption(t)));
    choice(fig, 'sc-tab', (v) => {
      tab = v;
      fig.querySelectorAll<HTMLElement>('[data-tab]').forEach((e) => (e.hidden = e.dataset.tab !== v));
      m.redraw();
    });
    choice(fig, 'sc-ind', (v) => { ind = v; m.redraw(); });
    choice(fig, 'sc-ser', (v) => { ser = v; m.redraw(); });
  }

  const fig = document.getElementById('graf-scenariji');
  if (fig) init(fig).catch((e) => console.error('graf scenariji:', e));
</script>
