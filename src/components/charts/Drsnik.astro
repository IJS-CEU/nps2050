---
/**
 * 11.3 »Kaj pa, če« drsnik na trajektoriji: štirje zagoni modela RenRates z različno stopnjo prenove stanovanjskih stavb.
 * Krivulje: ocenjeno stanje 2025 (registri 2020–2025 in energetska bilanca s popravkom za vreme) × indeks iz modela; pas = razpon ocene 2025.
 * Podatki: public/data/drsnik.json (cevovod data/npsdata/drsnik.py). Graf je statični SVG; drsnik izbere krivuljo in stavek.
 * Brez JavaScripta so vidne vse krivulje in preglednica.
 */
import { withBase } from '../../i18n/routes';
import { loadData } from '../../lib/data';
import { nf } from '../../lib/format';

type Poz = { id: string; faktor: number; stopnja_dosezena_pct: number; stopnja_vpisana_2026_2030_pct: Record<string, number>; kwh_m2: number[]; kwh_m2_spodnja: number[]; kwh_m2_zgornja: number[];
  zmanjsanje_2030_pct: number; zmanjsanje_2035_pct: number; fe_zmanjsanje_2050_pct: number; epbd_2030: boolean; epbd_2035: boolean;
  fg_pct: number[]; zmanjsanje_2050_pct: Record<'fe' | 'pe' | 'co2', number>; nalozbe_mrd: number; nalozbe_2026_2030_mrd: number; javna_mrd: number;
  stopnja_2026_2030_pct: number; celovito_2026_2030_pct: number; hise_2026_2030_pct: number[]; bloki_2026_2030_pct: number[]; stopnje_obdobja_pct: number[] };
const d = loadData<{ years: number[]; nps: (number | null)[]; epbd_max: { year: number; max: number; min: number }[]; privzeto: string; polozaji: Poz[];
  ocena_2025: Record<string, number>; viri_2025: { registri: number[]; bilanca: number }; referenca: Poz & { ime: string } }>('drsnik');
const s0 = d.referenca;
const lab = (p: Poz) => `${nf(p.stopnja_2026_2030_pct, 1)} %`;
const W = 640, H = 300, L = 46, R = 16, T = 16, B = 30;
const y0 = 120, y1 = 280;
const xs = (y: number) => L + ((y - 2020) / 30) * (W - L - R);
const ys = (v: number) => T + (1 - (v - y0) / (y1 - y0)) * (H - T - B);
const pts = (vals: (number | null)[]) => vals.map((v, i) => [d.years[i], v] as const).filter(([, v]) => v !== null) as [number, number][];
const path = (vals: (number | null)[]) => pts(vals).map(([y, v], i) => `${i ? 'L' : 'M'}${xs(y).toFixed(1)},${ys(v).toFixed(1)}`).join(' ');
const band = (lo: number[], hi: number[]) => {
  const a = pts(hi).slice(1), b = pts(lo).slice(1).reverse();
  return [...a, ...b].map(([y, v], i) => `${i ? 'L' : 'M'}${xs(y).toFixed(1)},${ys(v).toFixed(1)}`).join(' ') + ' Z';
};
const def = d.polozaji.findIndex((p) => p.id === d.privzeto);
const e30 = d.epbd_max.find((e) => e.year === 2030)!, e35 = d.epbd_max.find((e) => e.year === 2035)!;
const ix = (y: number) => d.years.indexOf(y);
const ocena = (ok: boolean, lo: number, hi: number, max: number) =>
  ok ? (hi <= max ? 'izpolnjeno' : 'izpolnjeno, a na robu negotovosti') : (lo <= max ? 'ni izpolnjeno, a na robu negotovosti' : 'ni izpolnjeno');
const stavek = (p: Poz) => {
  const [v30, v35, v50] = [2030, 2035, 2050].map((y) => p.kwh_m2[ix(y)]);
  const lo = (y: number) => p.kwh_m2_spodnja[ix(y)], hi = (y: number) => p.kwh_m2_zgornja[ix(y)];
  return `Pri stopnji prenove stanovanjskih stavb ${nf(p.stopnja_2026_2030_pct, 1)} % površine na leto v letih 2026–2030 (od tega ${nf(p.celovito_2026_2030_pct, 1)} % celovito; hiše ${nf(p.hise_2026_2030_pct[0], 1)} %, bloki ${nf(p.bloki_2026_2030_pct[0], 1)} %) je povprečje leta 2030 okoli ${nf(v30)} kWh/(m²·a) (razpon ${nf(lo(2030))}–${nf(hi(2030))}; najvišja vrednost po EPBD ${nf(e30.max)}: ${ocena(p.epbd_2030, lo(2030), hi(2030), e30.max)}), leta 2035 okoli ${nf(v35)} (EPBD ${nf(e35.min)}–${nf(e35.max)}: ${ocena(p.epbd_2035, lo(2035), hi(2035), e35.max)}) in leta 2050 okoli ${nf(v50)} kWh/(m²·a).`;
};
const FGY = [2030, 2035, 2050], FGMAX = [7, 5, 2];
const FG_YEARS = [2025, 2030, 2035, 2040, 2045, 2050];
const fg = (p: Poz, y: number) => p.fg_pct[FG_YEARS.indexOf(y)];
type Row = { h: string; cell: (p: Poz) => string; ok?: (p: Poz) => boolean };
const rows: Row[] = [
  { h: `EPBD, stanovanjske stavbe 2030: največ ${nf(e30.max)} kWh/(m²·a) (−16 % glede na 2020)`, cell: (p) => `${nf(p.kwh_m2[ix(2030)])} (−${nf(p.zmanjsanje_2030_pct, 1)} %)`, ok: (p) => p.epbd_2030 },
  { h: `EPBD, stanovanjske stavbe 2035: največ ${nf(e35.max)} kWh/(m²·a) (−20 do −22 %)`, cell: (p) => `${nf(p.kwh_m2[ix(2035)])} (−${nf(p.zmanjsanje_2035_pct, 1)} %)`, ok: (p) => p.epbd_2035 },
  { h: 'Delež površine v najslabših razredih F in G: največ 7 / 5 / 2 % (2030 / 2035 / 2050)', cell: (p) => FGY.map((y) => nf(fg(p, y), 1)).join(' / ') + ' %', ok: (p) => FGY.every((y, i) => fg(p, y) <= FGMAX[i]) },
  { h: 'Končna energija vseh stavb 2050: najmanj −30 % glede na 2025', cell: (p) => `−${nf(p.zmanjsanje_2050_pct.fe, 0)} %`, ok: (p) => p.zmanjsanje_2050_pct.fe >= 30 },
  { h: 'Primarna energija vseh stavb 2050: najmanj −34 % glede na 2025', cell: (p) => `−${nf(p.zmanjsanje_2050_pct.pe, 0)} %`, ok: (p) => p.zmanjsanje_2050_pct.pe >= 34 },
  { h: 'Emisije TGP iz stavb 2050: −90 % glede na 2025 *', cell: (p) => `−${nf(p.zmanjsanje_2050_pct.co2, 0)} %`, ok: (p) => p.zmanjsanje_2050_pct.co2 >= 90 },
  { h: 'Naložbe 2026–2050 (od tega 2026–2030), mrd €', cell: (p) => `${nf(p.nalozbe_mrd, 1)} (${nf(p.nalozbe_2026_2030_mrd, 1)})` },
  { h: 'Javna nepovratna sredstva 2026–2050, mrd €', cell: (p) => nf(p.javna_mrd, 2) },
];
const npsDrop = (y: number) => nf(100 * (1 - (d.nps[ix(y)] as number) / (d.nps[0] as number)), 0);
---
<figure class="drs" id="drsnik" data-def={def}>
  <figcaption>
    <b>Kaj pa, če se stanovanjske stavbe prenavljajo hitreje ali počasneje?</b>
    <span>Povprečna primarna energija stanovanjskih stavb, kWh/(m²·a), od ocenjenega stanja leta 2025 naprej; štirje zagoni modela RenRates, ki se razlikujejo samo v stopnji prenove hiš in blokov</span>
  </figcaption>
  <p class="drs-bau"><b>Danes:</b> prenovi se okoli {nf(s0.stopnja_2026_2030_pct, 1)} % stanovanjske površine na leto, a le {nf(s0.celovito_2026_2030_pct, 1)} % celovito (sedanja praksa, S0). <b>Za mejnik EPBD 2030:</b> okoli {nf(d.polozaji.find((p) => p.epbd_2030)!.stopnja_2026_2030_pct, 0)} % na leto, od tega {nf(d.polozaji.find((p) => p.epbd_2030)!.celovito_2026_2030_pct, 1)} % celovito.</p>
  <div class="drs-ctl js-only">
    <label for="drs-r">Stopnja prenove stanovanjskih stavb 2026–2030 (% površine na leto)</label>
    <input id="drs-r" type="range" min="0" max={d.polozaji.length - 1} step="1" value={def} list="drs-ticks" aria-describedby="drs-txt" aria-valuetext={`${lab(d.polozaji[def])} na leto, od tega ${nf(d.polozaji[def].celovito_2026_2030_pct, 1)} % celovito`} />
    <datalist id="drs-ticks">{d.polozaji.map((_, i) => <option value={i}></option>)}</datalist>
    <ol class="drs-lab" aria-hidden="true">{d.polozaji.map((p) => <li>{lab(p)}<small>od tega {nf(p.celovito_2026_2030_pct, 1)} % celovito{p.id === d.privzeto && <><br />scenarij NPS</>}</small></li>)}</ol>
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Povprečna primarna energija stanovanjskih stavb pri štirih stopnjah prenove, z razponom ocene stanja leta 2025; vrednosti so v preglednici pod grafom.">
    {[140, 180, 220, 260].map((v) => <g><line x1={L} x2={W - R} y1={ys(v)} y2={ys(v)} class="gl" /><text x={L - 6} y={ys(v) + 4} text-anchor="end" class="ax">{v}</text></g>)}
    {d.years.filter((y) => y % 10 === 0).map((y) => <text x={xs(y)} y={H - 8} text-anchor="middle" class="ax">{y}</text>)}
    {d.polozaji.map((p, i) => <path d={band(p.kwh_m2_spodnja, p.kwh_m2_zgornja)} class={`bd${i === def ? ' on' : ''}`} data-i={i} />)}
    <path d={path(d.nps)} class="nps" />
    <path d={path(s0.kwh_m2)} class="ref" /><text x={xs(2050) - 4} y={ys(s0.kwh_m2.at(-1)!) + 16} text-anchor="end" class="reft">sedanja praksa (S0)</text>
    {d.polozaji.map((p, i) => <path d={path(p.kwh_m2)} class={`ln${i === def ? ' on' : ''}${p.epbd_2030 && p.epbd_2035 ? '' : ' short'}`} data-i={i} />)}
    {[e30, e35].map((e) => <g class="epbd"><line x1={xs(e.year) - 10} x2={xs(e.year) + 10} y1={ys(e.max)} y2={ys(e.max)} /><text x={xs(e.year)} y={ys(e.max) - 8} text-anchor="middle">EPBD {e.year}</text></g>)}
    {d.polozaji.map((p, i) => <g class={`pt${i === def ? ' on' : ''}${p.epbd_2030 && p.epbd_2035 ? '' : ' short'}`} data-i={i}>{p.kwh_m2.map((v, j) => d.years[j] >= 2025 && <circle cx={xs(d.years[j])} cy={ys(v)} r="3.5" />)}</g>)}
  </svg>
  <ul class="drs-leg">
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="0" y1="5" x2="24" y2="5" class="lg-on" /></svg>izbrana stopnja: mejnika EPBD dosežena</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="0" y1="5" x2="24" y2="5" class="lg-short" /></svg>izbrana stopnja: mejnik ni dosežen</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><rect x="0" y="1" width="24" height="8" class="lg-bd" /></svg>razpon ocene stanja 2025</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="1" y1="5" x2="23" y2="5" class="lg-ref" /></svg>sedanja praksa (S0)</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="0" y1="5" x2="24" y2="5" class="lg-nps" /></svg>trajektorija v osnutku NPS 2050</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="6" y1="5" x2="18" y2="5" class="lg-epbd" /></svg>najvišja vrednost po EPBD</li>
    <li><svg viewBox="0 0 24 10" aria-hidden="true"><line x1="0" y1="5" x2="24" y2="5" class="lg-oth" /></svg>druge stopnje</li>
  </ul>
  <p class="drs-txt" id="drs-txt" aria-live="polite">{stavek(d.polozaji[def])}</p>
  <div class="tblwrap drs-cilji" tabindex="0" role="region" aria-label="Skladnost s cilji pri različnih stopnjah prenove">
    <table>
      <caption>Skladnost s cilji pri različnih stopnjah prenove</caption>
      <thead><tr><th scope="col">Cilj</th><th scope="col" class="num ref">{lab(s0)}<small>{nf(s0.celovito_2026_2030_pct, 1)} % celovito<br />sedanja praksa</small></th>{d.polozaji.map((p, i) => <th scope="col" class={`num${i === def ? ' on' : ''}`} data-i={i}>{lab(p)}<small>{nf(p.celovito_2026_2030_pct, 1)} % celovito{p.id === d.privzeto && <><br />scenarij NPS</>}</small></th>)}</tr></thead>
      <tbody>{rows.map((r) => <tr><th scope="row">{r.h}</th><td class={`num ref${r.ok ? (r.ok(s0) ? ' da' : ' ne') : ''}`}>{r.cell(s0)}{r.ok && <span class="mk">{r.ok(s0) ? ' ✓' : ' ✗'}</span>}</td>{d.polozaji.map((p, i) => <td class={`num${i === def ? ' on' : ''}${r.ok ? (r.ok(p) ? ' da' : ' ne') : ''}`} data-i={i}>{r.cell(p)}{r.ok && <span class="mk">{r.ok(p) ? ' ✓' : ' ✗'}</span>}</td>)}</tr>)}</tbody>
    </table>
    <p class="note">EPBD za stanovanjske stavbe: od ocenjenega stanja 2025 ({nf(d.ocena_2025.osrednja)} kWh/(m²·a)); drugi cilji so iz modela RenRates (vse stavbe, glede na leto 2025). Mejniki za razreda F in G so predlog NPS 2050. * Model ne vsebuje ločenega opuščanja kotlov na fosilna goriva (NPS, poglavje 6), zato cilja za emisije v modelu ne doseže noben položaj; doseže se z dodatnimi ukrepi in razogljičenjem oskrbe.</p>
  </div>
  <template id="drs-stavki">{d.polozaji.map((p) => <p>{stavek(p)}</p>)}</template>
  <details>
    <summary>Vrednosti v preglednici in metoda</summary>
    <div class="tblwrap" tabindex="0" role="region" aria-label="Vrednosti drsnika">
      <table>
        <thead><tr><th scope="col">Stopnja 2026–2030 (od tega celovito)</th><th scope="col">Hiše / bloki 2026–2030</th><th scope="col" class="num">Povprečje 2026–2050</th>{d.years.filter((y) => y >= 2025).map((y) => <th scope="col" class="num">{y}</th>)}<th scope="col" class="num">2030 glede na 2020</th><th scope="col" class="num">2035 glede na 2020</th></tr></thead>
        <tbody>
          <tr><th scope="row">Trajektorija v osnutku NPS 2050</th><td></td><td></td>{d.nps.slice(1).map((v) => <td class="num">{v === null ? '–' : nf(v)}</td>)}<td class="num">−{npsDrop(2030)} %</td><td class="num">−{npsDrop(2035)} %</td></tr>
          {[s0, ...d.polozaji].map((p) => <tr><th scope="row">{lab(p)} ({nf(p.celovito_2026_2030_pct, 1)} %){p.id === d.privzeto && ' – scenarij NPS'}{p.id === 'S0' && ' – sedanja praksa'}</th><td>{nf(p.hise_2026_2030_pct[0], 1)} / {nf(p.bloki_2026_2030_pct[0], 1)} %</td><td class="num">{nf(p.stopnja_dosezena_pct, 2)} %</td>{p.kwh_m2.slice(1).map((v) => <td class="num">{nf(v)}</td>)}<td class="num">−{nf(p.zmanjsanje_2030_pct, 1)} %</td><td class="num">−{nf(p.zmanjsanje_2035_pct, 1)} %</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="note"><b>Izhodišče in stanje 2025.</b> EPBD (člen 9(2)) zahteva, da se povprečje stanovanjskih stavb glede na leto 2020 (269 kWh/(m²·a) iz računskih izkaznic) zmanjša za najmanj 16 % do 2030 in za 20 do 22 % do 2035. Model RenRates se začne leta 2025, zato je stanje 2025 ocenjeno iz podatkov: (1) iz registrov – ukrepi v stanovanjskih stavbah v letih 2020–2025 (obnova fasade, strehe in oken v katastru, ukrepi Eko sklada za ovoj, okna, toplotne črpalke in kotle na biomaso), ovrednoteni z izkaznicami podobnih stavb in skupaj z novogradnjami: {nf(d.viri_2025.registri[0])}–{nf(d.viri_2025.registri[1])} kWh/(m²·a); (2) iz energetske bilance – primarna raba stanovanjskih stavb v letih 2020 in 2023 (NEPN 2024, izhodiščna preglednica osnutka), popravljena za vreme (stopinjski dnevi, Eurostat) in za rast površine (NEPN 2020 in 2024), do 2025 nadaljevana s tempom sedanje prakse: okoli {nf(d.viri_2025.bilanca)}. Krivulje so izračunane od {nf(d.ocena_2025.osrednja)} kWh/(m²·a), pas od {nf(d.ocena_2025.spodnja)} do {nf(d.ocena_2025.zgornja)}. Registri ne zajamejo prenov brez spodbude in brez vpisa v kataster, zato je ocena iz registrov prej previdna. Stanje bo preverjeno z vzorcem izkaznic leta 2028.</p>
    <p class="note"><b>Stopnja prenove</b> je prenovljena stanovanjska površina (delna, celovita in celovita s potresno utrditvijo) na leto, deljena s površino hiš in blokov skupaj (tehtano s površino); ločeno za hiše in bloke je v preglednici. Celovita prenova pomeni prenovo ovoja in sistemov do razreda toplotnih potreb A ali B. Sedanja praksa (S0) je zagon modela z opazovanimi stopnjami 2019–2023 in pretežno posameznimi ukrepi.</p>
    <p class="note"><b>Model.</b> RenRates, usklajen z NEPN 2024 (3. 10. 2026). Spreminjajo se samo stopnje prenove enostanovanjskih in večstanovanjskih stavb; globina prenove in usmerjanje v najslabše stavbe ostaneta kot v scenariju NPS 2050. Model prenavlja le stavbe razredov C–G po toplotnih potrebah, zato je dosežena stopnja nižja od vpisane in se pri visokih stopnjah ustavi: podvojitev vpisanih stopenj poveča povprečno stopnjo 2026–2050 le z {nf(d.polozaji.find((p) => p.faktor === 1)!.stopnja_dosezena_pct, 2)} na {nf(d.polozaji.at(-1)!.stopnja_dosezena_pct, 2)} % na leto. Primarna energija pri fiksnih faktorjih. <a href={withBase('data/csv/drsnik.csv')} download>Prenesi CSV</a></p>
  </details>
</figure>

<style>
  .drs { margin: 1.5rem 0 2rem; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1rem 1.2rem; }
  .drs figcaption { display: grid; gap: .2rem; margin-bottom: .6rem; }
  .drs figcaption span { font-size: .85rem; color: var(--ink2); }
  .drs-ctl { display: grid; gap: .3rem; margin: .4rem 0 .6rem; }
  .drs-ctl label { font-size: .85rem; font-weight: 700; }
  .drs-ctl input { width: 100%; accent-color: var(--green); }
  .drs-lab { list-style: none; padding: 0; margin: 0; display: flex; justify-content: space-between; font-size: .8rem; font-weight: 700; max-width: none; }
  .drs-lab li { display: grid; justify-items: center; }
  .drs-lab li:first-child { justify-items: start; } .drs-lab li:last-child { justify-items: end; }
  .drs-lab small { font-weight: 500; color: var(--ink2); text-align: center; }
  .drs-lab li:first-child small { text-align: left; } .drs-lab li:last-child small { text-align: right; }
  .drs svg { width: 100%; height: auto; display: block; }
  .drs .gl { stroke: var(--line); }
  .drs .ax { font-size: 11px; fill: var(--ink2); }
  .drs .nps { fill: none; stroke: var(--ink2); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .drs .ln { fill: none; stroke: var(--ink2); stroke-width: 1.2; opacity: .3; }
  .drs .ln.on { stroke: var(--green); stroke-width: 3; opacity: 1; }
  .drs .ln.short.on { stroke: var(--amber); }
  .drs .bd { display: none; fill: var(--green); opacity: .15; }
  .drs .bd.on { display: inline; }
  .drs .pt { display: none; fill: var(--green); }
  .drs .pt.on { display: inline; }
  .drs .pt.short { fill: var(--amber); }
  .drs .epbd line { stroke: var(--ink); stroke-width: 3; }
  .drs .epbd text { font-size: 11px; fill: var(--ink); font-weight: 700; }
  .drs-txt { font-size: .95rem; margin: .6rem 0; max-width: none; }
  .drs-leg { list-style: none; padding: 0; margin: .5rem 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .25rem 1.2rem; font-size: .8rem; color: var(--ink2); }
  .drs-leg li { display: flex; align-items: center; gap: .45rem; margin: 0; }
  .drs-leg svg { flex: none; width: 24px; height: 10px; overflow: visible; }
  .drs-leg .lg-on { stroke: var(--green); stroke-width: 3; }
  .drs-leg .lg-short { stroke: var(--amber); stroke-width: 3; }
  .drs-leg .lg-bd { fill: var(--green); opacity: .2; }
  .drs-leg .lg-ref { stroke: var(--ink2); stroke-width: 2; stroke-dasharray: 1 4; stroke-linecap: round; }
  .drs-leg .lg-nps { stroke: var(--ink2); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .drs-leg .lg-epbd { stroke: var(--ink); stroke-width: 3; }
  .drs-leg .lg-oth { stroke: var(--ink2); stroke-width: 1.2; opacity: .4; }
  .drs-bau { font-size: .92rem; background: var(--greenbg); border-radius: 8px; padding: .6rem .9rem; margin: 0 0 .8rem; max-width: none; }
  .drs .ref { fill: none; stroke: var(--ink2); stroke-width: 2; stroke-dasharray: 1 4; stroke-linecap: round; }
  .drs .reft { font-size: 11px; fill: var(--ink2); font-weight: 700; }
  .drs-cilji .ref { color: var(--ink2); }
  .drs-cilji { margin: .8rem 0; }
  .drs-cilji table { font-size: .82rem; }
  .drs-cilji caption { text-align: left; font-weight: 700; margin-bottom: .3rem; }
  .drs-cilji th small { display: block; font-weight: 500; color: var(--ink2); letter-spacing: 0; text-transform: none; }
  .drs-cilji .on { background: var(--greenbg); font-weight: 700; }
  .drs-cilji td.da .mk { color: var(--green); font-weight: 800; }
  .drs-cilji td.ne .mk { color: var(--amber); font-weight: 800; }
  .drs .note { font-size: .82rem; color: var(--ink2); }
  :global(html:not(.js)) .drs .ln { opacity: .9; }
</style>

<script>
  const fig = document.querySelector<HTMLElement>('.drs');
  if (fig) {
    const r = fig.querySelector<HTMLInputElement>('#drs-r')!;
    const txt = fig.querySelector<HTMLElement>('#drs-txt')!;
    const st = [...(fig.querySelector<HTMLTemplateElement>('#drs-stavki')!.content.querySelectorAll('p'))].map((p) => p.textContent!);
    const labs = [...fig.querySelectorAll<HTMLElement>('.drs-lab li')].map((l) => l.firstChild!.textContent!.trim());
    const set = () => {
      const i = Number(r.value);
      fig.querySelectorAll<SVGElement>('[data-i]').forEach((e) => e.classList.toggle('on', Number(e.dataset.i) === i));
      txt.textContent = st[i];
      r.setAttribute('aria-valuetext', `${labs[i]} na leto`);
    };
    r.addEventListener('input', set);
  }
</script>
