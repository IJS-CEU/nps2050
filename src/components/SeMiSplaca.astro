---
/**
 * Kalkulator »Se mi splača?« (Za lastnike): povračilne dobe ukrepov za enodružinsko hišo brez spodbude, s spodbudo po pozivu
 * 126SUB-OB26 in po predlogu NPS 2050 (N1), s pasom življenjske dobe, vsoto za paket in drsniki »kaj če«.
 * Računski model: src/scripts/povracilo.ts (testi tests/povracilo.test.mjs), podatki src/data/povracilne_dobe.json.
 * Vse se računa v brskalniku, vnosi se ne shranjujejo. Iz orodja Preveri stavbo se predizpolni prek ?obdobje=&stanje=&energent=&razred=&nad43=.
 */
import D from '../data/povracilne_dobe.json';
import { nf } from '../lib/format';

const U = D.ukrepi;
const C = D.cene_energentov_eur_kwh;
const UB = D.bloki.ukrepi;
// [id, ime hiša, namig hiša, ime blok, namig blok]; brez imena za blok = ukrep v bloku ni na voljo
const UKREPI = [
  ['fasada', U.fasada.ime, 'okoli 80 €/m² fasade', UB.fasada.ime, `okoli ${nf(Math.round(UB.fasada.strosek_eur_m2_stanovanja))} €/m² stanovanja`],
  ['streha', U.streha.ime, 'okoli 120 €/m² strehe', UB.streha.ime, `okoli ${nf(Math.round(UB.streha.strosek_eur_m2_stanovanja))} €/m² stanovanja`],
  ['plosca_podstrehe', U.plosca_podstrehe.ime, 'okoli 60 €/m²', '', ''],
  ['okna', U.okna.ime, 'okoli 830 €/m² okna', UB.okna.ime, `okoli ${nf(Math.round(UB.okna.strosek_eur_m2_stanovanja))} €/m² stanovanja`],
  ['prezracevanje', 'Prezračevanje z vračanjem toplote', 'lokalno 2.200 €, centralno 8.000 €', UB.prezracevanje.ime, `okoli ${nf(Math.round(UB.prezracevanje.strosek_eur_m2_stanovanja))} €/m² stanovanja`],
  ['tc', 'Toplotna črpalka', 'okoli 1.000 €/kW (zrak-voda)', '', ''],
  ['pv', 'Sončna elektrarna', `okoli ${nf(U.soncna_elektrarna.strosek_eur_kw)} €/kW, spodbude ni`, '', ''],
] as const;
const PV = U.soncna_elektrarna;
const FOND = loadData<StavbniFond>('stavbni_fond');
const meje = (id: string) => ((c) => ['A|B', 'B|C', 'C|D', 'D|E', 'E|F', 'F|G'].map((k) => c.class_bounds[k]))(FOND.categories.find((c: any) => c.id === id) as any);
const MEJE = { hisa: meje('HISA'), blok: meje('BLOKI') };
const SEZ = 20;
import { loadData, type StavbniFond } from '../lib/data';
---
<section class="sms" id="se-mi-splaca-kalkulator" aria-labelledby="sms-h" data-meje={JSON.stringify(MEJE)}>
  <h3 id="sms-h" class="visually-hidden">Kalkulator povračilnih dob</h3>
  <form class="sms-form" novalidate>
    <fieldset class="sms-step">
      <legend><span class="sms-n">1</span> Moja stavba</legend>
      <div class="sms-tip" role="radiogroup" aria-label="Vrsta stavbe">
        <label><input type="radio" name="sms-tip" value="hisa" checked /> Hiša</label>
        <label><input type="radio" name="sms-tip" value="blok" /> Stanovanje v bloku</label>
      </div>
      <p class="sms-help" id="sms-tip-help" hidden>Fasado in streho prenavljajo etažni lastniki skupaj; prikazan je vaš delež stroška po m² stanovanja in spodbuda za skupne dele po pozivu Eko sklada 124SUB-OBPO25. Okna in prezračevanje v stanovanju so vaša odločitev (poziv 126SUB-OB26).</p>
      <div class="sms-grid">
        <label><span id="sms-a-l">Ogrevana površina hiše</span>
          <span class="sms-rng"><input type="range" id="sms-a" min="60" max="300" step="5" value="110" aria-describedby="sms-a-u" /><input type="number" id="sms-a-n" min="60" max="300" step="5" value="110" aria-label="Ogrevana površina v m²" /><span id="sms-a-u">m²</span></span>
        </label>
        <label>Leto gradnje
          <select id="sms-ob"><option value="pred_1980">do 1980</option><option value="1981_2002">1981–2002</option><option value="po_2002">po 2002</option></select>
        </label>
        <label>Izolacija ovoja
          <select id="sms-st"><option value="neizoliran">ni izolirana</option><option value="delno">delno (npr. streha ali okna)</option><option value="izoliran">izolirana</option></select>
        </label>
        <label>Ogrevanje danes
          <select id="sms-en"><option value="kurilno_olje">kurilno olje</option><option value="zemeljski_plin">zemeljski plin</option><option value="peleti" data-hisa>peleti</option><option value="polena" data-hisa>polena</option><option value="elektrika">elektrika (neposredno)</option><option value="daljinska_toplota">daljinska toplota</option></select>
        </label>
        <label>Letna raba energenta (neobvezno)
          <span class="sms-rng"><input type="number" id="sms-raba" min="0" step="100" placeholder="ocena" /><span>kWh</span></span>
        </label>
      </div>
    </fieldset>

    <fieldset class="sms-step">
      <legend><span class="sms-n">2</span> Ukrepi</legend>
      <ul class="sms-uk">
        {UKREPI.map(([id, ime, hint, imeB, hintB]) => (
          <li data-u={id} data-ime-hisa={ime} data-ime-blok={imeB} data-hint-hisa={hint} data-hint-blok={hintB}>
            <label class="sms-chk"><input type="checkbox" value={id} checked={id === 'fasada' || id === 'tc'} /> <span class="sms-ime">{ime}</span></label>
            {id === 'prezracevanje' && <select class="sms-sub" id="sms-prez" aria-label="Vrsta prezračevanja"><option value="lokalno">lokalno</option><option value="centralno">centralno</option></select>}
            {id === 'pv' && <span class="sms-pvin"><label>moč <input type="number" id="sms-pvkw" min="1" max="30" step="0.5" placeholder="samodejno" /> kW</label><label>raba elektrike brez ogrevanja <input type="number" id="sms-gosp" min="500" max="15000" step="100" placeholder={nf(PV.raba_gospodinjstva_kwh)} /> kWh/leto</label></span>}
            {id === 'tc' && <select class="sms-sub" id="sms-tcv" aria-label="Vrsta toplotne črpalke"><option value="zrak_voda">zrak-voda</option><option value="zemlja_voda">zemlja-voda ali voda-voda</option></select>}
            <span class="sms-def"><span data-def={id}></span> <span class="sms-hint">(<span class="sms-hint-t">{hint}</span>)</span></span>
            <label class="sms-own">vaša ponudba <input type="number" min="0" step="100" data-own={id} placeholder="€" /> €</label>
          </li>
        ))}
      </ul>
    </fieldset>

    <fieldset class="sms-step sms-res-wrap">
      <legend><span class="sms-n">3</span> Rezultat: v koliko letih se povrne</legend>
      <div id="sms-ure" class="sms-ure" aria-live="polite" hidden></div>
      <ul class="sms-leg" aria-hidden="true">
        <li><i class="m m0"></i>brez spodbude</li>
        <li><i class="m m1"></i><span id="sms-leg1">s spodbudo po pozivu 2026</span></li>
        <li><i class="m m2"></i><span id="sms-leg2">s spodbudo po predlogu NPS 2050</span></li>
        <li><i class="band"></i>življenjska doba</li>
      </ul>
      <div id="sms-out" aria-live="polite"></div>
      <div id="sms-pvres" class="sms-pvres" hidden></div>
      <div id="sms-pkt" class="sms-pkt"></div>
      <div class="sms-btns"><button type="button" class="btn primary" id="sms-itisk">Okvirni načrt prenove (A4, PDF)</button><button type="button" class="btn" id="sms-copy">Kopiraj povzetek</button><span id="sms-copied" class="sms-hint" aria-live="polite"></span></div>
      <p class="sms-hint sms-ihint">Okvirni načrt primerja različice iz izbranih ukrepov in se odpre v novem zavihku, kjer ga natisnete ali shranite kot PDF.</p>
    </fieldset>

    <details class="sms-step sms-nacrt" id="sms-nacrt" data-hisa>
      <summary><span class="sms-n">4</span> Prenova po korakih: razporedite izbrane ukrepe po letih</summary>
      <p class="sms-help">Celovite prenove ni treba narediti naenkrat. Izberite, v katerem letu izvedete posamezen ukrep, in primerjajte stroške v {SEZ} letih z izvedbo vsega naenkrat in s hišo brez prenove. Po predlogu NPS 2050 bi koraki po izkazu o prenovi dobili +5 odstotnih točk spodbude, če se načrt konča s celovito prenovo, pa vsi koraki +10 kot celovita prenova.</p>
      <div class="sms-nbtn"><button type="button" class="btn" id="sms-npri">Priporočen vrstni red</button><button type="button" class="btn" id="sms-nvse">Vse naenkrat</button>
        <label class="sms-nsel">Spodbuda v grafu <select id="sms-nsp"><option value="poziv">po pozivu 2026</option><option value="nps">po predlogu NPS 2050</option></select></label>
        <label class="sms-nsel" id="sms-nob-l">Obračun elektrarne <select id="sms-nob"><option value="nova">nova shema samooskrbe (od 2024)</option><option value="letni">letni net metering (do 2023)</option><option value="mesecni">mesečni net metering (hipotetično)</option></select></label>
      </div>
      <ol id="sms-nkor" class="sms-nkor"></ol>
      <div id="sms-nout" class="sms-nout" aria-live="polite"></div>
    </details>

    <details class="sms-step sms-izpis" id="sms-izpis">
      <summary><span class="sms-n">5</span> Okvirni načrt prenove: primerjava različic in izpis</summary>
      <p class="sms-help">Iz izbranih ukrepov kalkulator sestavi delne prenove (vsak ukrep posebej, vse ukrepe na ovoju skupaj in vse obnovljive vire skupaj), izvedbo vseh ukrepov naenkrat in postopno prenovo – najprej ukrepi za učinkovito rabo energije (URE) ali najprej obnovljivi viri (OVE) – in jih primerja v {SEZ} letih.</p>
      <div id="sms-iout" aria-live="polite"></div>
    </details>

    <details class="sms-step sms-kajce">
      <summary>Kaj če? Spremenite cene energije, strošek naložbe ali delež spodbude</summary>
      <div class="sms-grid sms-kaj">
        <label>Cena elektrike <output id="sms-pel-o"></output>
          <span class="sms-rng"><input type="range" id="sms-pel" min="-50" max="50" step="5" value="0" /><input type="number" id="sms-pel-n" min="-50" max="50" step="5" value="0" aria-label="Sprememba cene elektrike v odstotkih" /><span>%</span></span>
        </label>
        <label>Cena sedanjega energenta <output id="sms-pen-o"></output>
          <span class="sms-rng"><input type="range" id="sms-pen" min="-50" max="50" step="5" value="0" /><input type="number" id="sms-pen-n" min="-50" max="50" step="5" value="0" aria-label="Sprememba cene sedanjega energenta v odstotkih" /><span>%</span></span>
        </label>
        <label>Strošek naložbe <output id="sms-cst-o"></output>
          <span class="sms-rng"><input type="range" id="sms-cst" min="-40" max="40" step="5" value="0" /><input type="number" id="sms-cst-n" min="-40" max="40" step="5" value="0" aria-label="Sprememba stroška naložbe v odstotkih" /><span>%</span></span>
        </label>
        <label>Odkupna cena presežkov elektrike <output id="sms-odk-o"></output>
          <span class="sms-rng"><input type="range" id="sms-odk" min="0" max="15" step="1" value={Math.round(PV.odkupna_cena_eur_kwh * 100)} /><input type="number" id="sms-odk-n" min="0" max="15" step="1" value={Math.round(PV.odkupna_cena_eur_kwh * 100)} aria-label="Odkupna cena presežkov v centih na kWh" /><span>c/kWh</span></span>
        </label>
        <label>Rast cen energije na leto <output id="sms-rast-o"></output>
          <span class="sms-rng"><input type="range" id="sms-rast" min="0" max="6" step="0.5" value={D.model.rast_cen_energije * 100} /><input type="number" id="sms-rast-n" min="0" max="6" step="0.5" value={D.model.rast_cen_energije * 100} aria-label="Rast cen energije v odstotkih na leto" /><span>%</span></span>
          <span class="sms-hint">za stroške v {SEZ} letih (prenova po korakih in okvirni načrt)</span>
        </label>
        <label>Cena CO₂ v ETS2 od leta {D.model.ets2.od_leta} <output id="sms-ets-o"></output>
          <span class="sms-rng"><input type="range" id="sms-ets" min="0" max="150" step="5" value={D.model.ets2.cena_eur_t} /><input type="number" id="sms-ets-n" min="0" max="150" step="5" value={D.model.ets2.cena_eur_t} aria-label="Cena CO₂ v ETS2 v evrih na tono" /><span>€/t</span></span>
          <span class="sms-hint">dražji kurilno olje in plin; 0 = brez</span>
        </label>
        <div class="sms-lbl"><label for="sms-sp">Delež spodbude</label>
          <span class="sms-rng"><span class="sms-rw"><input type="range" id="sms-sp" min="0" max="70" step="1" value="40" list="sms-sp-t" /><span class="sms-ticks" aria-hidden="true"><span style="left:37.1%">2024</span><span style="left:57.1%">2026</span><span style="left:85.7%">NPS</span></span></span><input type="number" id="sms-sp-n" min="0" max="70" step="1" value="40" aria-label="Delež spodbude v odstotkih" /><span>%</span></span>
          <datalist id="sms-sp-t"><option value="26" label="poziv 2024"></option><option value="40" label="poziv 2026"></option><option value="60" label="predlog NPS F, G"></option></datalist>
          <span class="sms-hint">oznake: poziv 2024 (dejansko okoli 26 %), poziv 2026 (40 %), predlog NPS za razreda F in G (60 %)</span>
          <label class="sms-chk sms-pz"><input type="checkbox" id="sms-poziv" checked /> pravila poziva 2026 (ovoj 40 %, toplotna črpalka 50 %, z zgornjimi mejami)</label>
        </div>
      </div>
    </details>
  </form>
  <p class="note">Ocena za orientacijo, ne nadomešča energetskega pregleda. Spodbude po javnih pozivih 126SUB-OB26 in 124SUB-OBPO25 (skupni deli večstanovanjskih stavb) veljajo do porabe sredstev; stopnjevane spodbude so predlog iz osnutka NPS 2050 in še niso sprejete. Stroški so mediane priznanih stroškov Eko sklada 2023–2025, ki so za 20 do 40 % nižje od polnih tržnih cen (fasada okoli {nf(U.fasada.strosek_trzni_eur_m2)} €/m², toplotna črpalka z vgradnjo okoli {nf(U.tc_zrak_voda.strosek_trzni_eur)} €); vnesete lahko svojo ponudbo. Za stanovanja v blokih je cena daljinske toplote {nf(D.bloki.cene_energentov_eur_kwh.daljinska_toplota, 3)} €/kWh s prispevki in DDV (Agencija za energijo 2025). Cene energentov (€/kWh): elektrika {nf(C.elektrika, 3)}, plin {nf(C.zemeljski_plin, 3)}, kurilno olje {nf(C.kurilno_olje, 2)}, peleti {nf(C.peleti, 2)}, polena {nf(C.polena, 3)}, daljinska toplota {nf(C.daljinska_toplota, 2)} ({C.vir}). Povračilna doba je nediskontirana: strošek, zmanjšan za spodbudo, deljen z letnim prihrankom. Sončna elektrarna: proizvodnja {nf(PV.proizvodnja_kwh_kw_mesec.reduce((a: number, b: number) => a + b, 0))} kWh na kW na leto po mesecih ({PV.vir_proizvodnje}), raba elektrike gospodinjstva privzeto {nf(PV.raba_gospodinjstva_kwh)} kWh na leto, elektrika za ogrevanje po mesecih po stopinjskih dnevih (Eurostat 2015–2024). Pokrita kWh je vredna toliko kot kupljena elektrika (energija, omrežnina za energijo, prispevki in DDV); omrežnina za moč in druge fiksne postavke se ne spremenijo. Letni net metering (stara shema, elektrarne, priključene do konca leta 2023): poračuna se letna razlika med prevzeto in oddano elektriko, letni presežek ni plačan. Nova shema samooskrbe (od leta 2024): mesečni obračun v evrih – prevzeto elektriko kupite, oddano prodate po pogodbi z dobaviteljem (odkupne cene v ponudbah so okoli 0–3 c/kWh, privzeto 0), zato šteje predvsem elektrika, porabljena sproti (privzeto {nf(PV.delez_sproti * 100)} % proizvodnje brez hranilnika). Mesečni net metering je hipotetična različica za razpravo. Prenova po korakih: primarna energija je ocena skupne primarne energije za ogrevanje, toplo vodo in pomožno elektriko (z energijo okolice pri toplotni črpalki), elektrarna jo zmanjša za elektriko, ki jo stavba v istem mesecu porabi; meja za brezemisijsko stavbo je meja razreda A ({nf(D.model.zeb_meja_pe_kwh_m2)} kWh/(m²·a)); razred je ocena po mejah za enostanovanjske hiše, ne razred na energetski izkaznici.</p>
</section>

<style>
  .sms { margin: 1rem 0 2rem; }
  .sms [hidden] { display: none !important; }
  .sms-form { display: grid; gap: 1rem; }
  .sms-step { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: .9rem 1.1rem 1.1rem; margin: 0; min-width: 0; }
  .sms-step legend { font-weight: 800; padding: 0 .4rem; color: var(--ink); }
  .sms-kajce[open] summary { margin-bottom: .8rem; }
  .sms-n { display: inline-grid; place-items: center; width: 1.6em; height: 1.6em; border-radius: 50%; background: var(--green); color: var(--on-green); font-size: .85em; margin-right: .35rem; }
  .sms-tip { display: flex; gap: 1.2rem; margin: .1rem 0 .7rem; font-weight: 700; }
  .sms-tip label { display: inline-flex; gap: .4rem; align-items: center; }
  .sms-tip input { accent-color: var(--green); width: 1.1rem; height: 1.1rem; }
  :global(.sms-pkt .brez) { grid-column: 1 / -1; font-size: .88rem; margin: 0; color: var(--ink); }
  .sms-help { color: var(--ink2); font-size: .9rem; margin: .2rem 0 .7rem; }
  .sms-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .8rem 1.2rem; }
  .sms-grid { align-items: start; }
  .sms-kaj .sms-lbl { grid-column: 1 / -1; max-width: 40rem; }
  .sms-grid > label, .sms-grid > .sms-lbl { align-content: start; display: grid; gap: .3rem; font-size: .9rem; font-weight: 700; color: var(--ink); position: relative; }
  .sms-grid select, .sms-grid input[type=number] { font: inherit; font-weight: 400; padding: .35rem .5rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  .sms-rng { display: flex; align-items: center; gap: .5rem; font-weight: 400; }
  .sms-rng input[type=range] { flex: 1; accent-color: var(--green); }
  .sms-rng input[type=number] { width: 5.5rem; }
  .sms-uk { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
  .sms-uk li { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .8rem; padding: .35rem 0; border-bottom: 1px solid var(--line); }
  .sms-chk { font-weight: 700; display: inline-flex; gap: .4rem; align-items: center; min-width: 16rem; }
  .sms-chk input { accent-color: var(--green); width: 1.1rem; height: 1.1rem; }
  .sms-sub { font: inherit; font-size: .85rem; padding: .2rem .4rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .sms-def { font-size: .88rem; color: var(--ink); }
  .sms-hint { color: var(--ink2); font-size: .82rem; }
  .sms-own { margin-left: auto; font-size: .82rem; color: var(--ink2); }
  .sms-own input { width: 6.5rem; font: inherit; padding: .2rem .4rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .sms-pvin { display: inline-flex; flex-wrap: wrap; gap: .3rem .8rem; font-size: .82rem; color: var(--ink2); }
  .sms-pvin input { width: 5.5rem; font: inherit; padding: .2rem .4rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .sms-ure:not([hidden]) { border-left: 4px solid #B7791F; background: #FBF3E4; border-radius: 8px; padding: .6rem .9rem; margin: 0 0 .9rem; font-size: .9rem; color: #3D2A06; }
  :global(.sms-ure h4) { margin: 0 0 .3rem; font-size: .95rem; }
  :global(.sms-ure p) { margin: .25rem 0; max-width: none; }
  :global(.sms-ure .btn) { margin-top: .4rem; font-size: .85rem; }
  .sms-pvres:not([hidden]) { border-top: 1px solid var(--line); padding: .8rem 0 0; margin-top: .3rem; }
  :global(.sms-pvres h4) { margin: 0 0 .2rem; font-size: .95rem; }
  :global(.sms-tw) { overflow-x: auto; }
  :global(.sms-itab tr.grp th) { background: var(--greenbg); font-weight: 700; padding-top: .45rem; }
  :global(.sms-itab tr.naj td) { background: color-mix(in srgb, var(--greenbg) 55%, transparent); }
  :global(.sms-itab td), :global(.sms-itab th) { vertical-align: top; }
  :global(.sms-izpis h4) { margin: 1rem 0 .3rem; font-size: 1rem; }
  :global(.sms-ug) { margin: 0 0 .5rem; padding-left: 1.2rem; font-size: .92rem; display: grid; gap: .35rem; }
  :global(.sms-izpis .sms-meta) { font-size: .85rem; color: var(--ink2); }
  :global(.sms-pvres .sms-meta) { font-size: .82rem; color: var(--ink2); margin: 0 0 .4rem; }
  :global(.sms-pvres .sms-leg) { list-style: none; padding: 0; margin: .2rem 0 .4rem; display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; font-size: .82rem; color: var(--ink2); }
  :global(.sms-pvres .sms-leg li) { display: inline-flex; align-items: center; gap: .4rem; margin: 0; }
  :global(.sms-pvres .sms-leg i) { display: inline-block; width: 13px; height: 13px; }
  :global(.sms-pvres table), :global(.sms-nout table) { font-size: .85rem; margin: .5rem 0; width: 100%; }
  :global(.sms-pvres td.num), :global(.sms-pvres th.num), :global(.sms-nout .num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.sms-ngraf) { width: 100%; height: auto; max-width: 680px; display: block; fill: var(--ink2); }
  :global(.sms-pvres svg), :global(.sms-nout svg) { width: 100%; height: auto; max-width: 640px; display: block; font-size: 11px; fill: var(--ink2); }
  :global(.sms-pvres .note), :global(.sms-nout .note) { font-size: .82rem; }
  .sms-nacrt summary, .sms-kajce summary, .sms-izpis summary { font-weight: 800; cursor: pointer; }
  .sms-izpis[open] summary { margin-bottom: .6rem; }
  .sms-nacrt[open] summary { margin-bottom: .6rem; }
  .sms-nbtn { display: flex; flex-wrap: wrap; gap: .5rem .8rem; align-items: center; margin: .3rem 0 .6rem; }
  .sms-nsel { font-size: .85rem; color: var(--ink2); display: inline-flex; gap: .4rem; align-items: center; }
  .sms-nsel select { font: inherit; padding: .2rem .4rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  .sms-nkor { margin: 0 0 .6rem; padding-left: 1.3rem; display: grid; gap: .3rem; font-size: .9rem; }
  :global(.sms-nkor li) { display: flex; flex-wrap: wrap; gap: .3rem .8rem; align-items: center; margin: 0; }
  :global(.sms-nkor select) { font: inherit; padding: .15rem .4rem; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--ink); }
  :global(.sms-zeb) { border-radius: 8px; padding: .5rem .8rem; margin: .5rem 0; font-size: .9rem; }
  :global(.sms-zeb.da) { background: var(--greenbg); }
  :global(.sms-zeb.ne) { background: #FBF3E4; color: #3D2A06; }
  .sms-leg { list-style: none; padding: 0; margin: .2rem 0 .8rem; display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; font-size: .85rem; color: var(--ink2); }
  .sms-leg li { display: inline-flex; align-items: center; gap: .4rem; margin: 0; }
  .m { display: inline-block; width: 13px; height: 13px; }
  .m0 { border-radius: 50%; border: 2.5px solid var(--ink2); background: var(--panel); }
  .m1 { background: var(--green); border-radius: 2px; }
  .m2 { width: 0; height: 0; border-left: 8px solid transparent; border-right: 8px solid transparent; border-bottom: 14px solid #B7791F; }
  .band { display: inline-block; width: 26px; height: 12px; background: var(--greenbg); border-radius: 3px; }
  :global(.sms-row) { display: grid; grid-template-columns: minmax(11rem, 17rem) 1fr; gap: .3rem 1rem; padding: .7rem 0; border-top: 1px solid var(--line); align-items: center; }
  :global(.sms-row h4) { margin: 0; font-size: .95rem; }
  :global(.sms-row .sms-meta) { font-size: .8rem; color: var(--ink2); line-height: 1.35; margin: .15rem 0 0; }
  :global(.sms-track) { position: relative; height: 34px; }
  :global(.sms-track .axis) { position: absolute; left: 0; right: 0; top: 16px; height: 2px; background: var(--line); }
  :global(.sms-track .life) { position: absolute; left: 0; top: 7px; height: 20px; background: var(--greenbg); border-radius: 4px; }
  :global(.sms-track .lifel) { position: absolute; top: -3px; font-size: .7rem; color: var(--green); transform: translateX(-100%); white-space: nowrap; padding-right: 4px; }
  :global(.sms-track .mk) { position: absolute; top: 10px; transform: translateX(-50%); }
  :global(.sms-track .mk.c0) { width: 14px; height: 14px; border-radius: 50%; border: 2.5px solid var(--ink2); background: var(--panel); top: 10px; }
  :global(.sms-track .mk.c1) { width: 14px; height: 14px; background: var(--green); border-radius: 2px; }
  :global(.sms-track .mk.c2) { width: 0; height: 0; border-left: 9px solid transparent; border-right: 9px solid transparent; border-bottom: 15px solid #B7791F; top: 9px; }
  :global(.sms-track .over) { position: absolute; right: 0; top: 0; font-size: .75rem; color: var(--ink2); }
  :global(.sms-vals) { grid-column: 2; display: flex; flex-wrap: wrap; gap: .2rem 1rem; font-size: .82rem; color: var(--ink); }
  :global(.sms-vals b) { font-variant-numeric: tabular-nums; }
  :global(.sms-row details) { grid-column: 1 / -1; font-size: .8rem; color: var(--ink2); }
  :global(.sms-row details summary) { cursor: pointer; color: var(--green); }
  :global(.sms-warn) { grid-column: 1 / -1; font-size: .85rem; color: #8F5A08; margin: 0; }
  :global(.sms-tcnote) { grid-column: 1 / -1; font-size: .85rem; background: var(--greenbg); border-radius: 8px; padding: .45rem .7rem; margin: .2rem 0 0; }
  :global(.sms-axis) { display: grid; grid-template-columns: minmax(11rem, 17rem) 1fr; gap: 1rem; font-size: .72rem; color: var(--ink2); }
  :global(.sms-axis .ax) { position: relative; height: 1rem; }
  :global(.sms-axis .ax span) { position: absolute; transform: translateX(-50%); }
  .sms-pkt:not(:empty) { margin-top: .8rem; border: 2px solid var(--green); border-radius: 12px; padding: .8rem 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .6rem 1rem; }
  :global(.sms-pkt h4) { grid-column: 1 / -1; margin: 0; font-size: 1rem; }
  :global(.sms-pkt .k b) { display: block; font-size: 1.35rem; color: var(--green); font-variant-numeric: tabular-nums; }
  :global(.sms-pkt .k span) { font-size: .82rem; color: var(--ink2); }
  .sms-btns { margin-top: .8rem; display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }
  .sms-ihint { margin: .4rem 0 0; }
  .sms-rw { flex: 1; display: grid; }
  .sms-rw input { width: 100%; accent-color: var(--green); }
  .sms-ticks { position: relative; height: 1rem; margin: 0 8px; font-size: .7rem; color: var(--ink2); font-weight: 400; }
  .sms-ticks span { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  .sms-lbl .sms-hint { font-weight: 400; }
  .sms-pz { font-weight: 400; font-size: .82rem; min-width: 0; margin-top: .3rem; }
  output { font-weight: 400; color: var(--ink2); font-size: .85rem; }
  @media (max-width: 640px) { :global(.sms-row), :global(.sms-axis) { grid-template-columns: 1fr; } :global(.sms-vals) { grid-column: 1; } .sms-own { margin-left: 0; } }
</style>

<script>
  import D from '../data/povracilne_dobe.json';
  import { izracun, strosekUkrepa, mocTC, potrebnaToplota, privzetaMocPV, opozorila, nacrt, variante, razred as razredPE, PRIPOROCEN, OVE_PRVO, PRIVZETO, type Vhod, type Nastavitve, type Ukrep, type Rezultat, type Obracun } from '../scripts/povracilo';

  const root = document.getElementById('se-mi-splaca-kalkulator') as HTMLElement;
  if (root) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const nf = (v: number, d = 0) => v.toLocaleString('sl-SI', { minimumFractionDigits: d, maximumFractionDigits: d, useGrouping: 'always' } as Intl.NumberFormatOptions);
    const eur = (v: number) => `${nf(Math.round(v / 100) * 100)} €`;
    const let_ = (x: number | null) => {
      if (x == null) return 'se ne povrne';
      if (x > 50) return 'več kot 50 let';
      const t = nf(x, x < 10 ? 1 : 0);
      if (t.includes(',')) return `${t} leta`;   // decimalna števila: »2,4 leta«
      const k = Number(t) % 100;
      return `${t} ${k === 1 ? 'leto' : k === 2 ? 'leti' : k === 3 || k === 4 ? 'leta' : 'let'}`;
    };
    const MAX = 50;
    const pos = (x: number) => `${Math.min(100, (100 * x) / MAX)}%`;
    const out = $('sms-out'), pkt = $('sms-pkt');

    // povezava drsnika in številčnega polja
    const pair = (a: string) => {
      const r = $<HTMLInputElement>(a), n = $<HTMLInputElement>(`${a}-n`);
      r.addEventListener('input', () => { n.value = r.value; run(); });
      n.addEventListener('input', () => { r.value = n.value; run(); });
    };

    // predizpolnitev iz orodja Preveri stavbo
    const q = new URLSearchParams(location.search);
    const setIf = (id: string, v: string | null) => { if (v && $<HTMLSelectElement>(id).querySelector(`option[value="${v}"]`)) $<HTMLSelectElement>(id).value = v; };
    setIf('sms-ob', q.get('obdobje')); setIf('sms-st', q.get('stanje')); setIf('sms-en', q.get('energent'));
    const razred = q.get('razred'), nad43 = q.get('nad43');
    if (q.get('povrsina')) { $<HTMLInputElement>('sms-a').value = $<HTMLInputElement>('sms-a-n').value = q.get('povrsina')!; }

    // vrsta stavbe: hiša ali stanovanje v bloku
    const tip = () => (root.querySelector<HTMLInputElement>('input[name="sms-tip"]:checked')!.value as Vhod['tip']);
    const nastaviTip = (prvic = false) => {
      const b = tip() === 'blok';
      $('sms-tip-help').hidden = !b;
      $('sms-a-l').textContent = b ? 'Površina stanovanja' : 'Ogrevana površina hiše';
      const a = $<HTMLInputElement>('sms-a'), an = $<HTMLInputElement>('sms-a-n');
      a.min = an.min = b ? '25' : '60'; a.max = an.max = b ? '150' : '300';
      if (!prvic || !q.get('povrsina')) a.value = an.value = b ? '59' : '110';
      root.querySelectorAll<HTMLElement>('.sms-uk li[data-u]').forEach((li) => {
        const ime = li.dataset[b ? 'imeBlok' : 'imeHisa'];
        li.hidden = !ime;
        if (ime) { li.querySelector('.sms-ime')!.textContent = ime; li.querySelector('.sms-hint-t')!.textContent = li.dataset[b ? 'hintBlok' : 'hintHisa'] ?? ''; }
        if (!ime) li.querySelector<HTMLInputElement>('input[type=checkbox]')!.checked = false;
      });
      root.querySelectorAll<HTMLElement>('[data-hisa]').forEach((x) => { x.hidden = b; if (x instanceof HTMLOptionElement) x.disabled = b; });
      $<HTMLSelectElement>('sms-prez').hidden = b;
      const en = $<HTMLSelectElement>('sms-en');
      if (b && (en.selectedOptions[0]?.disabled || (!prvic && en.value === 'kurilno_olje'))) en.value = 'daljinska_toplota';
      if (!b && !prvic && en.value === 'daljinska_toplota') en.value = 'kurilno_olje';
      if (!prvic && b) root.querySelector<HTMLInputElement>('.sms-uk input[value="okna"]')!.checked = true;
    };
    root.querySelectorAll('input[name="sms-tip"]').forEach((r) => r.addEventListener('change', () => { nastaviTip(); run(); }));
    if (q.get('tip') === 'blok') root.querySelector<HTMLInputElement>('input[name="sms-tip"][value="blok"]')!.checked = true;
    nastaviTip(true);

    const vhod = (): Vhod => {
      const ukrepi = [...root.querySelectorAll<HTMLInputElement>('.sms-uk li:not([hidden]) input[type=checkbox]:checked')].map((x) => x.value as Ukrep);
      const stroski: Partial<Record<Ukrep, number>> = {};
      root.querySelectorAll<HTMLInputElement>('[data-own]').forEach((x) => { const v = Number(x.value); if (v > 0) stroski[x.dataset.own as Ukrep] = v; });
      const raba = Number($<HTMLInputElement>('sms-raba').value);
      const b = tip() === 'blok';
      return {
        tip: tip(),
        povrsina: Math.min(b ? 150 : 300, Math.max(b ? 25 : 60, Number($<HTMLInputElement>('sms-a-n').value) || (b ? 59 : 110))),
        obdobje: $<HTMLSelectElement>('sms-ob').value as Vhod['obdobje'], stanje: $<HTMLSelectElement>('sms-st').value as Vhod['stanje'],
        energent: $<HTMLSelectElement>('sms-en').value as Vhod['energent'], raba_kwh: raba > 0 ? raba : null, ukrepi, stroski,
        tc_vrsta: $<HTMLSelectElement>('sms-tcv').value as Vhod['tc_vrsta'], prezracevanje: $<HTMLSelectElement>('sms-prez').value as Vhod['prezracevanje'],
        razred: razred || null, nad43: nad43 == null ? null : nad43 === '1',
        pv_kw: Number($<HTMLInputElement>('sms-pvkw').value) || null, raba_gosp_kwh: Number($<HTMLInputElement>('sms-gosp').value) || null,
      };
    };
    const nast = (): Nastavitve => ({
      cena_el: 1 + Number($<HTMLInputElement>('sms-pel').value) / 100, cena_en: 1 + Number($<HTMLInputElement>('sms-pen').value) / 100,
      strosek: 1 + Number($<HTMLInputElement>('sms-cst').value) / 100,
      spodbuda: $<HTMLInputElement>('sms-poziv').checked ? null : Number($<HTMLInputElement>('sms-sp').value) / 100,
      odkup: Number($<HTMLInputElement>('sms-odk').value) / 100,
      rast: Number($<HTMLInputElement>('sms-rast').value) / 100,
      ets2: Number($<HTMLInputElement>('sms-ets').value),
    });

    // sončna elektrarna: trije načini obračuna in mesečna bilanca
    const OB: Obracun[] = ['letni', 'nova', 'mesecni'];
    const OBI: Record<Obracun, string> = { letni: 'letni net metering', nova: 'nova shema samooskrbe', mesecni: 'mesečni net metering' };
    const OBO: Record<Obracun, string> = { letni: 'stara shema, elektrarne do konca 2023', nova: 'od 2024: mesečni obračun v evrih', mesecni: 'hipotetično, za razpravo' };
    const MEJE_VSE: { hisa: number[]; blok: number[] } = JSON.parse(root.dataset.meje || '{}');
    let MEJE: number[] = MEJE_VSE.hisa;
    const MES = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'avg', 'sep', 'okt', 'nov', 'dec'];
    const kwh = (x: number) => `${nf(Math.round(x / 10) * 10)} kWh`;
    function izrisiPV(r: any) {
      const box = $('sms-pvres'), P = r.pv;
      box.hidden = !P;
      if (!P) { box.replaceChildren(); return; }
      const W = 640, H = 190, L = 48, B = 22, T = 8, bw = (W - L - 8) / 12;
      const max = Math.max(...P.proizvodnja, ...P.raba) * 1.08;
      const y = (x: number) => T + (1 - x / max) * (H - T - B);
      const step = max > 1500 ? 500 : max > 600 ? 200 : 100;
      const ticks = Array.from({ length: Math.floor(max / step) + 1 }, (_, i) => i * step);
      const gosp = P.raba.map((c: number, m: number) => c - r.el_ogrevanje * D.model.hdd_delez_mesec[m]);
      const svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Proizvodnja elektrarne in raba elektrike po mesecih: ${MES.map((m, i) => `${m} ${Math.round(P.proizvodnja[i])} in ${Math.round(P.raba[i])} kWh`).join(', ')}.">
        ${ticks.map((t) => `<line x1="${L}" x2="${W - 4}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${L - 5}" y="${y(t) + 4}" text-anchor="end">${nf(t)}</text>`).join('')}
        ${MES.map((m, i) => { const x = L + i * bw + 3, w = (bw - 6) / 2;
          return `<rect x="${x}" y="${y(P.proizvodnja[i])}" width="${w}" height="${y(0) - y(P.proizvodnja[i])}" fill="#E0A100" rx="2"/>
            <rect x="${x + w}" y="${y(gosp[i])}" width="${w}" height="${y(0) - y(gosp[i])}" fill="var(--ink2)" opacity=".45" rx="2"/>
            <rect x="${x + w}" y="${y(P.raba[i])}" width="${w}" height="${y(gosp[i]) - y(P.raba[i])}" fill="#B7791F" rx="2"/>
            <text x="${x + w}" y="${H - 6}" text-anchor="middle">${m}</text>`; }).join('')}
      </svg>`;
      box.innerHTML = `<h4>Sončna elektrarna ${nf(P.kw, P.kw % 1 ? 1 : 0)} kW</h4>
        <p class="sms-meta">strošek ${eur(P.strosek)} · proizvodnja okoli ${kwh(P.proizvodnja_kwh)} na leto · raba elektrike okoli ${kwh(P.raba_kwh)} na leto${r.el_ogrevanje > 0 ? `, od tega za ogrevanje ${kwh(r.el_ogrevanje)}` : ''} · življenjska doba ${P.zivljenjska_doba} let</p>
        <ul class="sms-leg" aria-hidden="true"><li><i class="m" style="background:#E0A100;border-radius:2px"></i>proizvodnja</li><li><i class="m" style="background:var(--ink2);opacity:.45;border-radius:2px"></i>raba gospodinjstva</li>${r.el_ogrevanje > 0 ? '<li><i class="m" style="background:#B7791F;border-radius:2px"></i>raba za ogrevanje</li>' : ''}</ul>
        ${svg}
        <div class="sms-tw"><table><thead><tr><th scope="col">Način obračuna</th><th scope="col" class="num">Pokrita lastna raba</th><th scope="col" class="num">Oddano v omrežje</th><th scope="col" class="num">Prihranek na leto</th><th scope="col" class="num">Povračilna doba</th></tr></thead>
        <tbody>${OB.map((o) => { const x = P.rezimi[o]; return `<tr><th scope="row">${OBI[o]}<br><small class="sms-hint">${OBO[o]}</small></th><td class="num">${kwh(x.pokrito_kwh)}</td><td class="num">${kwh(x.prodano_kwh + x.neplacano_kwh)}${x.neplacano_kwh > 1 ? '<br><small class="sms-hint">ni plačano</small>' : x.prodano_kwh > 1 ? `<br><small class="sms-hint">po ${nf(Math.round(P.odkup * 100))} c/kWh</small>` : ''}</td><td class="num">${nf(Math.round(x.prihranek_eur / 10) * 10)} €</td><td class="num"><b>${let_(x.doba)}</b></td></tr>`; }).join('')}</tbody></table></div>
        <p class="note">Pozimi, ko toplotna črpalka porabi največ, elektrarna proizvede najmanj. Pri letnem net meteringu poletni višek pokrije zimski odjem istega leta. Pri novi shemi se vsa oddana elektrika proda po ${nf(Math.round(P.odkup * 100))} c/kWh, prevzeta pa stane ${nf(P.pEl, 3)} €/kWh z omrežnino za energijo, zato šteje predvsem elektrika, ki jo porabite sproti (pomagata hranilnik in raba ob soncu, na primer polnjenje avta ali gretje sanitarne vode). Elektrarna ni vključena v paket ogrevanja spodaj.</p>`;
    }

    // izpis prenove: primerjava različic iz izbranih ukrepov
    const KRATKO: Record<string, string> = { fasada: 'fasada', streha: 'streha', plosca_podstrehe: 'strop proti podstrešju', okna: 'okna', prezracevanje: 'prezračevanje', tc: 'toplotna črpalka', pv: 'sončna elektrarna' };
    const SKUP: Record<string, string> = { delna: 'Delne prenove', naenkrat: 'Vsi izbrani ukrepi naenkrat', nacrt: 'Vaš načrt po korakih', ure: 'Po korakih: najprej URE', ove: 'Po korakih: najprej OVE' };
    const BARVA_SK: Record<string, string> = { delna: '#A9CDB6', brez: '#7A8681', naenkrat: '#2F8B67', nacrt: '#2B6CB0', ure: '#0B5A3A', ove: '#C98A1B' };
    const SEZ_LET = 20;
    const seznam = (uk: string[]) => uk.map((u) => KRATKO[u]).join(' + ');
    let izpisHtml = '', izpisVhod = '';
    function izrisiIzpis(v: Vhod, n: Nastavitve) {
      const o = $('sms-iout');
      const b = v.tip === 'blok';
      MEJE = MEJE_VSE[b ? 'blok' : 'hisa'];
      const st = b ? 'stanovanje' : 'hiša';
      if (v.ukrepi.length < 2) { o.innerHTML = '<p class="sms-help">Izberite vsaj dva ukrepa za primerjavo.</p>'; izpisHtml = ''; zadnji = null; return; }
      const ob = $<HTMLSelectElement>('sms-nob').value as Obracun;
      if (!$<HTMLDetailsElement>('sms-izpis').open && !zahtevan) { o.replaceChildren(); return; }
      const V = variante(D, v, n, ob, SEZ_LET, b ? undefined : leta as any);
      const N0 = V[0].N, Y = N0.brez.length - 1;
      const prih = (x: typeof N0) => x.energija_zacetek - x.energija_konec;
      const doba = (x: typeof N0) => let_(prih(x) > 0 ? (x.nalozbe - x.spodbuda.poziv) / prih(x) : null);
      const tcMoc = (x: typeof N0) => x.dogodki.find((d: any) => d.ukrep === 'tc')?.moc as number | undefined;
      const naj = Math.min(...V.map((x) => x.N.skupaj.poziv));
      const vrsta = (x: (typeof V)[number]) => {
        const N = x.N, m = tcMoc(N);
        return `<tr${N.skupaj.poziv === naj ? ' class="naj"' : ''}><td>${x.skupina === 'delna' ? seznam(x.ukrepi) : SKUP[x.skupina]}${N.celovita && x.skupina !== 'delna' ? ' <small class="sms-hint">celovita prenova</small>' : ''}${m ? ` <small class="sms-hint">(črpalka ${m} kW${N.prevelika ? `, na koncu bi zadostovala ${N.prevelika.moc_konec} kW` : ''})</small>` : ''}</td>
          <td class="num">${eur(N.nalozbe)}</td><td class="num">${eur(N.spodbuda.poziv)} / ${eur(N.spodbuda.nps)}</td><td class="num">${eur(N.energija_konec)}</td>
          <td class="num">${x.skupina === 'delna' || x.skupina === 'naenkrat' ? doba(N) : '–'}</td><td class="num"><b>${eur(N.skupaj.poziv)}</b></td><td class="num">${eur(N.ostanek.poziv)}</td>
          <td class="num">${nf(Math.round(N.konec.pe_m2))}</td><td class="num"><b>${razredPE(N.konec.pe_m2, MEJE)}</b></td><td>${N.konec.zeb ? 'da' : 'ne'}</td></tr>`;
      };
      const skupine = ['delna', 'naenkrat', 'nacrt', 'ure', 'ove'].filter((g) => V.some((x) => x.skupina === g));
      const tabela = `<div class="sms-tw"><table class="sms-itab"><caption class="visually-hidden">Primerjava različic prenove</caption>
        <thead><tr><th scope="col">Različica</th><th scope="col" class="num">Naložba</th><th scope="col" class="num">Spodbuda (poziv / NPS)</th><th scope="col" class="num">Stroški energije na leto</th><th scope="col" class="num">Povračilna doba</th><th scope="col" class="num">Izdatki v ${Y} letih: naložbe in energija</th><th scope="col" class="num">Preostala vrednost ukrepov</th><th scope="col" class="num">Primarna energija</th><th scope="col" class="num">Razred</th><th scope="col">ZEB</th></tr></thead>
        <tbody><tr><td>Brez prenove</td><td class="num">–</td><td class="num">–</td><td class="num">${eur(N0.energija_zacetek)}</td><td class="num">–</td><td class="num"><b>${eur(N0.brez.at(-1)!)}</b></td><td class="num">–</td><td class="num">${nf(Math.round(N0.zacetek.pe_m2))}</td><td class="num"><b>${razredPE(N0.zacetek.pe_m2, MEJE)}</b></td><td>ne</td></tr>
        ${skupine.map((g) => `<tr class="grp"><th colspan="10" scope="rowgroup">${SKUP[g]}</th></tr>${V.filter((x) => x.skupina === g).map(vrsta).join('')}`).join('')}</tbody></table></div>`;

      // ugotovitve iz rezultatov: zakaj najprej URE
      const ug: string[] = [];
      const najdi = (f: (u: string) => boolean) => V.find((x) => x.skupina === 'delna' && x.ukrepi.every(f) && v.ukrepi.filter(f).length === x.ukrepi.length);
      const jeUre = (u: string) => !['tc', 'pv'].includes(u);
      const samoOve = najdi((u) => !jeUre(u)), samoUre = najdi(jeUre);
      if (samoOve && samoUre) {
        const a = samoOve.N, b = samoUre.N;
        ug.push(`Samo obnovljivi viri (${seznam(samoOve.ukrepi)}) zmanjšajo stroške energije za okoli ${eur(prih(a))} na leto, ${st} pa ostane v razredu ${razredPE(a.konec.pe_m2, MEJE)}. Samo ukrepi na ovoju (${seznam(samoUre.ukrepi)}) zmanjšajo potrebno toploto z ${nf(Math.round(potrebnaToplota(D, v) / v.povrsina))} na ${nf(Math.round(b.dogodki.at(-1).toplota_m2))} kWh/m² in stroške za okoli ${eur(prih(b))} na leto – ta prihranek ostane ne glede na ceno energije in ogrevalni sistem.`);
      }
      const tcSam = V.find((x) => x.skupina === 'delna' && x.ukrepi.length === 1 && x.ukrepi[0] === 'tc'), vse = V.find((x) => x.skupina === 'naenkrat');
      if (tcSam && vse && tcMoc(tcSam.N) && tcMoc(vse.N) && tcMoc(tcSam.N)! > tcMoc(vse.N)!)
        ug.push(`Toplotna črpalka za neprenovljeno ${st === 'hiša' ? 'hišo' : 'stanovanje'} potrebuje ${tcMoc(tcSam.N)} kW, po izolaciji pa ${tcMoc(vse.N)} kW.`);
      const ure = V.find((x) => x.skupina === 'ure'), ove = V.find((x) => x.skupina === 'ove');
      if (ure && ove) ug.push(`Če najprej vgradite obnovljive vire in šele nato izolirate, stane prenova v ${Y} letih okoli ${eur(ove.N.skupaj.poziv - ure.N.skupaj.poziv)} ${ove.N.skupaj.poziv >= ure.N.skupaj.poziv ? 'več' : 'manj'} kot po vrstnem redu najprej URE${ove.N.prevelika ? `, toplotna črpalka pa ostane prevelika (${ove.N.prevelika.moc} kW namesto ${ove.N.prevelika.moc_konec} kW) in dela z nižjim izkoristkom` : ''}.`);
      const drazje = V.filter((x) => x.skupina === 'delna' && x.N.skupaj.poziv > N0.brez.at(-1)!);
      if (drazje.length) ug.push(`${drazje.map((x) => seznam(x.ukrepi)).join('; ').replace(/^./, (c) => c.toUpperCase())}: izdatki za naložbo in energijo v ${Y} letih so večji kot pri ${b ? 'stanovanju' : 'hiši'} brez prenove, ker se ${drazje.length > 1 ? 'ti ukrepi' : 'ta ukrep'} energetsko ne ${drazje.length > 1 ? 'povrnejo' : 'povrne'} v ${Y} letih (po ${Y} letih ${drazje.length > 1 ? 'imajo' : 'ima'} še preostalo vrednost). Razlog zanje so udobje, zdravje in vrednost ${b ? 'stanovanja' : 'hiše'} – ali del celovite prenove, kjer jih spodbuda in skupni prihranek naredita smiselne.`);
      const nx = V.find((x) => x.N.skupaj.poziv === naj)!;
      ug.push(`Najnižji izdatki za naložbe in energijo v ${Y} letih: ${nx.skupina === 'delna' ? seznam(nx.ukrepi) : SKUP[nx.skupina].toLowerCase()} (${eur(naj)}, brez prenove ${eur(N0.brez.at(-1)!)} samo za energijo).${V.some((x) => x.N.konec.zeb) ? ` Brezemisijska raven (ZEB) je dosežena pri: ${V.filter((x) => x.N.konec.zeb).map((x) => x.skupina === 'delna' ? seznam(x.ukrepi) : SKUP[x.skupina].toLowerCase()).join('; ')}.` : (b ? ' Nobena različica ne doseže brezemisijske ravni (ZEB); v bloku so za to potrebni izolacija fasade in strehe, nova okna in ogrevanje brez fosilnih goriv.' : ' Nobena različica ne doseže brezemisijske ravni (ZEB); praviloma so potrebni izoliran ovoj, toplotna črpalka in sončna elektrarna.')}`);

      izpisVhod = `${b ? 'Stanovanje v bloku' : 'Hiša'} ${v.povrsina} m², ${$<HTMLSelectElement>('sms-ob').selectedOptions[0].text}, izolacija: ${$<HTMLSelectElement>('sms-st').selectedOptions[0].text}, ogrevanje: ${$<HTMLSelectElement>('sms-en').selectedOptions[0].text}; izbrani ukrepi: ${seznam(v.ukrepi)}${v.ukrepi.includes('pv') ? `; elektrarna: ${OBI[ob]}` : ''}.`;
      const opomba = `Naložba po privzetih ali vaših cenah; spodbuda po pozivu 2026 / po predlogu NPS 2050 (pri postopni prenovi z dodatkom za korak po izkazu o prenovi). Stroški energije na leto: ogrevanje in elektrika gospodinjstva${v.ukrepi.includes('pv') ? ` po odbitku vrednosti elektrike iz elektrarne (${OBI[ob]})` : ''}. Izdatki v ${Y} letih: naložbe po odbitku spodbude po pozivu 2026, stroški energije in zamenjava ukrepov, ki se iztečejo prej (${b ? 'prezračevanje po 18 letih' : 'toplotna črpalka po 18 letih'}); pri različici brez prenove samo stroški energije. Preostala vrednost: del naložbe, ki ga ukrepi po ${Y} letih še niso porabili (fasada in streha trajata 35 let, okna 30), linearno; cene energije rastejo za ${nf((n.rast ?? D.model.rast_cen_energije) * 100, 1)} % na leto${(n.ets2 ?? D.model.ets2.cena_eur_t) ? `, od leta ${D.model.ets2.od_leta} je kurilno olje in plin dražji za ceno CO₂ v ETS2 (${nf(n.ets2 ?? D.model.ets2.cena_eur_t)} €/t z DDV)` : ''}; brez diskontiranja; stroški energije na leto in povračilna doba so po današnjih cenah. ${b ? 'Po korakih – najprej URE: fasada in streha takoj, okna in prezračevanje po 2 letih; ukrepe na skupnih delih (fasada, streha) sprejmejo etažni lastniki skupaj.' : 'Po korakih – najprej URE: ovoj takoj, okna in prezračevanje po 2 letih, toplotna črpalka po 3, elektrarna po 4 letih; najprej OVE: toplotna črpalka takoj, elektrarna po 1 letu, okna in prezračevanje po 3, ovoj po 5 letih.'} Primarna energija v kWh/(m²·a) in razred: poenostavljena ocena za ogrevanje, toplo vodo in pomožno elektriko, umerjena na energetske izkaznice neprenovljenih ${b ? 'blokov, po mejah za večstanovanjske stavbe' : 'hiš, po mejah za enostanovanjske hiše'}; ni razred na energetski izkaznici. ZEB: pod mejo razreda A, brez fosilnih goriv, izoliran ovoj.`;
      izpisHtml = `${tabela}
        <h4>${b ? 'Ugotovitve' : 'Najprej učinkovita raba energije, nato obnovljivi viri'}</h4>
        <ul class="sms-ug">${ug.map((x) => `<li>${x}</li>`).join('')}</ul>
        <p class="note">${opomba}</p>`;
      o.innerHTML = `<p class="sms-meta">${izpisVhod}</p>${izpisHtml}`;
      zadnji = { V, N0, Y, ug, tabela, opomba, ob, b, ime: (x: (typeof V)[number]) => x.skupina === 'delna' ? seznam(x.ukrepi) : SKUP[x.skupina] };
    }
    let zadnji: any = null, zahtevan = false;

    // dokument A4: prva stran ključne informacije in grafika, druga stran tabela vseh različic
    const BARVA: Record<string, string> = { A: '#0B7A45', B: '#62B044', C: '#D9C92B', D: '#F0AE2E', E: '#EC842B', F: '#DE5A2B', G: '#C4302C' };
    const TEMNA = new Set(['C', 'D']);
    const znak = (k: string, vel = 22) => `<span class="rz" style="background:${BARVA[k]};color:${TEMNA.has(k) ? '#1B2622' : '#fff'};width:${vel}px;height:${vel}px;font-size:${Math.round(vel * 0.6)}px">${k}</span>`;
    function dokument(): string {
      const { V, N0, Y, ug, tabela, opomba, ime, b } = zadnji;
      const rz = (pe: number) => razredPE(pe, MEJE);
      const pot = V.find((x: any) => x.skupina === 'nacrt') ?? V.find((x: any) => x.skupina === 'ure') ?? V.find((x: any) => x.skupina === 'naenkrat');
      const P = pot.N, r0 = rz(N0.zacetek.pe_m2), r1 = rz(P.konec.pe_m2);
      const koraki = P.dogodki.filter((d: any) => !d.zamenjava).map((d: any) => `<li><b>${d.leto === 0 ? 'takoj' : `po ${d.leto} ${d.leto === 1 ? 'letu' : 'letih'}`}</b>${d.ime}<small>${eur(d.strosek)}, spodbuda ${eur(d.spodbuda)}</small></li>`).join('');
      // stolpci: brez prenove, delne prenove, vse naenkrat, vaš načrt, najprej URE, najprej OVE (zadnje štiri enako kot graf v koraku 4)
      const izb = [...V.filter((x: any) => x.skupina === 'delna'), ...V.filter((x: any) => x.skupina !== 'delna')];
      const vrst = [{ ime: 'Brez prenove', s: N0.brez.at(-1), o: 0, r: r0, b: BARVA_SK.brez },
        ...izb.map((x: any) => ({ ime: x.skupina === 'delna' ? `Delna: ${ime(x)}` : ime(x), s: x.N.skupaj.poziv, o: x.N.ostanek.poziv, r: rz(x.N.konec.pe_m2), zeb: x.N.konec.zeb, b: BARVA_SK[x.skupina] }))];
      const W = 680, L = 250, R = 110, H = 26, max = Math.max(...vrst.map((x) => x.s)) * 1.02;
      const sx = (s: number) => (s / max) * (W - L - R);
      const graf = `<svg viewBox="0 0 ${W} ${vrst.length * H + 8}" class="graf">${vrst.map((x, i) => `
        <text x="${L - 8}" y="${i * H + 17}" text-anchor="end">${x.ime.length > 42 ? x.ime.slice(0, 41) + '…' : x.ime}</text>
        <rect x="${L}" y="${i * H + 4}" width="${sx(x.s)}" height="${H - 9}" rx="3" fill="${x.b}"/>
        ${x.o ? `<rect x="${L + sx(x.s - x.o)}" y="${i * H + 4}" width="${sx(x.o)}" height="${H - 9}" rx="3" fill="#fff" opacity=".45"/>` : ''}
        <text x="${L + sx(x.s) + 6}" y="${i * H + 17}" font-weight="700">${eur(x.s)}</text>
        <rect x="${W - 30}" y="${i * H + 4}" width="18" height="18" rx="3" fill="${BARVA[x.r]}"/><text x="${W - 21}" y="${i * H + 17}" text-anchor="middle" font-weight="800" fill="${TEMNA.has(x.r) ? '#1B2622' : '#fff'}" font-size="11">${x.r}</text>
        ${(x as any).zeb ? `<text x="${W - 36}" y="${i * H + 17}" text-anchor="end" font-size="10" fill="#0B7A45" font-weight="700">ZEB</text>` : ''}`).join('')}
        <line x1="${L + sx(N0.brez.at(-1))}" x2="${L + sx(N0.brez.at(-1))}" y1="0" y2="${vrst.length * H + 4}" stroke="#555" stroke-dasharray="3 3"/></svg>`;
      const kpi = (n: string, v1: string, v2 = '') => `<div class="kpi"><span>${n}</span><b>${v1}</b>${v2 ? `<small>${v2}</small>` : ''}</div>`;
      const datum = new Date().toLocaleDateString('sl-SI');
      return `<!doctype html><html lang="sl"><head><meta charset="utf-8"><title>Okvirni načrt energetske prenove</title><style>
        @page { size: A4; margin: 13mm 14mm; }
        * { box-sizing: border-box; } body { font: 12px/1.45 system-ui, 'Segoe UI', sans-serif; color: #1B2622; margin: 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .glava { background: #0B5A3A; color: #fff; border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: end; }
        .glava h1 { margin: 0; font-size: 22px; } .glava p { margin: 2px 0 0; opacity: .85; font-size: 11px; }
        .hisa { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; margin: 12px 0; padding: 10px 14px; border: 1px solid #D5DDD8; border-radius: 10px; }
        .hisa small, .kpi small, .pot small { color: #5B6660; }
        .rz { display: inline-grid; place-items: center; border-radius: 5px; font-weight: 800; vertical-align: middle; }
        .pot { border: 2px solid #2F8B67; border-radius: 10px; padding: 10px 14px; }
        .pot h2 { margin: 0 0 6px; font-size: 15px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
        .pot ol { list-style: none; padding: 0; margin: 6px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 6px; }
        .pot li { background: #EEF5F0; border-radius: 8px; padding: 6px 8px; } .pot li b { display: block; color: #0B5A3A; font-size: 11px; } .pot li small { display: block; }
        .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 10px 0; }
        .kpi { border: 1px solid #D5DDD8; border-radius: 10px; padding: 8px 10px; } .kpi span { display: block; font-size: 10.5px; color: #5B6660; } .kpi b { display: block; font-size: 17px; margin: 2px 0; }
        h3 { font-size: 14px; margin: 14px 0 4px; } .graf { width: 100%; font-size: 11px; fill: #1B2622; }
        .zakaj { background: #FBF3E4; border-left: 4px solid #C98A1B; border-radius: 8px; padding: 8px 12px; margin-top: 10px; } .zakaj h3 { margin: 0 0 4px; } .zakaj ul { margin: 0; padding-left: 16px; } .zakaj li { margin: 3px 0; }
        .stran2 { break-before: page; } table { border-collapse: collapse; width: 100%; font-size: 10.5px; } th, td { border-bottom: 1px solid #D5DDD8; padding: 3px 5px; text-align: left; vertical-align: top; }
        .num { text-align: right; } tr.grp th { background: #EEF5F0; } tr.naj td { background: #F4F9F5; } small { color: #5B6660; } .visually-hidden { display: none; } .sms-tw { overflow: visible; }
        .note { color: #5B6660; font-size: 10px; } .noga { margin-top: 10px; font-size: 10px; color: #5B6660; border-top: 1px solid #D5DDD8; padding-top: 6px; }
        @media screen { body { max-width: 210mm; margin: 12px auto; padding: 0 12px 80px; } .stran2 { margin-top: 28px; border-top: 2px dashed #D5DDD8; padding-top: 16px; } }
        .gumbi { position: sticky; bottom: 0; background: #fff; border-top: 1px solid #D5DDD8; padding: 10px 0; margin-top: 16px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
        .gumbi button { font: inherit; font-weight: 700; padding: 8px 16px; border-radius: 8px; border: 1px solid #0B5A3A; background: #0B5A3A; color: #fff; cursor: pointer; }
        .gumbi button.drugi { background: #fff; color: #0B5A3A; } .gumbi span { color: #5B6660; font-size: 11px; }
        @media print { .gumbi { display: none; } }
      </style></head><body>
        <div class="glava"><div><h1>Okvirni načrt energetske prenove</h1><p>Informativni izpis kalkulatorja »Se mi splača?« · ni izkaz o prenovi stavbe · Strokovne podlage za NPS 2050</p></div><p>${datum}</p></div>
        <div class="hisa"><div><b>${b ? 'Vaše stanovanje' : 'Vaša hiša'}</b><br>${izpisVhod}</div><div style="text-align:center">${znak(r0, 44)}<br><small>danes, ocena ${nf(Math.round(N0.zacetek.pe_m2))} kWh/(m²·a)</small></div></div>
        <div class="pot"><h2>${pot.skupina === 'nacrt' ? 'Vaš načrt po korakih' : `Vaš načrt: ${ime(pot).toLowerCase().replace('po korakih: ', 'po korakih – ')}`} ${znak(r0)} → ${znak(r1)}${P.konec.zeb ? ` <span style="color:#0B7A45">brezemisijska ${b ? 'stavba' : 'hiša'} (ZEB)</span>` : ''}</h2>
          <ol>${koraki}</ol></div>
        <div class="kpis">
          ${kpi('Naložba', eur(P.nalozbe), `spodbuda ${eur(P.spodbuda.poziv)} (po predlogu NPS ${eur(P.spodbuda.nps)})`)}
          ${kpi('Stroški energije na leto', `${eur(N0.energija_zacetek)} → ${eur(P.energija_konec)}`, 'ogrevanje in elektrika, danes → po prenovi')}
          ${kpi(`Izdatki v ${Y} letih`, eur(P.skupaj.poziv), `naložbe in energija; brez prenove samo energija ${eur(N0.brez.at(-1))}; ukrepom ostane še ${eur(P.ostanek.poziv)} vrednosti`)}
          ${kpi('Razred (ocena)', `${r0} → ${r1}`, `${nf(Math.round(N0.zacetek.pe_m2))} → ${nf(Math.round(P.konec.pe_m2))} kWh/(m²·a)`)}
        </div>
        <h3>Izdatki za naložbe in energijo v ${Y} letih ter razred po prenovi</h3>
        ${graf}
        <p class="note">Naložbe po odbitku spodbude po pozivu 2026, stroški energije in zamenjave; brez prenove samo stroški energije (črtkana črta). Svetlejši del stolpca: preostala vrednost ukrepov po ${Y} letih. Enake vrednosti kaže graf v koraku 4 kalkulatorja.</p>
        <div class="zakaj"><h3>${b ? 'Ugotovitve' : 'Najprej učinkovita raba energije, nato obnovljivi viri'}</h3><ul>${ug.map((x: string) => `<li>${x}</li>`).join('')}</ul></div>
        <div class="stran2"><h3>Vse različice</h3>${tabela}<p class="note">${opomba}</p></div>
        <p class="noga">Ocena za orientacijo, ne nadomešča energetskega pregleda, izkaza o prenovi stavbe ali svetovanja ENSVET. Spodbude po predlogu NPS 2050 še niso sprejete. Strokovne podlage NPS 2050, IJS CEU. ${location.href.split('#')[0]}</p>
        <div class="gumbi"><button type="button" onclick="window.print()">Natisni ali shrani kot PDF</button><button type="button" class="drugi" onclick="window.close()">Zapri</button><span>Za PDF v oknu za tiskanje izberite »Shrani kot PDF«.</span></div>
      </body></html>`;
    }
    $('sms-itisk').addEventListener('click', () => {
      zahtevan = true; run(); zahtevan = false;
      if (!zadnji) { $('sms-copied').textContent = 'Za okvirni načrt izberite vsaj dva ukrepa.'; return; }
      const w = window.open('', '_blank');
      if (!w) return;
      w.document.open(); w.document.write(dokument()); w.document.close();
      w.focus();
    });
    $('sms-izpis').addEventListener('toggle', () => run());

    // prenova po korakih
    const leta: Record<string, number> = { ...PRIPOROCEN };
    const LETA = Array.from({ length: 16 }, (_, i) => i);
    function izrisiNacrt(v: Vhod, n: Nastavitve) {
      const det = $<HTMLDetailsElement>('sms-nacrt'), kor = $('sms-nkor'), o = $('sms-nout');
      $('sms-nob-l').hidden = !v.ukrepi.includes('pv');
      MEJE = MEJE_VSE.hisa;
      if (v.tip === 'blok' || !v.ukrepi.length) { kor.replaceChildren(); o.innerHTML = v.tip === 'blok' ? '' : '<p class="sms-help">Izberite ukrepe zgoraj.</p>'; return; }
      const ime = (u: Ukrep) => root.querySelector<HTMLElement>(`.sms-uk li[data-u="${u}"] .sms-ime`)!.textContent!;
      kor.innerHTML = v.ukrepi.map((u) => `<li><label>${ime(u)} <select data-leto="${u}" aria-label="Leto izvedbe: ${ime(u)}">${LETA.map((y) => `<option value="${y}"${(leta[u] ?? 0) === y ? ' selected' : ''}>${y === 0 ? 'takoj' : `po ${y} ${y === 1 ? 'letu' : 'letih'}`}</option>`).join('')}</select></label></li>`).join('');
      kor.querySelectorAll<HTMLSelectElement>('select').forEach((s) => s.addEventListener('change', () => { leta[s.dataset.leto!] = Number(s.value); run(); }));
      if (!det.open) return;
      const ob = $<HTMLSelectElement>('sms-nob').value as Obracun, sp = $<HTMLSelectElement>('sms-nsp').value as 'poziv' | 'nps';
      const vh = { ...v, ukrepi: [] as Ukrep[] };
      const po = (f: (u: Ukrep) => number) => nacrt(D, vh, n, v.ukrepi.map((u) => ({ ukrep: u, leto: f(u) })), ob);
      const N = po((u) => leta[u] ?? 0);
      // iste različice kot v okvirnem načrtu prenove: vse naenkrat, najprej URE, najprej OVE in vaš načrt, če se razlikuje
      const ure = v.ukrepi.some((u) => !['tc', 'pv'].includes(u)), ove = v.ukrepi.some((u) => ['tc', 'pv'].includes(u));
      const enako = (f: (u: Ukrep) => number) => v.ukrepi.every((u) => (leta[u] ?? 0) === f(u));
      const crte: { ime: string; s: number[]; b: string; w: number; d?: string }[] = [{ ime: 'brez prenove', s: N.brez, b: BARVA_SK.brez, w: 2, d: '5 4' }];
      if (v.ukrepi.length > 1) {
        crte.push({ ime: 'vse naenkrat', s: po(() => 0).serija[sp], b: BARVA_SK.naenkrat, w: 2.5 });
        if (new Set(v.ukrepi.map((u) => PRIPOROCEN[u])).size > 1) crte.push({ ime: 'po korakih: najprej URE', s: po((u) => PRIPOROCEN[u]).serija[sp], b: BARVA_SK.ure, w: 2.5 });
        if (ure && ove) crte.push({ ime: 'po korakih: najprej OVE', s: po((u) => OVE_PRVO[u]).serija[sp], b: BARVA_SK.ove, w: 2.5 });
      }
      const lasten = !enako(() => 0) && !enako((u) => PRIPOROCEN[u]) && !enako((u) => OVE_PRVO[u]);
      if (lasten || v.ukrepi.length === 1) crte.push({ ime: 'vaš načrt', s: N.serija[sp], b: BARVA_SK.nacrt, w: 3.5 });
      const W = 680, H = 280, L = 70, R = 215, T = 12, B = 30, Y = N.brez.length - 1;
      const max = Math.ceil(Math.max(...crte.flatMap((c) => c.s)) / 10000) * 10000;
      const x = (t: number) => L + (t / Y) * (W - L - R), y = (val: number) => T + (1 - val / max) * (H - T - B);
      const line = (a: number[]) => a.map((val, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(val).toFixed(1)}`).join(' ');
      const ticks = Array.from({ length: max / 10000 + 1 }, (_, i) => i * 10000).filter((_t, i, a) => a.length < 9 || i % 2 === 0);
      // oznake na desni, razmaknjene najmanj 15 px
      const oz = crte.map((c) => ({ c, yy: y(c.s.at(-1)!) + 4 })).sort((a, b) => a.yy - b.yy);
      for (let i = 1; i < oz.length; i++) oz[i].yy = Math.max(oz[i].yy, oz[i - 1].yy + 15);
      o.innerHTML = `<svg viewBox="0 0 ${W} ${H}" font-size="11" class="sms-ngraf" role="img" aria-label="Izdatki za naložbe in energijo v ${Y} letih: ${crte.map((c) => `${c.ime} ${eur(c.s.at(-1)!)}`).join(', ')}.">
          ${ticks.map((t) => `<line x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}" stroke="var(--line)"/><text x="${L - 6}" y="${y(t) + 4}" text-anchor="end">${t ? `${nf(t / 1000)} tisoč €` : '0'}</text>`).join('')}
          ${[0, 5, 10, 15, 20].filter((t) => t <= Y).map((t) => `<text x="${x(t)}" y="${H - 10}" text-anchor="middle">${t === 0 ? 'leto 0' : t}</text>`).join('')}
          ${crte.map((c) => `<path d="${line(c.s)}" fill="none" stroke="${c.b}" stroke-width="${c.w}"${c.d ? ` stroke-dasharray="${c.d}"` : ''}/>`).join('')}
          ${oz.map(({ c, yy }) => `<text x="${W - R + 8}" y="${yy}" fill="${c.b}" font-weight="700">${c.ime} ${eur(c.s.at(-1)!)}</text>`).join('')}
        </svg>
        <p>Izdatki za naložbe (po odbitku spodbude ${sp === 'nps' ? 'po predlogu NPS' : 'po pozivu 2026'}) in energijo v ${Y} letih: ${crte.map((c) => `${c.ime} <b>${eur(c.s.at(-1)!)}</b>`).join(', ')}${crte[0].ime === 'brez prenove' ? ' (brez prenove samo energija)' : ''}. Po ${Y} letih imajo ukrepi vašega načrta še okoli ${eur(N.ostanek[sp])} preostale vrednosti (fasada in streha trajata 35 let, okna 30). Spodbuda za vaš načrt po pozivu 2026 skupaj ${eur(N.spodbuda.poziv)}, po predlogu NPS ${eur(N.spodbuda.nps)}${N.bonus_korak ? ` (vključno z dodatkom +${nf(N.bonus_korak * 100)} odstotnih točk ${N.celovita ? 'za celovito prenovo po izkazu o prenovi' : 'za korak po izkazu o prenovi'})` : ''}.</p>
        ${N.prevelika ? `<p class="sms-warn">Toplotna črpalka je vgrajena pred izolacijo ovoja: izbrana je za ${N.prevelika.moc} kW, po koncu prenove bi zadostovala za ${N.prevelika.moc_konec} kW. Premaknite jo za ukrepe na ovoju.</p>` : ''}
        <p class="sms-zeb ${N.konec.zeb ? 'da' : 'ne'}">${N.konec.zeb
          ? `<b>Na koncu načrta je hiša brezemisijska (ZEB):</b> ocena primarne energije okoli ${nf(Math.round(N.konec.pe_m2))} kWh/(m²·a) (danes ${nf(Math.round(N.zacetek.pe_m2))}), pod mejo ${nf(N.konec.meja)}, brez fosilnih goriv, z izoliranim ovojem.`
          : `<b>Na koncu načrta hiša še ni brezemisijska:</b> ${[N.konec.fosil ? 'ogreva se s fosilnim gorivom (dodajte toplotno črpalko)' : '', !N.konec.ovoj ? 'ovoj ni izoliran (dodajte fasado in streho ali strop)' : '', N.konec.pe_m2 > N.konec.meja ? `ocena primarne energije okoli ${nf(Math.round(N.konec.pe_m2))} kWh/(m²·a) je nad mejo ${nf(N.konec.meja)}${v.ukrepi.includes('pv') ? '' : ' (pogosto pomaga sončna elektrarna)'}` : ''].filter(Boolean).join('; ')}.`}</p>
        <div class="sms-tw"><table><caption class="visually-hidden">Koraki prenove</caption><thead><tr><th scope="col">Leto</th><th scope="col">Ukrep</th><th scope="col" class="num">Strošek</th><th scope="col" class="num">Spodbuda (poziv / NPS)</th><th scope="col" class="num">Toplota po koraku</th><th scope="col" class="num">Razred primarne energije</th><th scope="col" class="num">Stroški energije na leto</th></tr></thead>
        <tbody><tr><td>danes</td><td>brez prenove</td><td></td><td></td><td class="num">${nf(Math.round(potrebnaToplota(D, v) / v.povrsina))} kWh/m²</td><td class="num">${razredPE(N.zacetek.pe_m2, MEJE)}</td><td class="num">${eur(N.energija_zacetek)}</td></tr>
        ${N.dogodki.map((d: any) => `<tr><td>${d.leto === 0 ? 'takoj' : d.leto}</td><td>${d.ime}</td><td class="num">${eur(d.strosek)}</td><td class="num">${d.ukrep === 'pv' ? '–' : `${eur(d.spodbuda)} / ${eur(d.spodbuda_nps)}`}</td><td class="num">${nf(Math.round(d.toplota_m2))} kWh/m²</td><td class="num">${razredPE(d.pe_m2, MEJE)}</td><td class="num">${eur(d.energija)}</td></tr>`).join('')}</tbody></table></div>
        <p class="note">Graf kaže izdatke: naložbe po odbitku spodbude in stroške energije; toplotna črpalka se po 18 letih zamenja (strmina v grafu). Enake različice in vrednosti so v okvirnem načrtu prenove. Tabela kaže vaš načrt. Stroški energije na leto: ogrevanje, elektrika gospodinjstva${v.ukrepi.includes('pv') ? ` in vrednost elektrike iz elektrarne (${OBI[ob]})` : ''} po stanju po koraku. Razred primarne energije: poenostavljena ocena za ogrevanje, toplo vodo in pomožno elektriko umerjena na energetske izkaznice neprenovljenih hiš, po mejah za enostanovanjske hiše, ne razred na energetski izkaznici. Ker se šteje tudi toplota okolice, toplotna črpalka v slabo izolirani hiši oceno lahko celo zviša; odpravi pa fosilna goriva, z elektrarno pa se ocena zniža. Stroški energije na leto so po današnjih cenah; v grafu cene rastejo za ${nf((n.rast ?? D.model.rast_cen_energije) * 100, 1)} % na leto${(n.ets2 ?? D.model.ets2.cena_eur_t) ? `, od leta ${D.model.ets2.od_leta} še ETS2 za kurilno olje in plin (${nf(n.ets2 ?? D.model.ets2.cena_eur_t)} €/t CO₂)` : ''}; brez diskontiranja.</p>`;
    }
    $('sms-nacrt').addEventListener('toggle', () => run());

    let povzetek = '';
    function run() {
      const v = vhod(), n = nast();
      const nps = (b: number) => b >= 0.2 ? 'stavbe v razredih F in G ali med 43 % najslabših' : b >= 0.1 ? 'stavbe v razredu E' : 'brez dodatka za razred';
      const r = izracun(D, v, n);
      // privzeti stroški ob ukrepih
      const Q0 = potrebnaToplota(D, v);
      root.querySelectorAll<HTMLElement>('.sms-uk li:not([hidden]) [data-def]').forEach((el) => {
        const u = el.dataset.def as Ukrep;
        const kw = u === 'pv' ? (v.pv_kw || privzetaMocPV(D, r.el_ogrevanje, v.raba_gosp_kwh)) : undefined;
        const c = strosekUkrepa(D, u, { ...v, stroski: {}, pv_kw: kw }, PRIVZETO, u === 'tc' ? mocTC(D, Q0) : undefined);
        el.textContent = `privzeto ${eur(c)}${u === 'tc' ? ` (${mocTC(D, Q0)} kW)` : u === 'pv' ? ` (${nf(kw!, kw! % 1 ? 1 : 0)} kW)` : ''}`;
      });
      const poz = v.tip === 'blok' ? 'po pozivih 2025 in 2026' : 'po pozivu 2026';
      $('sms-leg1').textContent = n.spodbuda == null ? `s spodbudo ${poz}` : `s spodbudo ${nf(n.spodbuda * 100)} %`;
      $('sms-leg2').textContent = `po predlogu NPS 2050 (${nps(r.bonus)}${r.celovita ? ', celovita prenova' : ''})`;
      $('sms-odk-o').textContent = `${nf(Number($<HTMLInputElement>('sms-odk').value))} c/kWh`;
      $('sms-rast-o').textContent = `${nf(Number($<HTMLInputElement>('sms-rast').value), 1)} %`;
      const co2 = Number($<HTMLInputElement>('sms-ets').value);
      $('sms-ets-o').textContent = co2 ? `${nf(co2)} €/t (olje +${nf(co2 * D.model.ets2.emisije_kg_kwh.kurilno_olje / 1000 * D.model.ets2.ddv * 100, 1)} c/kWh)` : 'brez';
      ['pel', 'pen', 'cst'].forEach((k) => { const x = Number($<HTMLInputElement>(`sms-${k}`).value); $(`sms-${k}-o`).textContent = x ? `${x > 0 ? '+' : ''}${x} %` : 'privzeto'; });
      $<HTMLInputElement>('sms-sp').disabled = $<HTMLInputElement>('sms-sp-n').disabled = $<HTMLInputElement>('sms-poziv').checked;

      // opozorila: najprej učinkovita raba energije, nato obnovljivi viri
      const op = opozorila(D, v, n, r), ure = $('sms-ure');
      ure.hidden = !op.length;
      ure.innerHTML = op.length ? `<h4>Najprej zmanjšajte potrebo po energiji</h4>${op.map((o) => `<p>${o.besedilo}</p>`).join('')}<button type="button" class="btn" data-dodaj-ovoj>Dodaj izolacijo fasade in stropa ter primerjaj</button>` : '';
      ure.querySelector('[data-dodaj-ovoj]')?.addEventListener('click', () => {
        ['fasada', 'plosca_podstrehe'].forEach((u) => { root.querySelector<HTMLInputElement>(`.sms-uk input[value="${u}"]`)!.checked = true; });
        run();
      });
      izrisiPV(r);
      out.replaceChildren();
      if (!r.rezultati.length) { if (!r.pv) out.append(Object.assign(document.createElement('p'), { className: 'sms-help', textContent: 'Izberite vsaj en ukrep.' })); pkt.replaceChildren(); izrisiNacrt(v, n); izrisiIzpis(v, n); return; }
      const ax = document.createElement('div'); ax.className = 'sms-axis'; ax.setAttribute('aria-hidden', 'true');
      ax.innerHTML = `<span></span><span class="ax">${[0, 10, 20, 30, 40, 50].map((y) => `<span style="left:${pos(y)}">${y}${y === 50 ? '+ let' : ''}</span>`).join('')}</span>`;
      out.append(ax);
      const lines: string[] = [];
      for (const x of r.rezultati as Rezultat[]) {
        const row = document.createElement('div'); row.className = 'sms-row';
        const lbl = x.doba.map(let_);
        const opis = `${x.ime}: brez spodbude ${lbl[0]}, ${n.spodbuda == null ? poz : `s spodbudo ${nf(n.spodbuda * 100)} %`} ${lbl[1]}, po predlogu NPS ${lbl[2]}; življenjska doba ${x.zivljenjska_doba} let.`;
        lines.push(`– ${opis} Strošek ${eur(x.strosek)}, prihranek ${nf(Math.round(x.prihranek_eur / 10) * 10)} € na leto.`);
        const marks = x.doba.map((d, i) => d == null ? '' : `<i class="mk c${i}" style="left:${pos(d)}" title="${['brez spodbude', 'z izbrano spodbudo', 'po predlogu NPS'][i]}: ${let_(d)}"></i>`).join('');
        row.innerHTML = `<div><h4>${x.ime}</h4><p class="sms-meta">strošek ${eur(x.strosek)} · spodbuda ${eur(x.spodbuda_izbrana)} (NPS ${eur(x.spodbuda_nps)}) · prihranek ${x.prihranek_eur > 0 ? `${nf(Math.round(x.prihranek_eur / 10) * 10)} € na leto` : 'ni prihranka'}</p></div>
          <div class="sms-track" role="img" aria-label="${opis}"><span class="axis"></span><span class="life" style="width:${pos(x.zivljenjska_doba)}"></span><span class="lifel" style="left:${pos(x.zivljenjska_doba)}">življenjska doba ${x.zivljenjska_doba} let</span>${marks}${x.doba.some((d) => d != null && d > MAX) ? '<span class="over">več kot 50 let →</span>' : ''}</div>
          <p class="sms-vals"><span>○ brez: <b>${lbl[0]}</b></span><span>■ ${n.spodbuda == null ? (v.tip === 'blok' ? 'poziva' : 'poziv 2026') : `${nf(n.spodbuda * 100)} %`}: <b>${lbl[1]}</b></span><span>▲ NPS: <b>${lbl[2]}</b></span></p>`;
        if (x.doba[0] == null || (x.doba[1] ?? Infinity) > x.zivljenjska_doba) {
          const w = document.createElement('p'); w.className = 'sms-warn';
          w.textContent = x.doba[0] == null ? 'Prihranka ni: sedanje ogrevanje je cenejše od ogrevanja s toplotno črpalko. Motiv sta udobje in manj dela z gorivom.' : 'Se energetsko ne povrne v življenjski dobi – motiv sta udobje in zdravje.';
          row.append(w);
        }
        if (x.ukrep === 'tc' && x.moc_brez_ovoja_kw && x.moc_kw && x.moc_kw < x.moc_brez_ovoja_kw) {
          const t = document.createElement('p'); t.className = 'sms-tcnote';
          t.textContent = `Z ukrepi na ovoju potrebujete toplotno črpalko za okoli ${x.moc_kw} kW namesto ${x.moc_brez_ovoja_kw} kW, nakup je okoli ${eur((x.strosek_brez_ovoja ?? 0) - x.strosek)} cenejši. Zato najprej ovoj, nato črpalka.`;
          row.append(t);
        }
        const det = document.createElement('details');
        det.innerHTML = `<summary>Od kod ta številka</summary><p>${x.formula}. Povračilna doba = (strošek − spodbuda) ÷ letni prihranek = (${nf(Math.round(x.strosek))} − ${nf(Math.round(x.spodbuda_izbrana))}) ÷ ${nf(Math.round(x.prihranek_eur))}. Spodbuda po pozivu 126SUB-OB26: ${eur(x.spodbuda_poziv)}; po predlogu NPS (N1): ${eur(x.spodbuda_nps)}.</p>`;
        row.append(det);
        out.append(row);
      }
      const P = r.paket, pl = P.doba.map(let_);
      pkt.innerHTML = r.rezultati.length > 1 ? `<h4>Paket izbranih ukrepov</h4>
        <p class="k"><b>${eur(P.strosek)}</b><span>skupni strošek</span></p>
        <p class="k"><b>${eur(P.spodbuda)}</b><span>spodbuda ${n.spodbuda == null ? poz : `${nf(n.spodbuda * 100)} %`} (po predlogu NPS ${eur(P.spodbuda_nps)})</span></p>
        <p class="k"><b>${nf(Math.round(P.prihranek_eur / 10) * 10)} € na leto</b><span>manj za ogrevanje (danes okoli ${nf(Math.round(P.stroski_danes / 10) * 10)} €)</span></p>
        <p class="k"><b>${pl[1]}</b><span>povračilna doba paketa (brez spodbude ${pl[0]}, po predlogu NPS ${pl[2]})</span></p>
        <p class="brez">Povračilna doba paketa ni vsota povračilnih dob ukrepov: je skupni strošek, zmanjšan za spodbudo, deljen s skupnim letnim prihrankom.${P.brez ? ` Brez ukrepov, ki se v življenjski dobi ne povrnejo (${P.brez.ukrepi.map((u: string) => r.rezultati.find((x: any) => x.ukrep === u)?.ime.toLowerCase()).join(', ')}), bi se paket za ${eur(P.brez.strosek)} povrnil v <b>${let_(P.brez.doba[1])}</b> (po predlogu NPS ${let_(P.brez.doba[2])}).` : ''}</p>` : '';
      izrisiNacrt(v, n);
      izrisiIzpis(v, n);
      povzetek = [`Se mi splača? ${v.tip === 'blok' ? 'Stanovanje v bloku' : 'Hiša'} ${v.povrsina} m², ${$<HTMLSelectElement>('sms-ob').selectedOptions[0].text}, izolacija: ${$<HTMLSelectElement>('sms-st').selectedOptions[0].text}, ogrevanje: ${$<HTMLSelectElement>('sms-en').selectedOptions[0].text}.`,
        ...lines, r.pv ? `– Sončna elektrarna ${nf(r.pv.kw, r.pv.kw % 1 ? 1 : 0)} kW, ${eur(r.pv.strosek)}: povračilna doba ${OB.map((o) => `${OBI[o]} ${let_(r.pv.rezimi[o].doba)}`).join(', ')}.` : '', r.rezultati.length > 1 ? `Paket: strošek ${eur(P.strosek)}, spodbuda ${eur(P.spodbuda)}, prihranek ${nf(Math.round(P.prihranek_eur / 10) * 10)} € na leto, povračilna doba ${pl[1]}.` : '',
        'Ocena za orientacijo (strokovne podlage NPS 2050, IJS CEU); spodbude NPS so predlog. ' + location.href.split('#')[0] + '#se-mi-splaca'].filter(Boolean).join('\n');
    }

    root.querySelectorAll('select, input[type=checkbox], [data-own], #sms-raba, #sms-pvkw, #sms-gosp').forEach((el) => el.addEventListener('input', run));
    $('sms-npri').addEventListener('click', () => { Object.assign(leta, PRIPOROCEN); run(); });
    $('sms-nvse').addEventListener('click', () => { (Object.keys(leta) as Ukrep[]).forEach((u) => { leta[u] = 0; }); run(); });
    root.querySelectorAll('select, input[type=checkbox]').forEach((el) => el.addEventListener('change', run));
    ['sms-a', 'sms-pel', 'sms-pen', 'sms-cst', 'sms-sp', 'sms-odk', 'sms-rast', 'sms-ets'].forEach(pair);
    $('sms-copy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(povzetek); $('sms-copied').textContent = 'Povzetek je kopiran.'; } catch { $('sms-copied').textContent = 'Kopiranje ni uspelo.'; }
    });
    run();
  }
</script>
