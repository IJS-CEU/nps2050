---
/** Pas »Preverite svojo stavbo« na naslovni strani: obrazec pošlje vrsto stavbe in primarno energijo na /preveri-stavbo/. */
import { pageUrl } from '../../i18n/routes';
import { loadData, type StavbniFond } from '../../lib/data';

const d = loadData<StavbniFond>('stavbni_fond');
---
<section class="hp" aria-labelledby="hp-t">
  <div class="hp-text">
    <p class="hp-kicker">Orodje</p>
    <h2 id="hp-t">Preverite svojo stavbo</h2>
    <p>Vnesite podatek iz energetske izkaznice in poglejte, v kateri razred sodi stavba in katere pragove iz osnutka izpolnjuje.</p>
  </div>
  <form class="hp-form" method="get" action={pageUrl('preveri')}>
    <label class="hp-f"><span>Vrsta stavbe</span>
      <select name="kat" required>
        <option value="">– izberite –</option>
        <optgroup label="Stanovanjske">{d.categories.filter((c) => c.segment === 'stanovanjske').map((c) => <option value={c.id}>{c.name}</option>)}</optgroup>
        <optgroup label="Nestanovanjske">{d.categories.filter((c) => c.segment !== 'stanovanjske').map((c) => <option value={c.id}>{c.name}</option>)}</optgroup>
      </select>
    </label>
    <label class="hp-f"><span>Primarna energija [kWh/(m²·a)]</span>
      <input name="pe" type="number" inputmode="decimal" min="1" max="3000" step="any" required placeholder="npr. 250" />
    </label>
    <button type="submit" class="btn primary">Preveri</button>
  </form>
</section>

<style>
  .hp { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 1rem 2rem; align-items: end; background: var(--greenbg); border-radius: 16px; padding: 1.5rem 1.6rem; margin: 0 0 2.6rem; }
  @media (max-width: 820px) { .hp { grid-template-columns: 1fr; } }
  .hp-kicker { font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--green); margin: 0 0 .3rem; }
  .hp h2 { font-size: 1.45rem; margin: 0 0 .4rem; }
  .hp-text p:last-child { color: var(--ink2); margin: 0; font-size: .95rem; }
  .hp-form { display: flex; flex-wrap: wrap; gap: .7rem; align-items: end; }
  .hp-f { display: grid; gap: .25rem; font-size: .8rem; font-weight: 700; color: var(--ink2); flex: 1 1 11rem; }
  .hp-f select, .hp-f input { font: inherit; font-size: .95rem; font-weight: 500; padding: .5rem .6rem; border: 1px solid var(--ink2); border-radius: 8px; background: var(--panel); color: var(--ink); width: 100%; }
  .hp .btn { cursor: pointer; font: inherit; font-weight: 700; padding: .55rem 1.3rem; }
</style>
