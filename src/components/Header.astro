---
import { pageUrl, type PageId } from '../i18n/routes';
import { nav, ui as t } from '../i18n/ui';

interface Props { page?: PageId; }
const { page } = Astro.props;
const items = Object.entries(nav) as [PageId, string][];
---
<header class="top">
  <div class="wrap bar">
    <a class="brand" href={pageUrl('domov')}>
      <span class="mark" aria-hidden="true">N</span>
      <span>{t.siteName}<small>{t.siteSub}</small></span>
    </a>
    <div class="tools">
      <button class="iconbtn" id="themebtn" type="button" data-dark={t.themeToDark} data-light={t.themeToLight} aria-label={t.themeToDark}>
        <svg class="ic-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
        <svg class="ic-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
      </button>
      <button class="iconbtn menubtn" id="menubtn" type="button" aria-expanded="false" aria-controls="mainnav">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>{t.menu}</span>
      </button>
    </div>
    <nav id="mainnav" aria-label={t.mainNav}>
      <ul>
        {items.map(([id, label]) => (
          <li><a href={pageUrl(id)} aria-current={id === page ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeBtn = document.getElementById('themebtn') as HTMLButtonElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches);
  const sync = () => {
    const dark = isDark();
    themeBtn.setAttribute('aria-label', dark ? themeBtn.dataset.light! : themeBtn.dataset.dark!);
    themeBtn.classList.toggle('is-dark', dark);
  };
  themeBtn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('nps-theme', next); } catch {}
    sync();
    window.dispatchEvent(new CustomEvent('nps-theme', { detail: next }));
  });
  mq.addEventListener('change', () => { sync(); window.dispatchEvent(new CustomEvent('nps-theme')); });
  sync();

  const menuBtn = document.getElementById('menubtn') as HTMLButtonElement;
  const navEl = document.getElementById('mainnav')!;
  menuBtn.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') !== 'true';
    menuBtn.setAttribute('aria-expanded', String(open));
    navEl.classList.toggle('open', open);
  });
</script>

<style>
  .top { position: sticky; top: 0; background: var(--bg); border-bottom: 1px solid var(--line); z-index: 10; }
  .bar { display: flex; align-items: center; gap: .6rem 1rem; flex-wrap: wrap; padding-block: .7rem; }
  .brand { display: flex; align-items: center; gap: .7rem; font-weight: 700; letter-spacing: .01em; color: var(--ink); text-decoration: none; min-width: 0; }
  .brand .mark { width: 34px; height: 34px; flex: none; border-radius: 8px; background: var(--green); color: var(--on-green); display: grid; place-items: center; font-family: var(--font-serif); font-size: 1rem; }
  .brand small { display: block; font-weight: 500; color: var(--ink2); font-size: .75rem; letter-spacing: .02em; max-width: 21em; line-height: 1.3; }
  .tools { display: flex; gap: .4rem; align-items: center; margin-left: .4rem; order: 3; }
  nav { order: 2; margin-left: auto; }
  nav ul { list-style: none; margin: 0; padding: 0; max-width: none; display: flex; gap: .2rem .9rem; flex-wrap: nowrap; white-space: nowrap; font-size: .88rem; font-weight: 600; }
  nav a { color: var(--ink2); text-decoration: none; padding: .3rem 0; display: inline-block; }
  nav a:hover { color: var(--green); }
  nav a[aria-current='page'] { color: var(--green); box-shadow: inset 0 -2px 0 var(--green); }
  .iconbtn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 999px; padding: .3rem .7rem; font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: .35rem; min-height: 32px; }
  .iconbtn .ic-sun { display: none; }
  .iconbtn.is-dark .ic-sun { display: inline; }
  .iconbtn.is-dark .ic-moon { display: none; }
  .menubtn { display: none; }

  @media (max-width: 1100px) {
    nav { order: 4; flex-basis: 100%; margin-left: 0; }
    :global(html.js) .menubtn { display: inline-flex; }
    :global(html.js) nav { display: none; }
    :global(html.js) nav.open { display: block; }
    .tools { margin-left: auto; }
    nav ul { flex-direction: column; gap: 0; padding-block: .3rem .5rem; font-size: 1rem; white-space: normal; }
    nav a { padding: .55rem 0; }
    .brand small { display: none; }
  }
</style>
