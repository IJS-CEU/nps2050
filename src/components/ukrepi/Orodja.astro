---
/** Ikonografika »Pet vrst orodij«: število ukrepov po vrsti (iz ukrepi.json) in primera; klik vklopi filter v pregledovalniku. */
import Icon from '../Icon.astro';
import { loadData, type Ukrepi } from '../../lib/data';

const d = loadData<Ukrepi>('ukrepi');
const count = (k: string) => d.measures.filter((m) => m.kinds.includes(k)).length;
// Primeri so ukrepi iz osnutka (pogl. 6); ikona in kratko ime vrste.
const META: Record<string, { icon: string; short: string; ex: string }> = {
  predpis: { icon: 'scale', short: 'Predpisi', ex: 'posodobitev PURES, prepovedi vgradnje fosilnih kotlov, minimalni standardi' },
  finance: { icon: 'euro', short: 'Finančne spodbude', ex: 'stopnjevane spodbude Eko sklada (N1), garancijska shema, energetsko pogodbeništvo' },
  svetovanje: { icon: 'messages-square', short: 'Svetovanje in obveščanje', ex: 'mreža ENSVET, točke »vse na enem mestu« (N18), obveščanje lastnikov (N3)' },
  organizacija: { icon: 'settings-2', short: 'Organizacija in pilotni projekti', ex: 'projektni pisarni za celovito prenovo, serijska prenova blokov (N8)' },
  spremljanje: { icon: 'chart-line', short: 'Spremljanje in podatki', ex: 'seznam najslabših javnih stavb (N14), kazalnik ciljanosti prenov (N4)' },
};
---
<section class="orodja" aria-labelledby="or-t">
  <h3 id="or-t">Pet vrst orodij</h3>
  <p class="or-lead">Število ukrepov po vrsti. Ukrep ima lahko več vrst, zato se števila ne seštejejo v {d.measures.length}.</p>
  <ul class="or-grid">
    {d.kinds.map((k) => (
      <li>
        <a class="or-card" href="#pregled-ukrepov" data-kind={k.id} aria-label={`${k.name}: ${count(k.id)} ukrepov. Prikaži te ukrepe v pregledu.`}>
          <span class="or-icon"><Icon name={META[k.id].icon} size={26} /></span>
          <span class="or-n">{count(k.id)}</span>
          <span class="or-name">{META[k.id].short}</span>
          <span class="or-ex">{META[k.id].ex}</span>
          <span class="or-go" aria-hidden="true">Prikaži ukrepe →</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .orodja { margin: 1.4rem 0 2.2rem; }
  .orodja h3 { margin: 0 0 .2rem; }
  .or-lead { color: var(--ink2); font-size: .88rem; }
  .or-grid { list-style: none; padding: 0; margin: .8rem 0 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .8rem; }
  .or-card { height: 100%; display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto 1fr auto; gap: .2rem .7rem; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.1rem; text-decoration: none; color: var(--ink); transition: border-color .15s, transform .15s; }
  .or-card:hover, .or-card:focus-visible { border-color: var(--green); transform: translateY(-2px); }
  .or-icon { grid-row: 1 / 3; width: 3rem; height: 3rem; border-radius: 12px; display: grid; place-items: center; background: var(--greenbg); color: var(--green); }
  .or-n { font-size: 1.9rem; font-weight: 800; line-height: 1; color: var(--green); }
  .or-name { font-weight: 700; font-size: .92rem; line-height: 1.25; }
  .or-ex { grid-column: 1 / -1; font-size: .82rem; color: var(--ink2); margin-top: .5rem; line-height: 1.4; }
  .or-go { grid-column: 1 / -1; font-size: .8rem; font-weight: 700; color: var(--green); margin-top: .5rem; }
  @media (prefers-reduced-motion: reduce) { .or-card { transition: none; } .or-card:hover { transform: none; } }
</style>

<script>
  // Klik na ploščico nastavi filter »Vrsta ukrepa« v pregledovalniku in se pomakne tja.
  document.querySelectorAll<HTMLAnchorElement>('.or-card').forEach((a) => a.addEventListener('click', () => {
    const sel = document.getElementById('up-kind') as HTMLSelectElement | null;
    if (!sel) return;
    sel.value = a.dataset.kind!;
    sel.dispatchEvent(new Event('input'));
  }));
</script>
