---
/**
 * Preverjanje stavbe: razred na lestvici primarne energije, minimalni standardi (nestanovanjske stavbe) in
 * skupina 43 % najmanj učinkovitih (stanovanjske stavbe). Pragovi iz public/data/stavbni_fond.json (osnutek NPS 2050).
 * Za hiše in bloke še stanje po delni, celoviti in ZEB prenovi (public/data/paketi_prenove.json). Brez izkaznice: ocena po tipičnih
 * stavbah iz izkaznic (public/data/arhetipi.json, CLAUDE.md §11.6).
 * Brez JS: preglednica pragov po kategorijah.
 */
import { loadData, type StavbniFond } from '../lib/data';
import { nf } from '../lib/format';
import { features } from '../config/features';
import { pageUrl } from '../i18n/routes';

const d = loadData<StavbniFond>('stavbni_fond');
const bounds = ['A|B', 'B|C', 'C|D', 'D|E', 'E|F', 'F|G'];
const ar = loadData<{ obdobja: string[] }>('arhetipi');
---
<section class="chk" id="preveri" aria-labelledby="chk-t">
  <h2 id="chk-t" class="visually-hidden">Preverite stavbo</h2>
  <form class="chk-form js-only" id="chk-form" novalidate>
    <fieldset class="chk-field chk-mode">
      <legend>Kako želite preveriti stavbo?</legend>
      <label><input type="radio" name="chk-mode" value="ei" checked /> Imam energetsko izkaznico</label>
      <label><input type="radio" name="chk-mode" value="tip" /> Nimam izkaznice – ocena po tipični stavbi</label>
    </fieldset>
    <div class="chk-ei">
    <div class="chk-field">
      <label for="chk-cat">Vrsta stavbe</label>
      <select id="chk-cat" required>
        <option value="">– izberite –</option>
        <optgroup label="Stanovanjske stavbe">
          {d.categories.filter((c) => c.segment === 'stanovanjske').map((c) => <option value={c.id}>{c.name}</option>)}
        </optgroup>
        <optgroup label="Nestanovanjske stavbe">
          {d.categories.filter((c) => c.segment !== 'stanovanjske').map((c) => <option value={c.id}>{c.name}</option>)}
        </optgroup>
      </select>
    </div>
    <div class="chk-field">
      <label for="chk-pe">Primarna energija iz energetske izkaznice</label>
      <div class="chk-unit"><input id="chk-pe" type="number" inputmode="decimal" min="0" max="3000" step="any" required aria-describedby="chk-pe-help" /><span>kWh/(m²·a)</span></div>
      <p class="chk-help" id="chk-pe-help">Letna raba primarne energije na enoto uporabne površine, ki je navedena v računski energetski izkaznici.</p>
    </div>
    </div>
    <div class="chk-tip" hidden>
      <div class="chk-field"><label for="chk-t-tip">Vrsta stavbe</label>
        <select id="chk-t-tip"><option value="HISA">Enostanovanjska hiša</option><option value="BLOKI">Stanovanje v večstanovanjski stavbi (bloku)</option></select></div>
      <div class="chk-field"><label for="chk-t-per">Leto gradnje</label>
        <select id="chk-t-per">{ar.obdobja.map((o) => <option value={o}>{o}</option>)}</select></div>
      <div class="chk-field"><label for="chk-t-ovoj">Toplotna izolacija</label>
        <select id="chk-t-ovoj"><option value="neizolirano">Ni izolirana</option><option value="delno">Delno (npr. samo streha ali podstrešje)</option><option value="izolirano">Izolirana fasada</option></select></div>
      <div class="chk-field"><label for="chk-t-okna">Okna zamenjana po letu 2010</label>
        <select id="chk-t-okna"><option value="ne">Ne</option><option value="da">Da</option></select></div>
      <div class="chk-field"><label for="chk-t-og">Glavno ogrevanje</label>
        <select id="chk-t-og"><option value="olje">Kurilno olje</option><option value="plin">Zemeljski plin</option><option value="les">Les (drva, peleti, sekanci)</option><option value="tc">Toplotna črpalka</option><option value="daljinsko">Daljinsko ogrevanje</option><option value="elektrika">Elektrika (neposredno)</option></select></div>
      <p class="chk-help">Ocena temelji na tipičnih stavbah z enakimi lastnostmi iz registra energetskih izkaznic. Dejanski razred določi energetska izkaznica.</p>
    </div>
    <fieldset class="chk-field">
      <legend>Ali je stavba kulturna dediščina?</legend>
      <label><input type="radio" name="chk-dd" value="ne" checked /> Ne (ali le v vplivnem območju dediščine)</label>
      <label><input type="radio" name="chk-dd" value="dediscina" /> Registrirana stavbna ali naselbinska dediščina</label>
      <label><input type="radio" name="chk-dd" value="spomenik" /> Spomenik državnega ali lokalnega pomena</label>
    </fieldset>
    <button type="submit" class="btn primary">Preveri</button>
  </form>

  <div class="chk-out" id="chk-out" aria-live="polite"></div>
  {features.paketi && <p class="chk-pk"><a href={pageUrl('paketi')}>Tipični paketi prenove: koliko stane in kaj prinese delna, celovita ali celovita ZEB prenova</a></p>}

  <noscript><p>Za interaktivno preverjanje je potreben JavaScript. Pragovi so v preglednici spodaj.</p></noscript>

  <details class="chk-table">
    <summary>Pragovi po vrstah stavb (preglednica)</summary>
    <div class="tblwrap" tabindex="0" role="region" aria-label="Pragovi po vrstah stavb">
      <table>
        <caption class="visually-hidden">Meje energijskih razredov in pragovi po vrstah stavb, kWh/(m²·a) primarne energije</caption>
        <thead><tr><th scope="col">Vrsta stavbe</th>{bounds.map((b) => <th scope="col" class="num">{b.replace('|', ' | ')}</th>)}<th scope="col" class="num">Prag 2030</th><th scope="col" class="num">Prag 2033</th><th scope="col" class="num">Prag 43 %</th></tr></thead>
        <tbody>
          {d.categories.map((c) => (
            <tr><th scope="row">{c.name}{c.meps?.indicative ? ' *' : ''}</th>{bounds.map((b) => <td class="num">{nf(c.class_bounds[b])}</td>)}
              <td class="num">{c.meps ? nf(c.meps.threshold_2030) : '–'}</td><td class="num">{c.meps ? nf(c.meps.threshold_2033) : '–'}</td><td class="num">{c.worst_43 ? nf(c.worst_43.threshold) : '–'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="note">Meje razredov 2025 in pragovi iz osnutka NPS 2050 (poglavji 3 in 4.7). Prag 2030/2033: minimalni standardi za nestanovanjske stavbe. Prag 43 %: meja skupine 43 % energetsko najmanj učinkovitih stanovanjskih stavb. * Majhen vzorec izkaznic, pragovi so okvirni.</p>
  </details>

</section>

<style>
  .chk { margin: 1rem 0 2rem; max-width: 72ch; }
  .chk-form { display: grid; gap: 1rem; background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1.2rem 1.3rem; }
  .chk-field { display: grid; gap: .3rem; border: 0; padding: 0; margin: 0; }
  .chk-field > label, .chk-field legend { font-weight: 700; font-size: .92rem; }
  .chk-mode { display: flex; flex-wrap: wrap; gap: .3rem 1.4rem; }
  .chk-mode legend { width: 100%; }
  .chk-ei, .chk-tip { display: grid; gap: 1rem; }
  .chk-ei[hidden], .chk-tip[hidden] { display: none; }
  .chk-tip select { font: inherit; padding: .45rem .5rem; border: 1px solid var(--ink2); border-radius: 8px; background: var(--bg); color: var(--ink); max-width: 100%; }
  fieldset.chk-field label { font-size: .92rem; display: flex; gap: .45rem; align-items: baseline; }
  .chk select, .chk input[type=number] { font: inherit; padding: .45rem .55rem; border: 1px solid var(--ink2); border-radius: 6px; background: var(--bg); color: var(--ink); max-width: 100%; }
  .chk-unit { display: flex; gap: .5rem; align-items: center; }
  .chk-unit input { width: 9rem; }
  .chk-help { font-size: .82rem; color: var(--ink2); margin: 0; }
  .chk-opt { font-weight: 500; color: var(--ink2); }
  .chk .btn { justify-self: start; cursor: pointer; font: inherit; font-weight: 700; }
  .chk-out:not(:empty) { margin-top: 1.2rem; }
  .chk-table { margin-top: 1.4rem; }
  .chk-table summary { cursor: pointer; font-weight: 700; color: var(--green); }
  .chk-table table { font-size: .82rem; margin-top: .5rem; }
  .chk-table thead th { letter-spacing: 0; }
</style>

<style is:global>
  .chk-res { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 1.1rem 1.3rem; }
  .chk-res h3 { margin: 0 0 .6rem; }
  .chk-cls { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 8px; color: #fff; font-weight: 800; font-size: 1.3rem; margin-right: .6rem; vertical-align: middle; text-shadow: 0 1px 1px rgba(0,0,0,.35); }
  .chk-scale { position: relative; display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; margin: 1.6rem 0 3.4rem; }
  .chk-scale span { height: 14px; display: grid; place-items: center; }
  .chk-scale span:first-child { border-radius: 4px 0 0 4px; } .chk-scale span:last-child { border-radius: 0 4px 4px 0; }
  .chk-scale b { position: absolute; top: 18px; font-size: .72rem; color: var(--ink2); transform: translateX(-50%); font-weight: 700; }
  .chk-mark2 { position: absolute; top: 34px; transform: translateX(-50%); font-size: .75rem; font-weight: 800; color: var(--green); white-space: nowrap; font-style: normal; }
  .chk-mark2::before { content: ''; position: absolute; left: 50%; top: -20px; width: 2px; height: 18px; background: var(--green); transform: translateX(-50%); }
  .chk-po { border: 0; padding: 0; margin: 0 0 .3rem; display: flex; flex-wrap: wrap; gap: .3rem 1rem; font-size: .9rem; }
  .chk-po legend { font-weight: 800; font-size: .85rem; margin-bottom: .2rem; }
  .chk-po-t { margin: .2rem 0 .8rem; font-size: .92rem; }
  .chk-mark { position: absolute; top: -22px; transform: translateX(-50%); font-size: .75rem; font-weight: 800; color: var(--ink); white-space: nowrap; }
  .chk-mark::after { content: ''; position: absolute; left: 50%; top: 16px; width: 2px; height: 22px; background: var(--ink); transform: translateX(-50%); }
  .chk-tick { position: absolute; top: 14px; width: 2px; height: 10px; background: var(--ink2); transform: translateX(-50%); }
  .chk-res ul { padding-left: 1.2rem; margin: .4rem 0 .8rem; }
  .chk-res li { margin-bottom: .35rem; }
  .chk-ok { color: var(--green); font-weight: 700; }
  .chk-no { color: var(--amber); font-weight: 700; }
  .chk-ph, .chk-pf { display: none; }
  .chk-act { margin: .8rem 0 0; font-size: .88rem; color: var(--ink2); }
  .chk-act .btn { cursor: pointer; font: inherit; font-weight: 700; margin-right: .5rem; }
  /* Izpis rezultata: samo rezultat z vnosom in naslednjimi koraki (CLAUDE.md §11, nadgradnja 9). */
  @media print {
    body:has(.chk-res) :is(header.top, body > footer, .skip, .page-head, .chk-form, .chk-table, .chk-pk, .chk-act, .chk-po, .wrap.prose > :not(.chk)) { display: none !important; }
    body:has(.chk-res), body:has(.chk-res) main { background: #fff !important; }
    body:has(.chk-res) .chk { margin: 0; max-width: none; }
    body:has(.chk-res) .chk-res { border: 0; padding: 0; background: #fff; }
    .chk-ph, .chk-pf { display: block; }
    .chk-ph { border-bottom: 2px solid #D6B25E; margin-bottom: .8rem; padding-bottom: .4rem; }
    .chk-ph-k { font-size: .75rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #1E6B4E; margin: 0 0 .2rem; }
    .chk-ph-v { font-size: .85rem; margin: 0; }
    .chk-pf { border-top: 1px solid #ccc; margin-top: .8rem; padding-top: .4rem; font-size: .85rem; }
    .chk-pf h4 { margin: 0 0 .3rem; }
    .chk-res, .chk-scale span, .chk-cls { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  import { loadJson } from '../lib/load';
  import { nf } from '../lib/format';
  import type { Category, StavbniFond } from '../lib/data';

  const CLS = ['A', 'B', 'C', 'D', 'E', 'F', 'G'];
  const B = ['A|B', 'B|C', 'C|D', 'D|E', 'E|F', 'F|G'];
  const CLS_VAR: Record<string, string> = { A: 'A1', B: 'B1', C: 'C', D: 'D', E: 'E', F: 'F', G: 'G' };

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, cls?: string) {
    const e = document.createElement(tag);
    if (text !== undefined) e.textContent = text;
    if (cls) e.className = cls;
    return e;
  }

  const classOf = (c: Category, v: number) => {
    const i = B.findIndex((b) => v <= c.class_bounds[b]);
    return CLS[i === -1 ? 6 : i];
  };

  /** Položaj vrednosti na lestvici z enako širokimi razredi (0–1). */
  const pos = (c: Category, v: number) => {
    const edges = [0, ...B.map((b) => c.class_bounds[b])];
    edges.push(edges[6] * 1.35);
    const j = edges.findIndex((e, k) => k > 0 && v <= e);
    if (j === -1) return 1; // nad lestvico: na konec razreda G
    const i = j - 1, lo = edges[i], hi = edges[j];
    return (i + Math.min(1, Math.max(0, (v - lo) / (hi - lo)))) / 7;
  };

  function li(ul: HTMLElement, parts: (string | [string, string])[]) {
    const item = el('li');
    for (const p of parts) item.append(typeof p === 'string' ? document.createTextNode(p) : el('span', p[0], p[1]));
    ul.append(item);
  }


  async function init() {
    type Ar = { pe: number; p25: number; p75: number; od: string; do: string; n: number; osnova: string };
    const [d, ar, pk] = await Promise.all([loadJson<StavbniFond>('stavbni_fond'), loadJson<{ kombinacije: Record<string, Ar>; nova_obdobja: string[] }>('arhetipi'), loadJson<{ preveri: Record<string, { delna_faktor: number; celovita_pe: number; zeb_pe: number | null }> }>('paketi_prenove')]);
    const form = document.getElementById('chk-form') as HTMLFormElement;
    const out = document.getElementById('chk-out')!;
    const cat = document.getElementById('chk-cat') as HTMLSelectElement;
    const pe = document.getElementById('chk-pe') as HTMLInputElement;
    const cs = getComputedStyle(document.documentElement);
    const $ = (id: string) => document.getElementById(id) as HTMLSelectElement;
    const mode = () => (form.querySelector('input[name="chk-mode"]:checked') as HTMLInputElement).value;
    const boxEi = form.querySelector<HTMLElement>('.chk-ei')!, boxTip = form.querySelector<HTMLElement>('.chk-tip')!;
    form.querySelectorAll<HTMLInputElement>('input[name="chk-mode"]').forEach((r) => r.addEventListener('change', () => {
      boxEi.hidden = mode() !== 'ei'; boxTip.hidden = mode() !== 'tip'; out.replaceChildren();
    }));
    const syncNew = () => {
      const nov = ar.nova_obdobja.includes($('chk-t-per').value);
      $('chk-t-ovoj').disabled = nov; $('chk-t-okna').disabled = nov;
      if (nov) { $('chk-t-ovoj').value = 'izolirano'; $('chk-t-okna').value = 'da'; }
    };
    $('chk-t-per').addEventListener('change', syncNew);

    // Obrazec na naslovni strani pošlje ?kat=…&pe=… – izpolni polji in takoj preveri.
    const q = new URLSearchParams(location.search);
    const pre = () => {
      if (q.get('kat') && q.get('pe')) {
        cat.value = q.get('kat')!;
        pe.value = q.get('pe')!;
        form.requestSubmit();
      }
    };

    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      out.replaceChildren();
      let c: Category | undefined, v: number, est: Ar | null = null;
      if (mode() === 'tip') {
        c = d.categories.find((x) => x.id === $('chk-t-tip').value)!;
        est = ar.kombinacije[[c.id, $('chk-t-per').value, $('chk-t-ovoj').value, $('chk-t-okna').value, $('chk-t-og').value].join('|')] ?? null;
        if (!est) { out.append(el('p', 'Za to kombinacijo ni ocene, ker je v registru premalo podobnih stavb z izkaznico. Za oceno se obrnite na energetskega svetovalca ENSVET.', 'chk-no')); return; }
        v = est.pe;
      } else {
        c = d.categories.find((x) => x.id === cat.value);
        v = Number(String(pe.value).replace(',', '.'));
        if (!c || !pe.value || !Number.isFinite(v) || v <= 0) {
          out.append(el('p', 'Izberite vrsto stavbe in vnesite primarno energijo iz izkaznice (število, večje od 0).', 'chk-no'));
          (c ? pe : cat).focus();
          return;
        }
      }
      const dd = (form.querySelector('input[name="chk-dd"]:checked') as HTMLInputElement).value;
      const k = classOf(c, v);
      const box = el('div', undefined, 'chk-res');
      const opt = (id: string) => $(id).selectedOptions[0]?.textContent ?? '';
      const ddTxt = (form.querySelector('input[name="chk-dd"]:checked') as HTMLInputElement).parentElement!.textContent!.trim();
      const vnos = est
        ? `${opt('chk-t-tip')}, zgrajena ${opt('chk-t-per')}; izolacija: ${opt('chk-t-ovoj').toLowerCase()}; nova okna: ${opt('chk-t-okna').toLowerCase()}; ogrevanje: ${opt('chk-t-og').toLowerCase()}. Brez energetske izkaznice (ocena iz podobnih stavb).`
        : `${c.name}; ${nf(v, 0)} kWh/(m²·a) primarne energije iz računske energetske izkaznice.`;
      const ph = el('div', undefined, 'chk-ph');
      ph.append(el('p', 'NPS 2050 · Strokovne podlage IJS CEU · Preverite svojo stavbo', 'chk-ph-k'),
        el('p', `Izpis z dne ${new Date().toLocaleDateString('sl-SI')}. Vnos: ${vnos} Kulturna dediščina: ${ddTxt.toLowerCase()}.`, 'chk-ph-v'));
      box.append(ph);
      const h = el('h3');
      const badge = el('span', k, 'chk-cls');
      badge.style.background = cs.getPropertyValue(`--cls-${CLS_VAR[k]}`).trim();
      badge.setAttribute('aria-hidden', 'true');
      h.append(badge, document.createTextNode(est
        ? `Verjetno razred ${est.od === est.do ? est.od : `${est.od}–${est.do}`} (tipično okoli ${nf(v, 0)} kWh/(m²·a), ${c.name.toLowerCase()})`
        : `Razred ${k} (${nf(v, 0)} kWh/(m²·a), ${c.name.toLowerCase()})`));
      box.append(h);

      // Lestvica razredov z oznako vrednosti in pragov
      const scale = el('div', undefined, 'chk-scale');
      scale.setAttribute('aria-hidden', 'true');
      CLS.forEach((x, i) => {
        const s = el('span'); s.style.background = cs.getPropertyValue(`--cls-${CLS_VAR[x]}`).trim(); scale.append(s);
        const lab = el('b', x); lab.style.left = `${((i + 0.5) / 7) * 100}%`; scale.append(lab);
      });
      const mark = el('i', `${nf(v, 0)}`, 'chk-mark'); mark.style.left = `${pos(c, v) * 100}%`; scale.append(mark);
      if (c.meps) for (const t of [c.meps.threshold_2030, c.meps.threshold_2033]) { const tk = el('i', undefined, 'chk-tick'); tk.style.left = `${pos(c, t) * 100}%`; scale.append(tk); }
      box.append(scale);
      if (est) box.append(el('p', `Ocena na podlagi ${est.n} podobnih stavb z izkaznico${est.osnova === 'polna' ? '' : ` (${est.osnova === 'brez oken' ? 'brez upoštevanja oken' : 'brez upoštevanja izolacije in oken'})`}: polovica jih ima med ${nf(est.p25, 0)} in ${nf(est.p75, 0)} kWh/(m²·a). Ocena na podlagi tipičnih stavb. Dejanski razred določi energetska izkaznica.`, 'note'));

      // Stanje po prenovi (hiše in bloki): delna, celovita, celovita ZEB – drugi oznaka na lestvici
      const po = pk.preveri[c.id];
      if (po) {
        const opts: [string, string, number][] = [['delna', 'po delni prenovi (fasada, okna)', v * po.delna_faktor],
          ['celovita', c.id === 'HISA' ? 'po celoviti prenovi (ovoj, toplotna črpalka, prezračevanje)' : 'po celoviti prenovi (ovoj, prezračevanje, daljinsko ogrevanje)', Math.min(v, po.celovita_pe)]];
        if (po.zeb_pe !== null) opts.push(['zeb', 'po celoviti ZEB prenovi (še izolacija tal, sončna elektrarna)', Math.min(v, po.zeb_pe)]);
        const fs = el('fieldset', undefined, 'chk-po');
        fs.append(el('legend', 'Stanje po prenovi'));
        const txt = el('p', undefined, 'chk-po-t');
        txt.setAttribute('aria-live', 'polite');
        const mark2 = el('i', '', 'chk-mark2');
        mark2.hidden = true;
        scale.append(mark2);
        const set = (id: string) => {
          const o = opts.find((x) => x[0] === id);
          if (!o) { mark2.hidden = true; txt.textContent = ''; return; }
          const k2 = classOf(c, o[2]);
          mark2.hidden = false;
          mark2.textContent = `${nf(o[2], 0)} · ${k2}`;
          mark2.style.left = `${pos(c, o[2]) * 100}%`;
          txt.replaceChildren(`Ocena ${o[1]}: okoli ${nf(o[2], 0)} kWh/(m²·a), `, el('b', `razred ${k2}`), '.');
        };
        for (const [id, lab] of [['ne', 'brez prenove'], ...opts.map((o) => [o[0], { delna: 'delna', celovita: 'celovita', zeb: 'celovita ZEB' }[o[0]]!])] as [string, string][]) {
          const l = el('label');
          const r = document.createElement('input');
          r.type = 'radio'; r.name = 'chk-po'; r.value = id; r.checked = id === 'ne';
          r.addEventListener('change', () => set(id));
          l.append(r, document.createTextNode(` ${lab}`));
          fs.append(l);
        }
        box.append(fs, txt);
      }

      const ul = el('ul');
      // Ciljni razred do leta 2050: A (brezemisijska stavba) za vse stavbe, C za stavbe kulturne dediščine.
      const goal = (): (string | [string, string])[] => {
        const dk = dd !== 'ne';
        const t = dk ? c.class_bounds['C|D'] : c.class_bounds['A|B'];
        return [`Ciljna raven prenove do leta 2050 je ${dk ? 'za stavbe kulturne dediščine najmanj razred C' : 'razred A – brezemisijska stavba'} (do ${nf(t)} kWh/(m²·a)) – `,
          v > t ? ['stavba je še nad to ravnjo.', 'chk-no'] : ['stavba jo že dosega.', 'chk-ok']];
      };
      if (c.meps) {
        const m = c.meps;
        if (dd === 'spomenik') {
          li(ul, ['Za spomenike se številčni pragovi minimalnih standardov ne uporabljajo. Velja obveznost enakovrednega izboljšanja: energetski pregled, izkaz o prenovi z ukrepi, združljivimi z varstvom, in do leta 2040 izboljšanje za najmanj en razred ali za 30 % manj primarne energije.']);
        } else {
          li(ul, ['Do leta 2030 (prag ', nf(m.threshold_2030), ' kWh/(m²·a)): ', v > m.threshold_2030 ? ['stavba prag presega – do leta 2030 mora doseči prag.', 'chk-no'] : ['stavba prag izpolnjuje.', 'chk-ok']]);
          li(ul, ['Do leta 2033 (prag ', nf(m.threshold_2033), ' kWh/(m²·a)): ', v > m.threshold_2033 ? ['stavba prag presega – do leta 2033 mora doseči prag.', 'chk-no'] : ['stavba prag izpolnjuje.', 'chk-ok']]);
          const t40 = c.class_bounds['D|E'];
          const t50 = dd === 'dediscina' ? c.class_bounds['C|D'] : c.class_bounds['B|C'];
          li(ul, ['Predlagan prag za leto 2040: najmanj razred D (', nf(t40), ' kWh/(m²·a)) – ', v > t40 ? ['stavba ga še ne dosega.', 'chk-no'] : ['stavba ga že dosega.', 'chk-ok']]);
          li(ul, [`Predlagan prag za leto 2050: najmanj razred ${dd === 'dediscina' ? 'C (za kulturno dediščino)' : 'B'} (`, nf(t50), ' kWh/(m²·a)) – ', v > t50 ? ['stavba ga še ne dosega.', 'chk-no'] : ['stavba ga že dosega.', 'chk-ok']]);
        }
        li(ul, goal());
        if (m.indicative) li(ul, ['Vzorec izkaznic je v tej kategoriji majhen, zato so pragovi okvirni.']);
        box.append(ul);
        box.append(el('p', 'Izjeme: stavbe za verske obrede, začasni objekti z rabo do dveh let, stavbe pod 50 m² ter industrijske in kmetijske stavbe. Posamezno izjemo (npr. predvidena rušitev, insolventnost lastnika, negativna ocena stroškov in koristi) odobri ministrstvo na vlogo lastnika.', 'note'));
      } else if (c.worst_43) {
        const w = c.worst_43;

        li(ul, v > w.threshold
          ? ['Stavba ', ['sodi med 43 % energetsko najmanj učinkovitih', 'chk-no'], ` stanovanjskih stavb (prag ${nf(w.threshold)} kWh/(m²·a)). Te stavbe imajo pri prenovi prednost in višje spodbude.`]
          : ['Stavba ', ['ne sodi', 'chk-ok'], ` med 43 % energetsko najmanj učinkovitih stanovanjskih stavb (prag ${nf(w.threshold)} kWh/(m²·a)).`]);
        li(ul, goal());
        li(ul, ['Obvezne prenove posamezne stanovanjske stavbe načrt ne določa. Priporočljivo je, da vsako prenovo načrtujete kot korak k brezemisijski stavbi.']);
        box.append(ul);
      }
      box.append(el('p', 'Rezultat je informativen in temelji na predlogu v osnutku NPS 2050. Ni uradna ugotovitev. Pragovi se lahko do sprejema načrta in ob rekalibraciji razredov še spremenijo.', 'note'));
      const pf = el('div', undefined, 'chk-pf');
      pf.append(el('h4', 'Naslednji koraki'));
      const nx = el('ol');
      for (const t of [
        'Brezplačno energetsko svetovanje ENSVET: svetovalec pregleda stavbo in pomaga izbrati ukrepe. Ta izpis vzemite s seboj.',
        'Spodbude Eko sklada (www.ekosklad.si): preverite pogoje javnega poziva; vlogo oddate po zaključku del, z računi in dokazili.',
        'Energetska izkaznica določi dejanski razred stavbe; potrebna je tudi ob prodaji ali oddaji.',
        `Tipični paketi prenove s stroški in spodbudami: ${location.origin}${document.querySelector<HTMLAnchorElement>('.chk-pk a')?.getAttribute('href') ?? ''}`,
      ]) nx.append(el('li', t));
      pf.append(nx, el('p', `Vir: IJS CEU, strokovne podlage NPS 2050 (osnutek). ${location.origin}${location.pathname}`, 'note'));
      box.append(pf);
      const act = el('p', undefined, 'chk-act');
      const pb = el('button', 'Natisni ali shrani kot PDF', 'btn');
      (pb as HTMLButtonElement).type = 'button';
      pb.addEventListener('click', () => window.print());
      act.append(pb, document.createTextNode(' Izpis z rezultatom in naslednjimi koraki, na primer za pogovor z energetskim svetovalcem.'));
      box.append(act);
      out.append(box);
      box.setAttribute('tabindex', '-1');
      box.focus();
    });
    pre();
  }
  if (document.getElementById('chk-form')) init().catch((e) => console.error('preveri:', e));
</script>
