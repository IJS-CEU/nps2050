---
/**
 * Pregled »Na tej strani«: kartice s povezavami na razdelke dolge strani (ikona, naslov, kratek opis).
 * Enak videz kot kazalo na straneh občin.
 */
import Icon from './Icon.astro';

interface Item { href: string; icon: string; label: string; hint: string }
interface Props { items: Item[]; title?: string }
const { items, title = 'Na tej strani' } = Astro.props;
---
<nav class="nts" aria-label={title}>
  <p class="nts-t">{title}</p>
  <ol>
    {items.map((t) => <li><a href={t.href}><span class="nts-i"><Icon name={t.icon} size={18} /></span><span><b>{t.label}</b><small>{t.hint}</small></span></a></li>)}
  </ol>
</nav>

<style>
  .nts { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 1rem 1.1rem 1.1rem; margin: 1rem 0 2.2rem; max-width: none; }
  .nts-t { font-size: .74rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--ink2); margin: 0 0 .6rem; }
  .nts ol { list-style: none; padding: 0; margin: 0; max-width: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: .5rem; }
  .nts li { margin: 0; }
  .nts a { display: flex; gap: .6rem; align-items: center; padding: .55rem .65rem; border-radius: 10px; text-decoration: none; color: var(--ink); border: 1px solid transparent; transition: background .12s, border-color .12s; height: 100%; }
  .nts a:hover, .nts a:focus-visible { background: var(--greenbg); border-color: var(--green); }
  .nts-i { flex: none; width: 2.1rem; height: 2.1rem; border-radius: 9px; display: grid; place-items: center; background: var(--greenbg); color: var(--green); }
  .nts b { display: block; font-size: .9rem; line-height: 1.2; }
  .nts small { display: block; font-size: .76rem; color: var(--ink2); line-height: 1.3; }
  @media (prefers-reduced-motion: reduce) { .nts a { transition: none; } }
</style>
